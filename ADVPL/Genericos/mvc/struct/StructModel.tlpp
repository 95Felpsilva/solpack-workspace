/*/{Protheus.doc} StructModel::setValid
Atribui a validação de usuário do campo
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param cValid, character, Validação de usuário do campo
/*/
method setValid(cValid) class StructModel
	local bValid := nil
	default cValid := ".t."

	bValid := FWBuildFeature( STRUCT_FEATURE_VALID	, cValid	)

	::bValid := bValid
	::cValid := cValid
return
