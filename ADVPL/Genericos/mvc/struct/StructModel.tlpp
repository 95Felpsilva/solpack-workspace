#include 'totvs.ch'
#Include 'FWMVCDEF.CH'
/*/{Protheus.doc} StructModel
Classe com as definições para criação de um novo campo no MVC
@type class
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
/*/
class StructModel
	data cTitle
	data cTooltip
	data cIdField
	data cType
	data nSize
	data nDecimal
	data bValid
	data bWhen
	data aValues
	data lObrigat
	data bInit
	data lKey
	data lNoUpd
	data lVirtual
	data cValid

	public method new() CONSTRUCTOR
    public method addField()
	public method getTitle()
	public method getTooltip()
	public method getIdField()
	public method getType()
	public method getSize()
	public method getDecimal()
	public method getValid()
	public method getWhen()
	public method getValues()
	public method isObrigat()
	public method getInit()
	public method isKey()
	public method isNoUpd()
	public method isVirtual()

	public method setTitle()
	public method setTooltip()
	public method setIdField()
	public method setType()
	public method setSize()
	public method setDecimal()
	public method setValid()
	public method setWhen()
	public method setValues()
	public method setObrigat()
	public method setInit()
	public method setKey()
	public method setNoUpd()
	public method setVirtual()
endclass
/*/{Protheus.doc} StructModel::new
Método construtor da classse
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
/*/
method new() class StructModel
	::setTitle()
	::setTooltip()
	::setIdField()
	::setType()
	::setSize()
	::setDecimal()
	::setValid()
	::setWhen()
	::setValues()
	::setObrigat()
	::setInit()
	::setKey()
	::setNoUpd()
	::setVirtual()
return
/*/{Protheus.doc} StructModel::addField
Adiciona os campos no model recebido por parametro
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param oStruct, object, Objeto FWFORMMODELSTRUCT que terá os campos adicionados
/*/
method addField(oStruct) class StructModel
    oStruct:AddField(::getTitle(), ::getTooltip(), ::getIdField(), ::getType(), ::getSize(), ::getDecimal(), ::getValid(), ::getWhen(), ::getValues(), ::isObrigat(), ::getInit(), ::isKey(), ::isNoUpd(), ::isVirtual(), ::cValid)
return
