/*/{Protheus.doc} StructModel::setInit
String com o inicializador padrão do campo
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param cInit, character, String com o inicializador padrão do campo
/*/
method setInit(cInit) class StructModel
	default cIini := ""

	if !empty(cInit)
		::bInit := FWBuildFeature( STRUCT_FEATURE_INIPAD  	, cInit	)
	else
		::bInit := nil
	endif
return
