/*/{Protheus.doc} StructView
Classe com as definições para criação de um novo campo no MVC
@type class
@version 12.1.27  
@author Tiago Faria
@since 30/07/2021
/*/
class StructView
	data cIdField
	data cOrder
	data cTitle
	data cDescric
	data aHelp
	data cType
	data cPicture
	data bPictVar
	data cLookUp
	data lCanChange
	data cFolder
	data cGroup
	data aComboValues
	data nMaxLenCombo
	data cIniBrow
	data lVirtual
	data cPictVar
	data lInsertLine
	data nWidth

	public method new() CONSTRUCTOR
	public method addField()
	public method getComboValues()
	public method getHelp()
	public method getPictVar()
	public method getDescric()
	public method getFolder()
	public method getGroup()
	public method getIdField()
	public method getIniBrow()
	public method getLookUp()
	public method getOrder()
	public method getPicture()
	public method getTitle()
	public method getType()
	public method getMaxLenCombo()
	public method getWidth()
	public method isCanChange()
	public method isInsertLine()
	public method isVirtual()

	private method setPictVar()

	public method setComboValues()
	public method setHelp()
	public method setDescric()
	public method setFolder()
	public method setGroup()
	public method setIdField()
	public method setIniBrow()
	public method setLookUp()
	public method setOrder()
	public method setPicture()
	public method setTitle()
	public method setType()
	public method setMaxLenCombo()
	public method setWidth()
	public method setCanChange()
	public method setInsertLine()
	public method setVirtual()
endclass
/*/{Protheus.doc} StructView::new
Método consturtor da classe
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
/*/
method new() class StructView
	::setComboValues()
	::setHelp()
	::setDescric()
	::setFolder()
	::setGroup()
	::setIdField()
	::setIniBrow()
	::setLookUp()
	::setOrder()
	::setPicture()
	::setTitle()
	::setType()
	::setMaxLenCombo()
	::setWidth()
	::setCanChange()
	::setInsertLine()
	::setVirtual()
return
/*/{Protheus.doc} StructModel::addField
Adiciona os campos no model recebido por parametro
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param oStruct, object, Objeto FWFORMVIEWSTRUCT que terá o campo adicionado
/*/
method addField(oStruct) class StructView
	oStruct:AddField(::getIdField(), ::getOrder(), ::getTitle(), ::getDescric(), ::getHelp(), ::getType(), ::getPicture(), ::getPictVar(),::getLookUp(), ::isCanChange(), ::getFolder(), ::getGroup(), ::getComboValues(), ::getMaxLenCombo(), ::getIniBrow(), ::isVirtual(), ::getPictVar(), ::isInsertLine(), ::getWidth())
return
