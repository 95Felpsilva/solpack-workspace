/*/{Protheus.doc} GridDefView::markAll
Realiza a marcação de todos as linhas do grid com base no campo definido em GridDefView:SetMarkField()
@type method
@version 12.1.27
@author Tiago Faria
@since 07/07/2021
@param oView, object, Objeto da view
/*/
method markAll(oView,lInvert) class GridDefView
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(::cIDGridModel)
	local nLine    := 0
	local aLineBkp := FWSaveRows(oModel)
	local lMark    := .t.
	local nQtdBeforeMark := 0
	default lInvert := .f.
	if !lInvert
		lUltMark := !lUltMark
		lMark 	 := lUltMark
	endif

	BEGIN SEQUENCE
		if !lInvert .and. !eval(::getBeforeMark(),lMark,lInvert)
			BREAK
		endif

		for nLine := 1 to oGrid:length()
			oGrid:goLine(nLine)

			if !oGrid:isdeleted()
				if lInvert
					lMark := !oGrid:getValue(::getMarkField())
					if lMark .and. nQtdBeforeMark == 0 .and. !eval(::getBeforeMark(),lMark,lInvert)
						BREAK
					endif
					if lMark
						nQtdBeforeMark++
					endif
				endif
				oGrid:setValue(::getMarkField(),lMark)
			endif
		next nLine
		FwRestRows(aLineBkp)
	END SEQUENCE
return
