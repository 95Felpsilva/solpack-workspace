/*
Monta estrutura da View de tabela falsa para servir de cabeçalho da tela MVC
Autor: Tiago Faria
Data: 07/07/2021
*/
static function getTableFakeView()
	local oViewStruct := FWFormViewStruct():New()
	oViewStruct:addField("FAKE_01", "01" , "Field Fake 01", "Campo de texto", , "C" )
return oViewStruct

/*
Retorna a picture do campo de acordo com o tipo, tamanho e decimal
Autor: Tiago Faria
Data: 07/07/2021
*/
static function getPicture(cTipo,nTamanho,nDecimal)
	local cPicture := ""
	if cTipo == "C"
		cPicture := "@!"
	elseif cTipo == "L"
		cPicture := ""
	elseif cTipo == "M"
		cPicture := ""
	elseif cTipo == "N"
		cPicture := AVCALCPICT(nTamanho,nDecimal)
	endif
return cPicture
