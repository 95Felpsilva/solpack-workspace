#include 'totvs.ch'
#include 'FwMVCDef.ch'

static lUltMark := .f.
/*/{Protheus.doc} GridDefView
Classe com as definições da view para o GRID
@type class
@version 12.1.27 
@author Tiago Faria
@since 29/07/2021
/*/
class GridDefView from GridDefCommon
    private data cProgram
	private data cIDGridView  as character
	private data lOnlyView    as logical
	private data bViewDef as codeblock
    private data bBeforeMark as codeblock
    private data aTitleField as array
    private data cMarkField	  as character
    private data cIDGridModel as character
	private data aStruct	  as array
	private data nPercentGrid as numeric
	private data nPercentForm as numeric 
	private data lShowMarkALl as logical
	
	public method new() CONSTRUCTOR
	public method getIDGridView()
	public method setViewDef()
	public method getViewDef()
	public method viewDef()
	public method setOnlyView()
	public method markAll()
	public method getBeforeMark()
	public method setBeforeMark()
    public method getTitleField()
    public method setTitleField()
	public method setFieldStruct()
	public method addFieldStruct()
	public method setPercentGrid()
	public method getPercentGrid()
	public method setPercentForm()
	public method getPercentForm()
	public method setShowMarkAll()
	private method getStructGridView()
    private method isLoadField()
endclass
/*/{Protheus.doc} GridDefView::new
Método construtor da classe
@type method
@version 12.1.27
@author Tiago Faria
@since 29/07/2021
@param cIDGridView, character, ID do grid que será utilizado na VIEW
@param cProgram, character, ID do programa
@param cIDGridModel, character, ID do grid que será utilziado no MODEL
/*/
method new(cIDGridView,cProgram, cIDGridModel) class GridDefView
    _Super:new()
	::cIDGridView  := cIDGridView
	::bViewDef	   := {|oView| oView}
    ::cProgram     := cProgram
    ::aTitleField  := {}
    ::cMarkField   := ""
    ::cIDGridModel := cIDGridModel
	::setBeforeMark()
	::setFieldStruct()
	::setPercentGrid()
	::setPercentForm()
	::setShowMarkAll()
return
/*/{Protheus.doc} GridDefView::viewDef
Retorna as definições da view
@type method
@version 12.1.27
@author Tiago Faria
@since 07/07/2021
@return object, Retorna objeto com as definições da view
/*/
method viewDef() class GridDefView
	local oView 	:= nil
	local oModel 	:= nil
	local oStrCab 	:= nil
	local oStrGrid 	:= nil

	// Estrutura Fake de Field
	oStrCab := getTableFakeView()

	//Estrutura de Grid
	oStrGrid := ::getStructGridView()

	oModel := FWLoadModel(::cProgram)

	oView := FwFormView():New()

	oView:setModel(oModel)
	oView:addField("CABEC_FAKE_VIEW", oStrCab, "CABEC_FAKE_MODEL")
	oView:addGrid(::getIdGridView(), oStrGrid, ::cIDGridModel)
	if ::lOnlyView
		oVIew:SetOnlyView(::getIdGridView())
	endif
	oView:createHorizontalBox("TOHIDE", 0 )
	oView:createHorizontalBox("TOSHOW", ::getPercentGrid())
	oView:setOwnerView("CABEC_FAKE_VIEW", "TOHIDE" )
	oView:setOwnerView(::getIdGridView(), "TOSHOW")
	oView := eval(::getViewDef(),oView)
	if !empty(::getMarkField())
		oView:GetViewStruct(::getIdGridView()):setProperty(::getMarkField(),MVC_VIEW_CANCHANGE,.t.)
		oView:GetViewStruct(::getIdGridView()):setProperty(::getMarkField(),MVC_VIEW_ORDEM,"00")
		if ::lShowMarkALl
			oView:addUserButton("Marca/Desmarca Todos", "MAGIC_BMP"/*<cResource >*/, {|oView| fwMsgRun(, {|| ::markAll(oView)}, "MARCA TODOS","Aguarde " + if(!lUltMark," selecionando"," desmarcando") + " registros...")}/*<bBloco >*/, "Marca todos os registros"/*[ cToolTip ]*/, VK_F5/*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
			oView:addUserButton("Inverte Marca", "MAGIC_BMP"/*<cResource >*/, {|oView| fwMsgRun(, {|| ::markAll(oView,.t.)}, "MARCA TODOS","Aguarde invertendo a marca dos registros...")}/*<bBloco >*/, "Marca todos os registros"/*[ cToolTip ]*/, VK_F5/*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		endif
	endif
return oView
/*/{Protheus.doc} GridDefView::setViewDef
Seta bloco de código responável por receber o objeto da View, realizar manipulações e devolver o objeto modificado
@type method
@version 12.1.27
