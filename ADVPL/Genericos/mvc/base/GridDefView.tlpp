@param bViewDef, codeblock, bloco de código responável por receber o objeto da View, realizar manipulações e devolver o objeto modificado
/*/
method setViewDef(bViewDef) class GridDefView
	::bViewDef := bViewDef
return
/*/{Protheus.doc} GridDefView::getViewDef
Retorna bloco de código responável por receber o objeto da View, realizar manipulações e devolver o objeto modificado
@type method
@version 12.1.27
@author Tiago Faria
@since 29/07/2021
/*/
method getViewDef() class GridDefView
return ::bViewDef
/*/{Protheus.doc} GridDefView::getStructGridView
Retorna a estrutura do grid para a View
@type method
@version 12.1.27
@author Tiago Faria
@since 07/07/2021
@return object, Retorna estrutura da view com a class FwFormViewStruct
/*/
method getStructGridView() class GridDefView
	local oViewStruct := FWFormViewStruct():New()
	local nField 	   := 0
	local cTitle 	   := ""
	local cToolTip	   := ""
	local cIDField	   := ""
	local cTipo		   := ""
	local cOrdem	   := "00"
	local cPicture	   := ""
    local aFieldsTable := ::getFieldsTable()

	for nField := 1 to len(::aStruct)
		::aStruct[nField]:addField(oViewStruct)
	next nField

	for nField := 1 to len(aFieldsTable)
		cOrdem := soma1(cOrdem)

		cIDField	:= aFieldsTable[nField,1]

		if !_Super:isLoadField(cIDField)
			loop
		endif

		cTipo		:= aFieldsTable[nField,2]
		cTitle 		:= ::getTitleField(cIDField)

		if empty(cTitle)
			cTitle 		:= getSX3Cache(cIDField,"X3_TITULO")
			cToolTip	:= getSX3Cache(cIDField,"X3_DESCRIC")
			cPicture	:= getSX3Cache(cIDField,"X3_PICTURE")
		endif

		if empty(cTitle)
			cTitle := Capital(StrTran(cIDField,"_"," "))
		endif

		if empty(cToolTip)
			cToolTip := cTitle
		endif

		if empty(cPicture)
			cPicture := getPicture(cTipo,aFieldsTable[nField,3],aFieldsTable[nField,4])
		endif

		oViewStruct:addField(cIDField, cOrdem,cTitle, cToolTip, /*aHelp*/, cTipo,cPicture,/*bPictVar*/ )
	next nField

return oViewStruct
