/*/{Protheus.doc} GridDefView::setTitleField
Atribui titulo a um campo do Grid
@type method
@version 12.1.27
@author Tiago Faria
@since 25/07/2021
@param cIDField, character, ID do campo
@param cTitle, character, Titulo do Campo
/*/
method setTitleField(cIDField,cTitle) class GridDefView
	aAdd(::aTitleField,{cIDField,cTitle})
return
/*/{Protheus.doc} GridDefView::getTitleField
Recupera o titulo do campo atribuido pelo metodo SetTitleField
@type method
@version 12.1.27
@author Tiago Faria
@since 25/07/2021
@param cIdField, character, Id do campo
@return character, Titulo do campo
/*/
method getTitleField(cIdField) class GridDefView
	local nPos   := aScan(::aTitleField,{|aTitle| upper(alltrim(aTitle[1])) == upper(alltrim(cIDField))})
	local cTitle := ""
	if nPos > 0
		cTitle := ::aTitleField[nPos,2]
	endif
return cTitle
/*/{Protheus.doc} GridDefView::addFieldStruct
Adiciona um campo ao MVC através do objeto STRUCTMODEL
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param oStruct, object, Recebe objeto da classe StructModel com as definições do campo
/*/
method addFieldStruct(oStruct) class GridDefView
	local nPos := aScan(::aStruct,{|X|X:getIdField() == oStruct:getIdField()})

	if nPos > 0
		::aStruct[nPos] := oStruct
	else
		aAdd(::aStruct,oStruct)
	endif
return
/*/{Protheus.doc} GridDefView::setFieldStruct
