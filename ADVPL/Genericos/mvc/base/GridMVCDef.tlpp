/*
Retorna o objeto com as definições do MVC
Autor: Tiago Faria
Data: 07/07/2021
*/
static function getDefMVC(cID)
	local nPos := getPosDefMVC(cID,.f./*lAdd*/)
	local oRet := nil

	if nPos > 0
		oRet := aGridDef[nPos,POS_DEF]
	endif
return oRet
/*
Retorna posição do array que está armazenado as definições do MVC
Autor: Tiago Faria
Data: 29/07/2021
*/
static function getPosDefMVC(cID,lAdd)
	local nPos   := aScan(aGridDef,{|X|X[POS_ID] == cID})
	default lAdd := .t.

	if nPos == 0 .and. lAdd
		aAdd(aGridDef,array(LEN_ARRAY))
		nPos := len(aGridDef)
	endif
return nPos

