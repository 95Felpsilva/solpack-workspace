#include 'totvs.ch'
#include "fwmvcdef.ch"

static POS_ID    := 1
static POS_DEF   := 2
static LEN_ARRAY := 2

static aGridDef := {}
/*/{Protheus.doc} GridMVCDef
Classe com as definições do MVC
@type class
@version 12.1.27
@author Tiago Faria
@since 25/07/2021
/*/
class GridMVCDef
	data cProgram     as character
	data oModelDef    as object
	data oViewDef     as object
	private data nPercentGrid as numeric
	private data nPercentForm as numeric 

	public method new() constructor
	public method getProgram()
	public method modelDef()
	public method viewDef()
	public method setViewDef()
	public method setModelDef()
	public method setTitle()
	public method setOnlyView()
	public method setShowMarkAll()
	private method saveDef()
	static method getDef()
	static method destroyDef()

	public method activate()
	public method setTitleField()
	public method setFieldsTable()
	public method addFieldTable()
	public method setMarkField()
	public method getMarkField()
	public method getTypeField()
	public method addTypeField()
	public method getIDGridModel()
	public method getIDGridView()
	public method getBeforeMark()
	public method setBeforeMark()
	public method addFWModelEvent()
	public method setPercentGrid()
	public method getPercentGrid()
	public method setPercentForm()
	public method getPercentForm()
	public method getModelDef()
	public method getViewDef()
return

endclass
/*/{Protheus.doc} GridMVCDef::new
Método construtor da classe
@type method
@version 12.1.27
@author Tiago Faria
@since 29/06/2021
/*/
method new(cIDModel,cProgram,cIDGridModel,cIDGridView,bLoadGrid) class GridMVCDef
	default cIDModel     := "ZZMVC" + retCodUsr()
	default cProgram     := ""
	default cIDGridModel := ""
	default cIDGridView  := ""

	::cProgram     := cProgram

	::oModelDef    := GridDefModel():new(cIDModel,cIDGridModel)
	::oModelDef:setLoadGrid(bLoadGrid)
	::oViewDef     := GridDefView():new(cIDGridView,::cProgram,cIDGridModel)

	::setTitle("Grid")
return
/*/{Protheus.doc} GridMVCDef::saveDef
Salva as definições em memória para posterior utilização durante o carregamento da tela MVC
@type method
@version 12.1.27
@author Tiago Faria
@since 29/06/2021
@param oObj, object, Objeto com as definições do MVC
/*/
method saveDef(oObj) class GridMVCDef
	local nPos := getPosDefMVC(::getProgram())
	default oObj := nil

	aGridDef[nPos][POS_ID] := ::getProgram()
	aGridDef[nPos][POS_DEF] := oObj
return
/*/{Protheus.doc} GridMVCDef::destroyDef
Destroi as definições salvas em memória
@type method
@version 12.1.27
@author Tiago Faria
@since 29/06/2021
/*/
method destroyDef() class GridMVCDef
	aGridDef := {}
return
