/*/{Protheus.doc} GridMVCDef::addFieldTable
Adiciona 1 campo na tela que será apresentada no MVC
@type method
@version 12.1.27
@author Tiago Faria
@since 29/07/2021
@param cID, character, Id do campo
@param cType, character, Tipo do campo
@param nSize, numeric, Tamanho do campo
@param nDecimal, numeric, Quantidade de decimais do campo
/*/
method addFieldTable(cID,cType,nSize,nDecimal) class GridMVCDef
	local aFieldsModel := ::oModelDef:getFieldsTable()
	local aFieldsView := ::oViewDef:getFieldsTable()
	
	aAdd(aFieldsModel,{cID,cType,nSize,nDecimal})
	aAdd(aFieldsView,{cID,cType,nSize,nDecimal})
	
	::oModelDef:setFieldsTable(aFieldsModel)
	::oViewDef:setFieldsTable(aFieldsView)
return
