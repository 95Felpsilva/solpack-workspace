/*/{Protheus.doc} GridDefModel::addFieldStruct
Adiciona um campo ao MVC através do objeto STRUCTMODEL
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param oStruct, object, Recebe objeto da classe StructModel com as definições do campo
/*/
method addFieldStruct(oStruct) class GridDefModel
	local nPos := aScan(::aStruct,{|X|X:getIdField() == oStruct:getIdField()})

	if nPos > 0
		::aStruct[nPos] := oStruct
	else
		aAdd(::aStruct,oStruct)
	endif
return
/*/{Protheus.doc} GridDefModel::setFieldStruct
Recebe array de objetos StructModel com todos os campos que fazem parte do model 
@type method
@version 12.1.27
@author Tiago Faria
@since 30/07/2021
@param aStruct, array, Array de objetos StructModel
/*/
method setFieldStruct(aStruct) class GridDefModel
	default aStruct := {}
	::aStruct := aStruct
return
/*
Monta estrutura do Model de tabela falsa para servir de cabeçalho da tela MVC
Autor: Tiago Faria
Data: 07/07/2021
*/
static function getTableFakeModel()
	local oModelStruct := FWFormModelStruct():New()

	oModelStruct:addTable(""/*oJson */, {"FAKE_01"}/*aPK */, "."/*cDescription */, {|| ""}/*bRealName*/)
	oModelStruct:addField("Field Fake 01", "Field Fake 01", "FAKE_01", "C", 15)
return oModelStruct
/*
Atualiza o valor do campo FAKE_01 ao incluir para não dar erro no MVC informando que nehum campo do cabeçalho foi preenchido
Autor: Tiago Faria
Data: 07/07/2021
*/
static function onActivate(oModel)
	if oModel:GetOperation() == MODEL_OPERATION_INSERT .or. oModel:GetOperation() == MODEL_OPERATION_UPDATE
		FwFldPut("FAKE_01", "FAKE" , /*nLinha*/, oModel)
	endif
return
