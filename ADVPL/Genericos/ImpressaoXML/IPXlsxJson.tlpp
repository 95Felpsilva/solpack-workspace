#include 'totvs.ch'
#include 'topconn.ch'
/*/{Protheus.doc} IPXlsxJson
Classe para gerar arquivo excel a partir de um array de JSON
@type class
@version 12.1.2410
@author Tiago Faria
@since 07/10/2025
/*/
class IPXlsxJson from IPXlsx
	public method new()
	public method export()
end class

method new(cFile) class IPXlsxJson
	_Super:new(cFile)
return self
/*/{Protheus.doc} IPXlsxJson::export
Exporta os dados do array recebido por parametro para linhas do arquivo XLSX
@type method
@version 12.1.2410
@author Tiago Faria
@since 07/10/2025
@param aDados, character, ID do alias
@param cSheetName, character, Nome da aba do excel que deve sair as linhas da query
@param lImpHeader, logical, Indica se deve imprimir na 1ª linha o cabeçalho do arquivo, é tomado como base o nome fisíco das colunas do alias recebido por parametro
/*/
method export(aDados,cSheetName,lImpHeader,oIPXlsxConvert,oIPXlsxFormat) class IPXlsxJson
	local jDados        	:= nil
	local aFields       	:= {}
	local nField        	:= 0
	local nDados 			:= 0
	local aLineHeader   	:= {}
	local aLineHeaderName	:= {}
	local aLine				:= {}

	default lImpHeader  	:= .t.
	default oIPXlsxConvert 	:= IPXlsxConvert():Default()
	default oIPXlsxFormat  	:= IPXlsxFormat():Default()

	if len(aDados) == 0
		return
	endif

	jDados := aDados[1]

	aFields := jDados:getNames()

	if lImpHeader
		
		for nField := 1 to len(aFields)
			cField := aFields[nField]
			cTitle := getSX3Cache(cField,"X3_TITULO")
			if !empty(cTitle)
				aAdd(aLineHeader,upper(alltrim(cTitle)))
			else
				aAdd(aLineHeader,cField)
			endif

			aAdd(aLineHeaderName,cField)
		next nField

		_Super:SetFont(FwPrinterFont():Calibri(), 11/*nSize*/, .f./*lItalic*/, .t./*lBold*/, .f./*lUnderlined*/)
		_Super:addLine(cSheetName,aLineHeader,/*lCalculateCellWidth*/,/*oIPXlsxFormat*/,aLineHeaderName)
		_Super:ResetFont()

	else
		/*adiciona uma linha em branco para a impressão ignorar a linha 1 do header
		pois quando o lImpHeader é false indica que o usuário irá fazer o cabeçalho manualmente
		*/
		_Super:addLine(cSheetName,aLine)
	endif

	for nDados := 1 to len(aDados)
		jDados := aDados[nDados]

		aLine := {}

		for nField := 1 to len(aFields)
			xValue := jDados[aFields[nField]]

			if (valType(xValue) == "C")
				xValue := alltrim(xValue)
			endif

			xValue := oIPXlsxConvert:convert(xValue,aFields[nField],jDados,cSheetName)

			aAdd(aLine,xValue)
		next nField

		_Super:addLine(cSheetName,aLine,/*lCalculateCellWidth*/,oIPXlsxFormat,aLineHeaderName)
	next nDados
return

