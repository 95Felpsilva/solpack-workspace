#include 'totvs.ch'
#include 'topconn.ch'

user function BolAntecip();return

/*/{Protheus.doc} BolAntecip
Classe com as funcionalidades para geração de boleto antecipado
@type class
@version 12.1.33
@author Tiago Faria
@since 03/11/2021
/*/
	class BolAntecip
		public data cPrefixo         as character
		public data cTipo            as character
		public data cCaminhoBoleto   as character
		public data bArquivoBoleto   as codeblock
		public data cFormaPagamento  as character
		public data cMotBX           as character
		public data cMotBXMan        as character
		public data cBanco           as character
		public data cAgencia         as character
		public data cConta           as character
		public data cSubConta        as character
		public data cNaturezaRA      as character
		public data nDiasCompensacao as numeric
		public data lLiberaAdmin     as logical
		public data nDias1Parcela    as numeric
		public data nDias2Parcela    as numeric
		public data aBoletos         as array

		public method new() CONSTRUCTOR
		public method geraTitulo()
		public method geraBoleto()
		public method enviaEmail()
		public method bxTitCNAB()
		public method geraRA()
		public method vinculaRAxPV()
		public method atualizaStatus()
		public method getTotalPV()
		public method getFormaPagamento()
		public method getMotBx()
		public method getMotBxMan()

		static method gerar()
		static method isPVBoletoAntecipado()
		static method isCondPgtoBolAntecipado()
		static method isFormaPgtoBolAntecipado()
		static method isLibAdmin()
		static method somaDiasUteis()
		static method isRAAbertoCliente()
		static method getBaseDup()
		static method reImprimir()
		static method vldE1Prefixo()
	endclass
/*/{Protheus.doc} BolAntecip::new
Método construtor da classe
@type method
@version 12.1.33
@author Tiago Faria
@since 03/11/2021
/*/
method new() class BolAntecip
	::cPrefixo        := PadR(getNewPar("ZZ_BAPREF","PV"),getSX3Cache("E1_PREFIXO","X3_TAMANHO")," ")
	::cTipo           := PadR(getNewPar("ZZ_BATIPO","BOL"),getSX3Cache("E1_TIPO","X3_TAMANHO")," ")
	::cCaminhoBoleto  := getNewPar("ZZ_BACBOL","\bolantecip\")
	::bArquivoBoleto  :={||"boleto-"+SE1->(E1_NUM+"-"+E1_PARCELA)+".pdf"}
	::cFormaPagamento := getNewPar("ZZ_BAFPGT","PGA/")
	::cMotBX          := getNewPar("ZZ_BAMOTBX","BOL")
	::cMotBXMan       := getNewPar("ZZ_BAMTBXM","TRF")
	::cBanco          := padR(getNewPar("ZZ_BABANCO","001"),getSX3Cache("E1_PORTADO","X3_TAMANHO")," ")
	::cAgencia        := padR(getNewPar("ZZ_BAAGENC","0974"),getSX3Cache("E1_AGEDEP","X3_TAMANHO")," ")
	::cConta          := padR(getNewPar("ZZ_BACONTA","6461"),getSX3Cache("E1_CONTA","X3_TAMANHO")," ")
	::cSubConta       := padR(getNewPar("ZZ_BASUBCO","002"),getSX3Cache("E1_ZZSUBCO","X3_TAMANHO")," ")
	::nDias1Parcela   := getNewPar("ZZ_BADU1P",2)
	::nDias2Parcela   := getNewPar("ZZ_BADU2P",7)
	::aBoletos		  := {}
	::lLiberaAdmin	  := getNewPar("ZZ_BALIBAD",.F.)
	::cNaturezaRA     := getNewPar("ZZ_BANATRA","10401")
return
/*/{Protheus.doc} BolAntecip::gerar
Geração de boleto automático
@type method
@version 12.1.33
@author Tiago Faria
@since 03/11/2021
@return logical, Se true boleto gerado com sucesso
/*/
method gerar() class BolAntecip
	local oBolAnt       := BolAntecip()   :New()
	local oBolDel       := BolAntecipDel():New()
	local lRet          := .t.
	local cProblema     := ""
	local cSolucao      := ""
	local aTitulos      := {}
	local nTitulo       := 0
	local cParcela      := PadL("0",getSX3Cache("E1_PARCELA","X3_TAMANHO"),"0")
	local nAdiantamento := getThreadValue("TOTAL_RA_PV")
	local nSldAdt		:= 0
	local nField        := 0
	local cCampoVencimento := ""
	local cCampoParcela := ""
	local lDisarmTransaction := .t.
	if valType(nAdiantamento) <> "N"
		nAdiantamento := 0
	endif

	setThreadValue("TOTAL_RA_PV",0)

	BEGIN TRANSACTION
		BEGIN SEQUENCE

			if oBolDel:isBoletoGerado()
				lDisarmTransaction := .f.
				break
			elseif oBolAnt:isPVBoletoAntecipado(SC5->C5_FORPGT/*cFormaPagamento*/,SC5->C5_CONDPAG/*cCondPagamento*/,.F./*lHelp*/)
				if!msgYesNo("Deseja realizar a geração e envio do boleto para o pedido? <b>Após gerado o boleto o Pedido de Vendas não poderá sofrer alterações!</b>")
					lDisarmTransaction := .f.
					break
				endif
			else
				lDisarmTransaction := .f.
				break
			endif

			while .t.
				nField++
				cCampoVencimento := "C5_ZZVEN" + cValToChar(nField)
				cCampoParcela    := "C5_ZZPAR" + cValToChar(nField)

				if SC5->(fieldPos(cCampoVencimento)) > 0
					nParcela := &("SC5->"+cCampoParcela)
					dVencimento := &("SC5->"+cCampoVencimento)
					if nParcela > 0
						aAdd(aTitulos,{nParcela,dVencimento})
					endif
				else
					exit
				endif
			enddo

			if len(aTitulos) == 0
				aAdd(aTitulos,{SC5->C5_ZZBASED,BolAntecip():somaDiasUteis(date(),oBolAnt:nDias1Parcela)})
			endif

			for nTitulo := 1 to len(aTitulos)
				nValor  := aTitulos[nTitulo,1]
				dDtVenc := aTitulos[nTitulo,2]

				if nAdiantamento > nValor
					nAdiantamento -= nValor
					loop
				else
					nSldAdt := nAdiantamento
					nAdiantamento -= nValor
					nValor := nValor - nSldAdt
				endif

				if nValor <= 0
					loop
				endif

				if nAdiantamento < 0
					nAdiantamento := 0
				endif

				cParcela := soma1(cParcela)
				if !oBolAnt:geraTitulo(nValor,dDtVenc,cParcela)
					cProblema := "Erro ao gerar título para pagamento antecipado"
					lDisarmTransaction := .f.
					break
				endif

				if !oBolAnt:geraBoleto()
					cProblema := "Erro ao gerar o boleto"
					break
				endif
			next nTitulo

			if len(oBolAnt:aBoletos) > 0 .and. !oBolAnt:enviaEmail(oBolAnt:aBoletos)
				cProblema := "Erro ao enviar e-mail do boleto para o cliente"
				lDisarmTransaction := .f.
				break
			endif

			RECOVER
			lRet := .f.
			if lDisarmTransaction
				disarmTransaction()
			endif
			if !empty(cProblema)
				u_myHelp(cProblema,cSolucao)
			endif

		END SEQUENCE
	END TRANSACTION
	oBolAnt:atualizaStatus(SC5->C5_NUM)

return lRet
/*/{Protheus.doc} BolAntecip::geraTitulo
Realiza a inclusão do título
@type method
@version 12.1.33
@author Tiago Faria
@since 04/11/2021
@param nValor, numeric, Valor do Titulo
@param dVencto, date, Data de Vencimento
@return logical, Se true o titulo foi incluido com sucesso se false houve erro na inclusão
/*/
method geraTitulo(nValor,dVencto,cParcela) class BolAntecip
	local aCab          := {}
	local cNumTit       := padL(SC5->C5_NUM,getSX3Cache("E1_NUM","X3_TAMANHO"),"0")
	private lMsErroAuto := .f.
	default nValor      := 0
	default dVencto     := dDataBase
	default cParcela    := "01"

	cParcela := PadL(cParcela,getSX3Cache("E1_PARCELA","X3_TAMANHO"),"0")

	aadd(aCab, {"E1_NUM"    , cNumTit        , Nil})
	aadd(aCab, {"E1_PREFIXO", ::cPrefixo     , Nil})
	aadd(aCab, {"E1_TIPO"   , ::cTipo        , Nil})
	aadd(aCab, {"E1_PARCELA", cParcela       , Nil})
	aadd(aCab, {"E1_FORPGT" , SC5->C5_FORPGT , Nil})
	aadd(aCab, {"E1_NATUREZ", SC5->C5_NATUREZ, Nil})
	aadd(aCab, {"E1_CLIENTE", SC5->C5_CLIENTE, Nil})
	aadd(aCab, {"E1_LOJA"   , SC5->C5_LOJACLI, Nil})
	aadd(aCab, {"E1_EMISSAO", dDataBase      , Nil})
	aadd(aCab, {"E1_VENCTO" , dVencto        , Nil})
	aadd(aCab, {"E1_VALOR"  , nValor         , Nil})
	//aadd(aCab, {"E1_HIST"   , HISTORICO, Nil})

	cChave := xFilial("SE1")
	cChave += ::cPrefixo
	cChave += cNumTit
	cChave += cParcela
	cChave += ::cTipo

	if Posicione("SE1",1,cChave,"Eof()")
		aCab := FwVetByDic(aCab,"SE1")
		MSExecAuto({|x,y| FINA040(x,y)}, aCab, 3)

		if lMsErroAuto
			mostraErro()
		endif
	endif
return !lMsErroAuto
/*/{Protheus.doc} BolAntecip::geraBoleto
Realiza a geração do Boleto Flex
@type method
@version 12.1.33
@author Tiago Faria
@since 04/11/2021
/*/
method geraBoleto() class BolAntecip
	local aCabec        := {}
	local cArquivoBoleto:= eval(::bArquivoBoleto)
	private lMsErroAuto := .f.

	aADD(aCabec, {"E1_PREFIXO"	, SE1->E1_PREFIXO	})
	aADD(aCabec, {"E1_NUM"		, SE1->E1_NUM		})
	aADD(aCabec, {"E1_PARCELA"	, SE1->E1_PARCELA	})
	aADD(aCabec, {"E1_TIPO"		, SE1->E1_TIPO		})
	if !empty(SE1->E1_PORTADO)
		aADD(aCabec, {"EE_CODIGO"	, SE1->E1_PORTADO	})
		aADD(aCabec, {"EE_AGENCIA"	, SE1->E1_AGEDEP	})
		aADD(aCabec, {"EE_CONTA"	, SE1->E1_CONTA	    })
		aADD(aCabec, {"EE_SUBCTA"	, SE1->E1_ZZSUBCO	})
	else
		aadd(aCabec, {"EE_CODIGO" , ::cBanco})
		aadd(aCabec, {"EE_AGENCIA", ::cAgencia})
		aadd(aCabec, {"EE_CONTA"  , ::cConta})
		aadd(aCabec, {"EE_SUBCTA" , ::cSubConta})
	endif
	makeDir(::cCaminhoBoleto)
	U_AutoBolFlex(aCabec, ::cCaminhoBoleto + cArquivoBoleto)

	if !lMsErroAuto
		lMsErroAuto := !file(::cCaminhoBoleto + cArquivoBoleto)
	endIf

	if !lMsErroAuto
		aAdd(::aBoletos,::cCaminhoBoleto + cArquivoBoleto)
		::atualizaStatus(getNumPV(SE1->E1_NUM))
	endif
return !lMsErroAuto
/*/{Protheus.doc} BolAntecip::enviaEmail
Realiza o envio do boleto por e-mail para o cliente
@type method
@version 12.1.33
@author Tiago Faria
@since 04/11/2021
@return logical, se true o boleto foi enviado com sucesso se false não foi
/*/
method enviaEmail(xBoleto) class BolAntecip
	local oBolProtheus := BoletosProtheus():New()
	local cEmail       := oBolProtheus:getEmail(SE1->E1_PREFIXO, SE1->E1_NUM, SE1->E1_PARCELA, SE1->E1_TIPO)
	local cAssunto     := alltrim(FwFilialName()) + " - Boletos Bancários Pedido " + SC5->C5_NUM
	local cCorpoEmail  := ""
	local lRet         := .t.
	default xBoleto    := ::cCaminhoBoleto + eval(::bArquivoBoleto)

	cCorpoEmail += "Prezado Cliente,"
	cCorpoEmail += "<br>"
	cCorpoEmail += "Seguem em anexo boletos bancários."
	cCorpoEmail += "<br>"
	cCorpoEmail += "Qualquer dúvida estamos à disposição."
	cCorpoEmail += "<br><br>"
	cCorpoEmail += "Atenciosamente,"
	cCorpoEmail += "<br>"
	cCorpoEmail += "<b>" + alltrim(FwFilialName()) + "</b>"
	cCorpoEmail += "<br>"
	cCorpoEmail += "Mensagem automática. Favor não responder."

	lRet := u_sendMail(cAssunto,cCorpoEmail,cEmail,xBoleto)

	if valType(xBoleto) == "C"
		xBoleto := {xBoleto}
	endif

	aEval(xBoleto,{|cBoleto| fErase(cBoleto)})
return lRet
/*
Retorna o total do pedido calculado pelas funcoes mafis
*/
method getTotalPV(cNum) class BolAntecip
	local aArea     := Lj7GetArea({"SC5", "SC6"})
	local cAlias    := ''
	local cQuery    := ''
	local oImpostos := ImpostosPV():New()
	local nTotPV    := 0
	default cNum    := SC5->C5_NUM
	cQuery += "SELECT" + CRLF
	cQuery += "	*" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SC5') + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SC6') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SC6') + CRLF
	cQuery += "	AND C6_NUM = C5_NUM" + CRLF
	cQuery += "	AND " + RetSqlDel('SC6') + CRLF

	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SC5') + CRLF
	cQuery += "	AND C5_NUM = '" + cNum + "'" + CRLF
	cQuery += "	AND " + RetSqlDel('SC5') + CRLF
	cQuery += "ORDER BY C6_FILIAL,C6_NUM,C6_ITEM" + CRLF

	TcQuery cQuery new Alias (cAlias := getNextAlias())

	oImpostos:run(cAlias/*cAliasCabec*/,cAlias/*cAliasItem*/)

	nTotPV := oImpostos:getImposto(,"NF_BASEDUP")
	oImpostos:destroy()
	Lj7RestArea(aArea)
return nTotPV
/*/{Protheus.doc} BolAntecip::bxTitCNAB
Baixa o título do CNAB
@type method
@version 12.1.33
@author Tiago Faria
@since 05/11/2021
@return logical, Se true titulo foi baixado com sucesso se false houve erro
/*/
method bxTitCNAB(aValores) class BolAntecip
	local aTit          := {}
	local aArea         := Lj7GetArea({"SE1", "SE5"})
	local cNumTit       := aValores[1]
	local dBaixa        := aValores[2]
	//local cTipo     := aValores[3]
	//local cNsNum    := aValores[4]
	local nDespes       := aValores[5]
	local nDescont      := aValores[6]
	local nAbatim       := aValores[7]
	local nValRec       := aValores[8]
	local nJuros        := aValores[9]
	local nMulta        := aValores[10]
	local nOutrDesp     := aValores[11]
	local nValCc        := aValores[12]
	local dDataCred     := aValores[13]
	//local cOcorr    := aValores[14]
	local cMotBan       := aValores[15]
	local xBuffer       := aValores[16]
	local dDtVc         := aValores[17]
	local lContinuaCNAB := .t.
	local aBKPMV		:= u_saveMV()
	local oBol          := BolAntecipDel():new()
	private lMsErroAuto := .f.
	default aValores    := {}

	Posicione("SEB",1,xFilial("SEB")+MV_PAR06+cOcorr+"R","!Eof()")
	Posicione("SE1",16,xFilial("SE1")+substr(cNumTit,1,10),"!Eof()")

	if SE1->(!Eof()) .and.;
			SEB->(!EOf()) .and.;
			nValRec > 0 .and.;
			SEB->EB_OCORR $ "06|07|08|36|37|38|39" .and.;
			!oBol:canAccess(.f./*lHelp*/)

		lContinuaCNAB := .f.
		aadd(aTit, {"E1_PREFIXO"  , SE1->E1_PREFIXO, Nil}) // 01
		aadd(aTit, {"E1_NUM"      , SE1->E1_NUM    , Nil}) // 02
		aadd(aTit, {"E1_PARCELA"  , SE1->E1_PARCELA, Nil}) // 03
		aadd(aTit, {"E1_TIPO"     , SE1->E1_TIPO   , Nil}) // 04
		aadd(aTit, {"AUTMOTBX"    , ::cMotBX       , Nil}) // 05
		aadd(aTit, {"AUTDTBAIXA"  , dBaixa         , Nil}) // 06
		aadd(aTit, {"AUTDTCREDITO", dDataCred      , Nil}) // 07
		aadd(aTit, {"AUTHIST"     , cTipoBx        , Nil}) // 08
		aadd(aTit, {"AUTVALREC"   , nValRec        , Nil}) // 09
		aadd(aTit, {"AUTJUROS"    , nJuros         , Nil}) // 10
		aadd(aTit, {"AUTDESCONT"  , nDescont       , Nil}) // 11
		aadd(aTit, {"AUTMULTA"    , nMulta         , Nil}) // 12
		//aadd(aTit, {"AUTACRESC"   , nAcresc        , Nil}) // 13
		//aadd(aTit, {"AUTDECRESC"  , nDecresc       , Nil}) // 14
		aadd(aTit, {"AUTBANCO"    , SE1->E1_PORTADO, Nil}) //15
		aadd(aTit, {"AUTAGENCIA"  , SE1->E1_AGEDEP , Nil}) //16
		aadd(aTit, {"AUTCONTA"    , SE1->E1_CONTA  , Nil}) //17

		MSExecAuto({|x,y| FINA070(x,y)},aTit,3)

		If  lMsErroAuto
			MOSTRAERRO()
		else
			lMsErroAuto := !::geraRA(nValRec,dBaixa)
		endif
	endif

	Lj7RestArea(aArea)
	u_restoreMV(aBKPMV)
return {!lMsErroAuto,lContinuaCNAB}
/*/{Protheus.doc} BolAntecip::geraRA
Gera o RA na baixa do título
@type method
@version 12.1.33
@author Tiago Faria
@since 04/11/2021
@return logical, Se true RA foi gerado com sucesso se false houve erro na geração
/*/
method geraRA(nValRec,dBaixa,cCodMotBx) class BolAntecip
	local aCab          := {}
	local cChave        := ""
	local aArea         := Lj7GetArea({"SE1"})
	local dDtBkp		:= dDataBase
	local cParcela      := SE1->E1_PARCELA
	private lMsErroAuto := .f.
	default cCodMotBx := ""
	dDataBase := dBaixa

	cChave := xFilial("SE1")
	cChave += SE1->E1_PREFIXO
	cChave += SE1->E1_NUM
	cChave += cParcela
	cChave += "RA"

	while Posicione("SE1",1,cChave,"!Eof()")
		cParcela := soma1(cParcela)
		cChave := xFilial("SE1")
		cChave += SE1->E1_PREFIXO
		cChave += SE1->E1_NUM
		cChave += cParcela
		cChave += "RA"
	enddo

	Lj7RestArea(aArea)

	aadd(aCab, {"E1_NUM"    , SE1->E1_NUM                            , Nil})
	aadd(aCab, {"E1_PREFIXO", SE1->E1_PREFIXO                        , Nil})
	aadd(aCab, {"E1_FORPGT" , SE1->E1_FORPGT                         , Nil})
	aadd(aCab, {"E1_TIPO"   , "RA"                                   , Nil})
	aadd(aCab, {"E1_PARCELA", SE1->E1_PARCELA                        , Nil})
	aadd(aCab, {"E1_NATUREZ", ::cNaturezaRA                          , Nil})
	aadd(aCab, {"E1_CLIENTE", SE1->E1_CLIENTE                        , Nil})
	aadd(aCab, {"E1_LOJA"   , SE1->E1_LOJA                           , Nil})
	if cCodMotBx == ::getMotBxMan()
		aadd(aCab, {"E1_EMISSAO", dDataBase, Nil})
		aadd(aCab, {"E1_VENCTO" , dDataBase, Nil})
	else
		aadd(aCab, {"E1_EMISSAO", BolAntecip():somaDiasUteis(dDataBase,1), Nil})
		aadd(aCab, {"E1_VENCTO" , BolAntecip():somaDiasUteis(dDataBase,1), Nil})
	endif
	aadd(aCab, {"E1_VALOR"  , nValRec                                , Nil})
	aadd(aCab, {"E1_PORTADO", SE1->E1_PORTADO                        , Nil})
	aadd(aCab, {"E1_AGEDEP" , SE1->E1_AGEDEP                         , Nil})
	aadd(aCab, {"E1_CONTA"  , SE1->E1_CONTA                          , Nil})
	aadd(aCab, {"E1_HIST"   , "BOLETO ANTECIPADO"                    , Nil})

	aCab := FwVetByDic(aCab,"SE1")
	BEGIN TRANSACTION
		MSExecAuto({|x,y| FINA040(x,y)}, aCab, 3)

		if lMsErroAuto
			mostraErro()
		else
			if !::vinculaRAxPV()
				lMsErroAuto := .t.
			else
				::atualizaStatus(getNumPV(SE1->E1_NUM))
			endif
		endif

		if lMsErroAuto
			disarmTransaction()
		endif

	END TRANSACTION

	dDataBase := dDtBkp

	Lj7RestArea(aArea)
return !lMsErroAuto
/*/{Protheus.doc} BolAntecip::vinculaRAxPV
Inclui a tabela FIE para vincular o RA com o Pedido de Vendas
@type method
@version 12.1.33
@author Tiago Faria
@since 04/11/2021
@return logical, Se true o vinculo foi realizado com sucesso se false houve erro
/*/
method vinculaRAxPV() class BolAntecip
	local lRet := .t.
	local aArea := Lj7GetArea({"SE1","SC5"})

	lRet := posicione("SC5",1,xFilial("SC5")+getNumPV(SE1->E1_NUM),"!Eof()")

	if lRet
		recLock("FIE",.t.)
		FIE->FIE_FILIAL := xFilial("FIE")
		FIE->FIE_CART   := "R"
		FIE->FIE_PEDIDO := SC5->C5_NUM
		FIE->FIE_PREFIX := ::cPrefixo
		FIE->FIE_NUM    := SE1->E1_NUM
		FIE->FIE_PARCEL := SE1->E1_PARCELA
		FIE->FIE_TIPO   := SE1->E1_TIPO
		FIE->FIE_CLIENT := SE1->E1_CLIENTE
		FIE->FIE_FORNEC := ""
		FIE->FIE_LOJA   := SE1->E1_LOJA
		FIE->FIE_VALOR  := SE1->E1_VALOR
		FIE->FIE_SALDO  := SE1->E1_VALOR
		FIE->FIE_FILORI := xFilial("FIE")
		FIE->(msUnlock())
	else
		u_myHelp("Não foi encontrado o pedido de vendas para vincular o RA")
	endif

	Lj7RestArea(aArea)
return lRet
/*/{Protheus.doc} BolAntecip::atualizaStatus
Atualiza o campo de legenda do status do boleto antecipado
@type method
@version 12.1.33
@author Tiago Faria
@since 18/11/2021
@param cNumPV, character, Numero do pedido de vendas a ser atualizado, caso não passe a funcao atualiza todos os pedidos que houve modificacao do status
/*/
method atualizaStatus(cNumPV) class BolAntecip
	local cAlias                 := ''
	local cQuery                 := ''
	local cPVNormal              := "1"
	local cPgtoAntNEnviadoBoleto := "2"
	local cPgtoAntEnviadoBoleto  := "3"
	local cPgtoAntEmAberto       := "4"
	local cPgtoAntBaixado        := "5"
	local aArea					 := Lj7GetArea({"SC5"})
	default cNumPV               := ""

	cQuery += "SELECT * FROM (" + CRLF
	cQuery += "SELECT" + CRLF
	cQuery += "	CASE " + CRLF
	cQuery += "		WHEN E1_NUM IS NULL THEN '"  + cPgtoAntNEnviadoBoleto + "'" + CRLF
	cQuery += "		WHEN E1_NUM IS NOT NULL AND E1_SALDO = 0 THEN '" + cPgtoAntBaixado + "'" + CRLF
	cQuery += "		WHEN E1_NUM IS NOT NULL AND E1_SALDO > 0 AND QTD_IDCNAB = 0 THEN '" + cPgtoAntEnviadoBoleto + "'" + CRLF
	cQuery += "		WHEN E1_NUM IS NOT NULL AND E1_SALDO > 0 AND QTD_IDCNAB > 0 THEN '" + cPgtoAntEmAberto + "'" + CRLF
	cQuery += "	END AS STATUS," + CRLF
	cQuery += "	C5_ZZLEGBA," + CRLF
	cQuery += "	SC5.R_E_C_N_O_  AS C5RECNO" + CRLF

	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SC5') + CRLF

	cQuery += "OUTER APPLY(" + CRLF

	cQuery += "SELECT " + CRLF
	cQuery += "	E1_NUM," + CRLF
	cQuery += "	SUM(E1_SALDO) AS E1_SALDO," + CRLF
	cQuery += "	SUM(E1_VALOR) AS E1_VALOR," + CRLF
	cQuery += "	SUM(CASE WHEN E1_IDCNAB = '' THEN 0 ELSE 1 END) AS QTD_IDCNAB	" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SE1') + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SE1') + CRLF
	cQuery += "	AND E1_NUM = REPLICATE('0',3) + C5_NUM" + CRLF
	cQuery += "	AND E1_TIPO IN ('" + ::cTipo + "')" + CRLF
	cQuery += "	AND E1_PREFIXO = '" + ::cPrefixo + "'" + CRLF
	cQuery += "	AND " + RetSqlDel('SE1') + CRLF
	cQuery += "GROUP BY" + CRLF
	cQuery += "	E1_FILIAL," + CRLF
	cQuery += "	E1_NUM," + CRLF
	cQuery += "	E1_TIPO," + CRLF
	cQuery += "	E1_PREFIXO" + CRLF
	cQuery += ") SE1" + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SC5') + CRLF
	cQuery += "	AND C5_FORPGT IN " + formatIn(::cFormaPagamento,"/") + CRLF
	cQuery += "	AND C5_FORPGT <> ''" + CRLF
	if !empty(cNumPV)
		cQuery += "	AND C5_NUM = '" + cNumPV +  "'" + CRLF
	endif
	cQuery += "	AND " + RetSqlDel('SC5') + CRLF
	cQuery += ")X " + CRLF

	if empty(cNumPV)
		cQuery += "WHERE C5_ZZLEGBA <> STATUS" + CRLF
	endif
	TcQuery cQuery new Alias (cAlias := getNextAlias())

	if (cAlias)->(Eof()) .and. !empty(cNumPV)
		recLock("SC5",.f.)
		SC5->C5_ZZLEGBA := cPVNormal
		SC5->(msUnlock())
	endif

	while (cAlias)->(!Eof())
		SC5->(dbGoTo((cAlias)->(C5RECNO)))

		recLock("SC5",.f.)
		SC5->C5_ZZLEGBA := (cAlias)->(STATUS)
		SC5->(msUnlock())

		(cAlias)->(dbSkip())
	enddo

	(cAlias)->(dbCloseArea())
	Lj7RestArea(aArea)
return
