/*/{Protheus.doc} BolAntecip::isPVBoletoAntecipado
Avalia se a forma de pagamento e condição de pagamento são referente ao boleto antecipado
@type method
@version 12.1.33
@author Tiago Faria
@since 18/11/2021
@param cFormaPagamento, character, Código da formpa de pagamento
@param cCondPagamento, character, Código da condicao de pagamento
@param lHelp, logical, Indica se deve exibir o HELP caso o retorno seja .f.
@return logical, Se true o PV controla boleto antecipado se false não controla
/*/
method isPVBoletoAntecipado(cFormaPagamento,cCondPagamento,lHelp) class BolAntecip
return (BolAntecip():isFormaPgtoBolAntecipado(cFormaPagamento) .and. BolAntecip():isCondPgtoBolAntecipado(cCondPagamento,lHelp))
/*/{Protheus.doc} BolAntecip::isFormaPgtoBolAntecipado
Avalia se a forma de pagamento é boleto antecipado
@type method
@version 12.1.33
@author Tiago Faria
@since 18/11/2021
@param cFormaPagamento, character, Código da forma de pagamento
@return logical, Se true a forma de pagamento é de boleto antecipado se false não é
/*/
method isFormaPgtoBolAntecipado(cFormaPagamento) class BolAntecip
	local oBol              := BolAntecip():New()
	default cFormaPagamento := SC5->C5_FORPGT
return cFormaPagamento +"/" $ oBol:getFormaPagamento()
/*/{Protheus.doc} BolAntecip::isCondPgtoBolAntecipado
Avalia se a condição de pagamento esta parametrizada para a rotina de boleto antecipado
@type method
@version 12.1.33
@author Tiago Faria
@since 18/11/2021
@param cCondPagamento, character, Código da condicao de pagamento
@param lHelp, logical, Indica se o retorno for false deve exibir help de ajuda
@return logical, Se true a condicao de pagamento esta OK se false não esta
/*/
method isCondPgtoBolAntecipado(cCondPagamento,lHelp) class BolAntecip
	local cProblema        := ""
	local cSolucao         := ""
	local lRet             := .t.
	default cCondPagamento := SC5->C5_CONDPAG
	default lHelp          := .f.

	BEGIN SEQUENCE
		if posicione("SE4",1,xFilial("SE4")+cCondPagamento,"!Eof()") .and. SE4->E4_CTRADT <> "1"
			cProblema := "Para pedidos de vendas com forma de pagamento que gera boleto antecipado obrigatoriamente a condição de pagamento deve permitir adiantamento!"
			cSolucao := "Troque a condição de pagamento para continuar ou altere a condição de pagamento atual para permitir adiantamento!"
			break
		endif

		if isCPgtoMaisDeUmaParcela(cCondPagamento)
			cProblema := "Para pedidos de vendas com forma de pagamento que gera boleto antecipado obrigatoriamente a condição de pagamento deve gerar apenas 1 parcela para pagamento!"
			cSolucao := "Troque a condição de pagamento para uma que gere apenas 1 parcela"
			break
		endif

		RECOVER
		if lHelp
			u_myHelp(cProblema,cSolucao,"BOLETO ANTECIPADO")
		endif
		lRet := .f.

	END SEQUENCE
return lRet

method isLibAdmin() class BolAntecip
	local oBol := BolAntecip():new()
return oBol:lLiberaAdmin .and. FwIsAdmin()

static function getNumPV(cNumTit)
	default cNumTit := SE1->E1_NUM
return substr(cNumTit,4,getSX3Cache("C5_NUM","X3_TAMANHO"))

static function isCPgtoMaisDeUmaParcela(cCondPagamento)
return len(condicao(10000,cCondPagamento)) > 1 .and. SE4->E4_TIPO <> "9"

method somaDiasUteis(dData,nDias) class BolAntecip
	local nDia := 0
	local nDiaSoma := 1

	if nDias < 0
		nDiaSoma := nDiaSoma * -1
		nDias := nDias * -1
	endif

	while nDia < nDias
		dData := dData + nDiaSoma
		if dData <> dataValida(dData)
			loop
		endif

		nDia++
	enddo
return dData
/*/{Protheus.doc} BolAntecip::isRAAbertoCliente
Retorna se ha RA em abeto para o cliente e loja
@type method
@version 12.1.33
@author Tiago Faria
@since 22/11/2021
@return logical, Se true há RA em aberto se false não há
/*/
method isRAAbertoCliente(cCliente,cLoja) class BolAntecip
	local cAlias := ''
	local cQuery := ''

	cQuery += "SELECT * FROM (" + CRLF
	cQuery += "SELECT" + CRLF
	cQuery += "	E1_SALDO - COALESCE(FIE_VALOR,0) AS SALDO" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SE1') + CRLF

	cQuery += "OUTER APPLY" + CRLF
	cQuery += "(" + CRLF
	cQuery += "SELECT " + CRLF
	cQuery += "	FIE_NUM, " + CRLF
	cQuery += "	FIE_PARCEL, " + CRLF
	cQuery += "	FIE_TIPO, " + CRLF
	cQuery += "	FIE_PREFIX, " + CRLF
	cQuery += "	FIE_CLIENT, " + CRLF
	cQuery += "	FIE_LOJA, " + CRLF
	cQuery += "	SUM(FIE_VALOR) AS FIE_VALOR " + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('FIE') + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('FIE') + CRLF
	cQuery += "	AND FIE_CART = 'R'" + CRLF
	cQuery += "	AND FIE_CLIENT = E1_CLIENTE" + CRLF
	cQuery += "	AND FIE_LOJA = E1_LOJA" + CRLF
	cQuery += "	AND FIE_PREFIX = E1_PREFIXO" + CRLF
	cQuery += "	AND FIE_NUM = E1_NUM" + CRLF
	cQuery += "	AND FIE_PARCEL = E1_PARCELA" + CRLF
	cQuery += "	AND FIE_TIPO = 'RA'" + CRLF
	cQuery += "	AND " + RetSqlDel('FIE') + CRLF
	cQuery += "GROUP BY " + CRLF
	cQuery += "	FIE_NUM, " + CRLF
	cQuery += "	FIE_PARCEL, " + CRLF
	cQuery += "	FIE_TIPO, " + CRLF
	cQuery += "	FIE_PREFIX, " + CRLF
	cQuery += "	FIE_CLIENT, " + CRLF
	cQuery += "	FIE_LOJA" + CRLF
	cQuery += ")FIE" + CRLF

	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SE1') + CRLF
	cQuery += "	AND E1_CLIENTE = '" + cCliente + "'" + CRLF
	cQuery += "	AND E1_LOJA = '" + cLoja + "'" + CRLF
	cQuery += "	AND E1_TIPO = 'RA'" + CRLF
	cQuery += "	AND E1_SALDO > 0" + CRLF
	cQuery += "	AND " + RetSqlDel('SE1') + CRLF
	cQuery += ")X" + CRLF
	cQuery += "WHERE SALDO > 0" + CRLF

	TcQuery cQuery new Alias (cAlias := getNextAlias())

	lRet := (cAlias)->(!eof())

	(cAlias)->(dbCloseArea())
return lRet
/*/{Protheus.doc} BolAntecip::getBaseDup
Retorna a base da duplicata de um pedido que está sendo incluindo/alterado
@type method
@version 12.1.33
@author Tiago Faria
@since 24/11/2021
@return numeric, Retorna a base de duplicata do pedido
/*/
method getBaseDup() class BolAntecip
	MA410IMPOS(if(INCLUI,3,4)/*nOpc*/, .t./*lRetTotal*/, /*aRefRentab*/ )

	nBaseDup := getThreadValue("ZZNF_BASEDUP")
return nBaseDup

method reImprimir(cNumPV) class BolAntecip
	local aArea  := Lj7GetArea({"SE1"})
	local oBol   := BolAntecip():New()
	local cAlias := ''
	local cQuery := ''
	local cPath := ""
	default cNumPV := SC5->C5_NUM

	cQuery += "SELECT" + CRLF
	cQuery += "	SE1.R_E_C_N_O_ AS E1RECNO" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SE1') + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SE1') + CRLF
	cQuery += "	AND E1_NUM = '" + getNumTitulo(cNumPV) + "'" + CRLF
	cQuery += "	AND E1_TIPO IN ('" + oBol:cTipo + "')" + CRLF
	cQuery += "	AND E1_PREFIXO = '" + oBol:cPrefixo + "'" + CRLF
	cQuery += "	AND E1_PORTADO+E1_CONTA <> ''" + CRLF
	cQuery += "	AND " + RetSqlDel('SE1') + CRLF

	TcQuery cQuery new Alias (cAlias := getNextAlias())
	if (cAlias)->(!Eof())
		if ask(@cPath)
			oBol:cCaminhoBoleto := cPath

			while (cAlias)->(!Eof())
				SE1->(dbGoTo((cAlias)->(E1RECNO)))

				oBol:geraBoleto()

				(cAlias)->(dbSkip())
			enddo

			Lj7RestArea(aArea)
		endif
	else
		msgAlert("Não há dados para impressão do boleto!")
	endif
	(cAlias)->(dbCloseArea())
return

static function ask(cPath)
	local lRet          := .f.
	local oParam        := nil
	local oParamBox     := IpParamBoxObject():newIpParamBoxObject("BOLANTECIP")

	oParamBox:setTitle("Re-impressão boleto antecipado")
	//oParamBox:setUserSave(.f.)
	//oParamBox:setCanSave(.f.)

	oParam := IpParamObject():newIpParamObject("PATH", "file", "Caminho", "C", 60,254)
	oParam:setFileParams(GETF_RETDIRECTORY+GETF_LOCALHARD)
	oParam:setRequired(.T.)
	oParamBox:addParam(oParam)

	if oParamBox:show()
		lRet             := .t.
		cPath := alltrim(oParamBox:getValue("PATH"))
	endif
return lRet

static function getNumTitulo(cNumPV)
return PadL(cNumPV,getSX3Cache("E1_NUM","X3_TAMANHO"),"0")

method vldE1Prefixo(cPrefixo) class BolAntecip
	local oBol := BolAntecip():new()
	local lRet := .t.
	default cPrefixo := M->E1_PREFIXO

	if alltrim(cPrefixo) == alltrim(oBol:cPrefixo) .and. type("lF040Auto")=="L" .and. !lF040Auto
		u_myHelp("Prefixo reservado para uso na rotina de BOLETO ANTECIPADO")
		lRet := .f.
	endif
return lRet
