	aadd(aParamBox, {1, "Dt Entrega Até"             , stod("")                                    , ""               , ""               , ""   , "" , 70 , .F.}) // MV_PAR01
	// Adicionado por Felipe Silva.
	aadd(aParamBox, {1, "Dt Entrega Real"            , stod("")                                    , ""               , ""               , ""   , "" , 70 , .F.}) // MV_PAR02
