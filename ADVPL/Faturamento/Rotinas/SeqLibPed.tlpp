static function ExportExcel()
	local oView      	:= FwViewActive()
	local aViewGrid  	:= oView:GetViewObj("VIEW_GRID")
	local oGrid      	:= aViewGrid[3]
	local oGridModel 	:= oView:GetModel("MODEL_GRID")
	local nLine      	:= 0
	local oStruct    	:= oGrid:GetStruct()
	local nFields    	:= 0
	local aFields    	:= oStruct:GetFields()
	local nQtdFields 	:= Len(aFields)
	local cId        	:= ""
	local aRows      	:= FwSaveRows()
	local oJson 		:= JsonObject():New()
	local aItens		:= {}

	for nLine := 1 to oGridModel:length()
		oGridModel:goLine(nLine)

		for nFields := 1 to nQtdFields
			cId      := aFields[nFields][MVC_VIEW_IDFIELD]

			oJson[cId] := oGridModel:GetValue(cId)
		next nFields

		aAdd(aItens, oJson)

		oJson := JsonObject():New()
	next nLine

	FwRestRows(aRows)
	FwMsgRun(, {|| GeraPlan(aItens)}, "SOLPACK", "Abrindo o Excel...")
return

static function GeraPlan(aItens)
	local cDiretorio	:= ""
	local cExtensao		:= ".xlsx"
	local cTexto		:= ""
	local cDirAux		:= GetTempPath()
	local cTitle		:= "Planilha Gerada com Sucesso!"
	local cName			:= ""

	//cDiretorio := cGetFile("Arquivos (*" + Upper(cExtensao) + ") | *" + Upper(cExtensao) + " |","Selecione o Local de Destino",,,.F., GETF_RETDIRECTORY+GETF_LOCALHARD+GETF_NETWORKDRIVE)
	cDiretorio := TFileDialog("Arquivos | *.* | " + Upper(cExtensao) + " | *." + Upper(cExtensao) + " ", 'Selecione o Local de Destino',, cDirAux, .t., GETF_MULTISELECT)

	if !Empty(cDiretorio)
		cName := "sequenciamento_lib_pedido_" + FWTimeStamp()

		cTexto += "Planilha gerada em: " + CRLF
		cTexto += cDiretorio + cName + cExtensao

		IPJson():ToExcel(aItens, cDiretorio, cName, "PROCESSOS", .t., .t.)

		if File(cDiretorio + cName + cExtensao)
			Aviso(cTitle, cTexto, {"OK"}, 3)
		else
			Aviso("Erro","Não foi possível gerar a planilha em " + cDiretorio,{"OK"}, 3)
		endif
	endif
return

static function getPeso(cLegenda)
	local cPeso := "2"

	if alltrim(cLegenda) == "BR_VERDE"
		cPeso := "1"
	endif
return cPeso

static function isLibCredEstoque()
return alltrim(FwFldGet("LEG")) == "BR_VERDE"

static function isLibLocked(lUnlock)
	local cchave := FwFldGet("C9_PEDIDO")
	local lRet := .t.

	if lUnlock
		lRet := UnLockByName(cChave,.t./*lEmpresa*/,.t./*lFilial*/)
	else
		lRet := LockByName(cChave,.t./*lEmpresa*/,.t./*lFilial*/)
	endif
return lRet

static function linePre(oGrid,nLine,cAction,cIDField,xNewValue,xOldValue)
	local lRet := .t.
	if cAction == 'CANSETVALUE'
		if !isLibLocked(.f.)
			lRet := .f.
			u_myHelp("Não é possível editar este produto, pois já estão sendo editado por outro usuário!")
		endif
	endif

	if cAction == 'SETVALUE' .and. cIDField == "MARK" .and. !xNewValue
		isLibLocked(.t.)
	endif
return lRet


static function getDadosProd(lGridProd)
	local aRows    := FwSaveRows()
	local nField   := 0
	local nLine    := 0
	local cGridPrd := if(lGridProd,PREFIXO_PROD,"")
	local oModel   := FwModelActive()
	local oGrid    := oModel:getModel(strTran(cIDGrid,cGridPrd,""))
	local oStruct  := oGrid:getStruct()
	local aFields  := oStruct:getFields()
	local cProduto := oGrid:getValue("C9_PRODUTO")
	local aData    := {}
	local aAux     := {}

	for nLine := 1 to oGrid:length()
		oGrid:goLine(nLine)

		if oGrid:isDeleted() .or. cProduto <> oGrid:getValue("C9_PRODUTO")
			loop
		endif

		for nField := 1 to len(aFields)
			cID      := aFields[nField,MODEL_FIELD_IDFIELD]

			if cId == "LINHA"
				if oGrid:getValue("LINHA") <> 0
					aAdd(aAux,oGrid:getValue("LINHA"))
				else
					aAdd(aAux,oGrid:getLine())
				endif
			else
				aAdd(aAux,oGrid:getValue(cID))
			endif

		next nField

		aAdd(aData,{oGrid:getDataID(),aClone(aAux)})

		aAux := {}
	next nLine

	FwRestRows(aRows)
return aData

static function myCommit(oModel)
	local lRet := .t.

	nRecnoC9 := FwFldGet("C9RECNO")

	if lFilProd
		aDadosProd := getDadosProd(lFilProd)
	elseif isPrepDoc()
		geraNFSaida()
	elseif isFaturamento()
		updMarkReg(FwviewActive())
		libEstoque(FwviewActive())
		lShowFiltro := .f.
		fwMsgRun(, {|| runRefreshScreen(FwviewActive())}, "ATUALIZA TELA","Aguarde, atualizando os dados da tela...")
		lShowFiltro := .f.
	elseif isFinanceiro()
		libCredito(FwviewActive())
	endif

	grvCamposZZ(FwviewActive())
return lRet

