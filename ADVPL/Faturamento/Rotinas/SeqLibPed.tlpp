#include 'totvs.ch'
#include 'topconn.ch'
#include 'FWMVCDEF.ch'

static PROGRAMADO 			:= "Programado"
static IMEDIATO 			:= "Imediato"
static ATRASADOS 			:= "Atrasados"
static PREVISTO_MES_QUE_VEM := "Prog. mês que vem"
static PREVISTO				:= "Previsto"
static PREFIXO_PROD			:= "_PROD"
static nRecnoC9		:= 0

user function SeqLibPed(lPFilProd, nPercReducao,aDados)
	local oGrid          		:= nil
	local aEnableButtons 		:= {}
	local lConfirmou     		:= .f.

	private cIDModel     		:= "PE_SEQLIBPED"
	private cIDGrid      		:= "MODEL_GRID"
	private cIDView      		:= "VIEW_GRID"
	private cIDProgram   		:= "GRIDMVC"
	private nSaldoAtual  		:= 0
	private cSaldoAtual  		:= ""
	private cObsPedido   		:= ""
	private oPanelRodape 		:= nil
	private oSaySaldo    		:= nil
	private oObsPedido   		:= nil
	private lFilProd     		:= .f.
	private aDadosProd   		:= {}
	private dDataEntrega 	 	:= stod("")
	private dDataReal			:= stod("")
	private lFilAtra			:= .f.
	private lFilImed			:= .f.
	private lFilPrev			:= .f.
	private lFilProg			:= .f.
	private lLimDat				:= .f.
	private lListaProgramado	:= .t.
	private cTransportadora  	:= ""
	private lDebug 				:= if(IsInCallStack("U_DEBUG"),.t.,getNewPar("ZZ_DBGLPED",.F.))
	private lPositivo			:= .f.
	private ALTERA				:= .t.
	private INCLUI				:= .f.
	private lShowFiltro			:= .t.

	default lPFilProd    		:= .f.
	default nPercReducao 		:= nil

	nRecnoC9 := 0

	lFilProd := lPFilProd
	nModulo := 5
	if lFilProd
		aDadosProd := getDadosProd(.f.)
		/*
		cIDModel += PREFIXO_PROD
		cIDGrid += PREFIXO_PROD
		cIDView += PREFIXO_PROD
		cIDProgram += PREFIXO_PROD
		*/
	endif

	oGrid := GridMVCSQL():New(/*cID*/cIDModel,cIDProgram/*cIDProgram*/,cIDGrid/*cIdModel*/,cIDView/*cIDView*/)
//	oTimer := TTimer():New(1000, {|| alert(time()) }, oGrid )
	if isFaturamento()
		oGrid:setTitle("Sequenciamento Liberação Pedido")
	elseif isFinanceiro()
		oGrid:setTitle("Liberação de Crédito")
	endif
	oGrid:setMarkField("CRM")
	oGrid:addTypeField("MARK",'L')
	oGrid:addTypeField("C6_ENTREG","D",8,0)
	oGrid:addTypeField("C5_EMISSAO","D",8,0)
	oGrid:addTypeField("C6_ZZDTFAT","D",8,0)
	oGrid:addTypeField("SALDO","N",getSX3Cache("C9_PRCVEN","X3_TAMANHO"),getSX3Cache("C9_PRCVEN","X3_DECIMAL"))
	oGrid:addTypeField("C9_QTDLIB","N",getSX3Cache("C9_QTDLIB","X3_TAMANHO"),getSX3Cache("C9_QTDLIB","X3_DECIMAL"))
	oGrid:addTypeField("C9_ZZQTLIB","N",getSX3Cache("C9_QTDLIB","X3_TAMANHO"),getSX3Cache("C9_QTDLIB","X3_DECIMAL"))
	oGrid:addTypeField("QTD_LIB_ORIGINAL","N",getSX3Cache("C9_QTDLIB","X3_TAMANHO"),getSX3Cache("C9_QTDLIB","X3_DECIMAL"))
	oGrid:addTypeField("VLR_PENDENTE","N",getSX3Cache("B2_QATU","X3_TAMANHO"),getSX3Cache("B2_QATU","X3_DECIMAL"))

	// Campos adicionados por Felipe Silva.
	oGrid:addTypeField("C6_ZZVLR","N",getSX3Cache("B2_QATU","X3_TAMANHO"),getSX3Cache("B2_QATU","X3_DECIMAL"))
	oGrid:addTypeField("B2_QATU", "N", getSX3Cache("B2_QATU", "X3_TAMANHO"), getSX3Cache("B2_QATU", "X3_DECIMAL"))
	oGrid:addTypeField("ZO2_QTDPRE", "N", getSX3Cache("B2_QATU", "X3_TAMANHO"), getSX3Cache("B2_QATU", "X3_DECIMAL"))
	oGrid:addTypeField("C6_ZZDTRF", "D", 8, 0)
	oGrid:addTypeField("SALDO_PREVISTO", "N", getSX3Cache("C9_PRCVEN", "X3_TAMANHO"), getSX3Cache("C9_PRCVEN", "X3_DECIMAL"))
	oGrid:addTypeField("C9_PRCVEN", "N", getSX3Cache("C9_PRCVEN", "X3_TAMANHO"), getSX3Cache("C9_PRCVEN", "X3_DECIMAL"))

	oGrid:setQuery(getQuery())
	oGrid:setShowMarkAll(.f.)
	oGrid:setViewDef({|oView| modifyView(oView)})
	oGrid:setModelDef({|oView| modifyModel(oView)})
	oGrid:setPercentGrid(90)

	if lFilProd
		oGrid:getModelDef():setLoadGrid({|oModel| aDadosProd})
	endif

	aAdd(aEnableButtons ,{.f. ,nil})		 //1 - Copiar
	aAdd(aEnableButtons ,{.f. ,nil})         //2 - Recortar
	aAdd(aEnableButtons ,{.f. ,nil})         //3 - Colar
	aAdd(aEnableButtons ,{.f. ,nil})         //4 - Calculadora
	aAdd(aEnableButtons ,{.f. ,nil})         //5 - Spool
	aAdd(aEnableButtons ,{.f. ,nil})         //6 - Imprimir
	if isFinanceiro()
		aAdd(aEnableButtons ,{.t. ,'Lib. Crédito'})    //7 - Confirmar
	else
		aAdd(aEnableButtons ,{.t. ,'Gravar'})    //7 - Confirmar
	endif
	aAdd(aEnableButtons ,{.t. ,"Cancelar"})  //8 - Cancelar
	aAdd(aEnableButtons ,{.f. ,nil})         //9 - WalkTrhough
	aAdd(aEnableButtons ,{.f. ,nil})         //10 - Ambiente
	aAdd(aEnableButtons ,{.f. ,nil})         //11 - Mashup
	aAdd(aEnableButtons ,{.f. ,nil})         //12 - Help
	aAdd(aEnableButtons ,{.f. ,nil})         //13 - Formulário HTML
	aAdd(aEnableButtons ,{.f. ,nil})         //14 - ECM

	SetKey(VK_F4,{|| saldosEmEstoque()})
	if !lFilProd
		SetKey(VK_F5,{|| refreshScreen()})
	endif

	lConfirmou := oGrid:activate(/*nOperation*/,aEnableButtons,nPercReducao/*nPercReducao*/,/*cTitle*/,/*bCloseOnOK*/,/*bOk*/,/*bCancel*/)

	if !lConfirmou
		nRecnoC9 := 0
	endif

	if !lFilProd
		SetKey(VK_F4,nil)
		SetKey(VK_F5,nil)
	else
		aDados := aDadosProd
	endif
return lConfirmou

static function getQuery(lLimpa, lFilAll)
	local cQuery 	:= ''
	//local cAnoMes	:= cValToChar(Year(dDataBase)) + StrZero(Month(dDataBase), 2)
	local lEntrou	:= .f.
	local cDiaAtu	:= DToS(dDataBase)

	if !lFilProd .and. lShowFiltro
		ask()
	endif

	default lLimpa 	:= .f.
	default lFilAll := .f.

	cQuery += "SELECT" + CRLF

	cQuery += "	CRM," + CRLF
	cQuery += "	MARK," + CRLF
	cQuery += "	LEG," + CRLF
	cQuery += "	PEDIDO_ITEM," + CRLF
	cQuery += "	SITUACAO," + CRLF
	cQuery += "	C6_ZZOBSL," + CRLF
	cQuery += "	C5_EMISSAO," + CRLF
	cQuery += "	C6_ZZDTFAT," + CRLF
	cQuery += "	C6_ENTREG," + CRLF
	cQuery += "	C6_ZZDTRF," + CRLF
	cQuery += "	CLIENTE," + CRLF
	cQuery += "	VENDEDOR," + CRLF
	cQuery += "	DESC_PRODUTO," + CRLF
	cQuery += "	C9_PRODUTO," + CRLF
	cQuery += "	C9_ZZDTLIB," + CRLF
	cQuery += "	QTD_LIB_ORIGINAL," + CRLF
	if lPositivo
		cQuery += "CASE WHEN SALDO_PREVISTO >= 0 THEN C9_QTDLIB ELSE C9_QTDLIB - (SALDO_PREVISTO * -1) END AS C9_QTDLIB," + CRLF
	else
		cQuery += "C9_QTDLIB AS C9_QTDLIB," + CRLF
	endif
	cQuery += "	C9_ZZQTLIB," + CRLF
	cQuery += "	SALDO," + CRLF
	cQuery += "	SALDO_PREVISTO," + CRLF
	cQuery += "	VLR_PENDENTE," + CRLF
	if lPositivo
		cQuery += "CASE WHEN C6_ZZVLR = -1 THEN 0 WHEN SALDO_PREVISTO >= 0 THEN VLR_PENDENTE ELSE (C9_QTDLIB - (SALDO_PREVISTO * -1)) * C9_PRCVEN END AS C6_ZZVLR," + CRLF
	else
		cQuery += "CASE WHEN C6_ZZVLR = -1 THEN 0 ELSE VLR_PENDENTE END AS C6_ZZVLR," + CRLF
	endif
	cQuery += "VLR_PENDENTE AS VLR_PENDENTE," + CRLF
	cQuery += "	TRANSPORTADORA," + CRLF
	cQuery += "	B2_QATU," + CRLF
	cQuery += "	ZO2_QTDPRE," + CRLF
	cQuery += "	C9_BLEST," + CRLF
	cQuery += "	C9_BLCRED," + CRLF
	cQuery += "	C9_PEDIDO," + CRLF
	cQuery += "	C9_ITEM," + CRLF
	cQuery += "	C9RECNO," + CRLF
	cQuery += "	C5RECNO," + CRLF
	cQuery += "	C6RECNO," + CRLF
	cQuery += "	C5_ZZIFCPL," + CRLF
	cQuery += "	C9_PRCVEN," + CRLF
	cQuery += "	POSSUI_SALDO," + CRLF
	cQuery += "	LINHA" + CRLF

	cQuery += "FROM (" + CRLF

	cQuery += "SELECT" + CRLF
	cQuery += "	'F' AS CRM," + CRLF
	cQuery += "	'F' AS MARK," + CRLF
	cQuery += "	CASE" + CRLF
	cQuery += "		WHEN C9_BLCRED <>'' AND C9_BLCRED<>'10' AND C9_BLCRED<>'ZZ' AND C9_BLCRED <> '09' THEN 'BR_AZUL'" + CRLF
	cQuery += "		WHEN (C9_BLCRED = '10' AND C9_BLEST = '10') Or (C9_BLCRED = 'ZZ' AND C9_BLEST = 'ZZ') THEN 'BR_VERMELHO'" + CRLF
	cQuery += "		WHEN C9_BLEST ='' AND C9_BLCRED = '' AND (C9_BLWMS>='05' OR C9_BLWMS='  ') AND C9_BLTMS = '' THEN 'BR_VERDE'" + CRLF
	cQuery += "		WHEN C9_BLCRED = '09' AND C9_BLCRED <> '10'AND C9_BLCRED <> 'ZZ' THEN 'BR_MARROM'" + CRLF
	cQuery += "		WHEN C6_ZZLEG = 'P' THEN 'BR_PRETO'" + CRLF
	cQuery += "		WHEN C6_ZZLEG = 'A' THEN 'BR_AMARELO'" + CRLF

	// Adicionado por Felipe Silva.
	cQuery += "		WHEN COALESCE(ZO2_QTDPRE, 0) + B2_QATU - " + u_regraSaldo() + "  >= 0 THEN 'BR_AMARELO'" + CRLF

	cQuery += "		WHEN C9_BLEST<>'  ' AND C9_BLEST<>'10'AND C9_BLEST<>'ZZ' THEN 'BR_PRETO'" + CRLF
	cQuery += "		WHEN C9_BLWMS<='05' AND C9_BLWMS<>'  ' THEN 'BR_AMARELO'" + CRLF
	cQuery += "		WHEN C9_BLTMS <> ' ' THEN 'BR_LARANJA'" + CRLF
	cQuery += "		ELSE 'BR_CANCEL'" + CRLF
	cQuery += "	END AS LEG," + CRLF
	cQuery += "	C9_PEDIDO+'-'+C9_ITEM AS PEDIDO_ITEM," + CRLF
	cQuery += "	SITUACAO," + CRLF
	cQuery += "	C5_EMISSAO," + CRLF
	cQuery += "	C6_ZZDTFAT," + CRLF
	cQuery += "	C6_ENTREG," + CRLF
	cQuery += "	C6_ZZDTRF AS C6_ZZDTRF," + CRLF
	cQuery += "	C5_CLIENTE+'/'+C5_LOJACLI+':'+A1_NOME AS CLIENTE," + CRLF
	cQuery += "	A3_COD+':'+A3_NOME AS VENDEDOR," + CRLF
	cQuery += "	C9_PRODUTO +'-'+ B1_DESC AS DESC_PRODUTO," + CRLF
	cQuery += "	C9_PRODUTO," + CRLF
	cQuery += "	C9_QTDLIB AS QTD_LIB_ORIGINAL," + CRLF
	cQuery += "	C9_QTDLIB," + CRLF
	cQuery += "	C9_ZZQTLIB," + CRLF
	cQuery += "	C9_ZZDTLIB," + CRLF
	cQuery += "	B2_QATU - " + u_regraSaldo() + " " + CRLF
	cQuery += "	 AS SALDO," + CRLF

	// Adicionado por Felipe Silva.
	cQuery += "	COALESCE(ZO2_QTDPRE, 0) + B2_QATU - " + u_regraSaldo() + "" + CRLF
	cQuery += "	 AS SALDO_PREVISTO," + CRLF

	cQuery += "	C9_QTDLIB * C9_PRCVEN AS VLR_PENDENTE," + CRLF
	cQuery += "	C5_TRANSP + '-' + A4_NOME AS TRANSPORTADORA," + CRLF
	cQuery += "	B2_QATU," + CRLF
	cQuery += "	COALESCE(ZO2_QTDPRE, 0) AS ZO2_QTDPRE," + CRLF
	cQuery += "	C9_BLEST," + CRLF
	cQuery += "	C9_BLCRED," + CRLF
	cQuery += "	C9_PEDIDO," + CRLF
	cQuery += "	C9_ITEM," + CRLF
	cQuery += "	C9RECNO," + CRLF
	cQuery += "	C5RECNO," + CRLF
	cQuery += "	C6RECNO," + CRLF
	cQuery += "	CONVERT(VARCHAR(8000),CONVERT(VARBINARY(8000),C5_ZZIFCPL)) C5_ZZIFCPL," + CRLF
	cQuery += "	CONVERT(VARCHAR(8000),CONVERT(VARBINARY(8000),C6_ZZOBSL)) C6_ZZOBSL," + CRLF
	cQuery += "	C9_PRCVEN," + CRLF
	cQuery += "	C6_ZZVLR," + CRLF
	cQuery += "	PEDIDO_COM_SALDO_FUTURO.SALDO AS POSSUI_SALDO," + CRLF
	cQuery += "	0 AS LINHA" + CRLF
	cQuery += "FROM" + CRLF

	cQuery += "(" + CRLF
	cQuery += "SELECT" + CRLF
	cQuery += "	SC9.R_E_C_N_O_ AS C9RECNO," + CRLF
	cQuery += "	SC5.R_E_C_N_O_ AS C5RECNO," + CRLF
	cQuery += "	SC6.R_E_C_N_O_ AS C6RECNO," + CRLF
	cQuery += u_regraSituacao()
	cQuery += "	B1_ZZPE" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SC9') + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SC5') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SC5') + CRLF
	cQuery += "	AND C5_NUM = C9_PEDIDO" + CRLF
	cQuery += "	AND C5_TIPO = 'N'" + CRLF
	if !empty(cTransportadora)
		cQuery += "	AND C5_TRANSP = '" + cTransportadora + "'" + CRLF
	endif
	cQuery += "	AND " + RetSqlDel('SC5') + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SC6') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SC6') + CRLF
	cQuery += "	AND C6_NUM = C9_PEDIDO" + CRLF
	cQuery += "	AND C6_ITEM = C9_ITEM" + CRLF
	if !empty(dDataEntrega)
		cQuery += "	AND C6_ENTREG <= '" + dtos(dDataEntrega) + "'" + CRLF
	endif
	if !empty(dDataReal)
		//cQuery += "	AND (C6_ZZDTRF <= '" + dtos(dDataReal) + "' OR POSSUI_SALDO = 'S')" + CRLF
		cQuery += "	AND (C6_ZZDTRF <= '" + dtos(dDataReal) + "')" + CRLF	
	endif
	cQuery += "	AND " + RetSqlDel('SC6') + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SB1') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SB1') + CRLF
	cQuery += "	AND B1_COD = C9_PRODUTO" + CRLF
	cQuery += "	AND " + RetSqlDel('SB1') + CRLF

	cQuery += "LEFT JOIN" + CRLF
	cQuery += "(" + CRLF
	cQuery += "SELECT" + CRLF
	cQuery += "	C9_FILIAL AS FILIAL," + CRLF
	cQuery += "	C9_PEDIDO AS PEDIDO," + CRLF
	cQuery += "	C9_ITEM AS ITEM," + CRLF
	cQuery += "	SUM(C9_QTDLIB) AS QTDLIB" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + retSqlTab("SC9") + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("SC9") + CRLF
	cQuery += "	AND SC9.C9_NFISCAL = ' '" + CRLF
	cQuery += "	AND C9_BLEST = ' '" + CRLF
	cQuery += "	AND C9_BLCRED = ' '" + CRLF
	cQuery += "	AND " + retSqlDel("SC9") + CRLF
	cQuery += "GROUP BY" + CRLF
	cQuery += "	C9_FILIAL," + CRLF
	cQuery += "	C9_PEDIDO," + CRLF
	cQuery += "	C9_ITEM" + CRLF
	cQuery += ") C9QTDLIB" + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "AND FILIAL = C9_FILIAL" + CRLF
	cQuery += "AND PEDIDO = C9_PEDIDO" + CRLF
	cQuery += "AND ITEM = C9_ITEM" + CRLF

	cQuery += ") C9" + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SC9') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND SC9.R_E_C_N_O_ = C9.C9RECNO " + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SC6') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND SC6.R_E_C_N_O_ = C9.C6RECNO " + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SC5') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND SC5.R_E_C_N_O_ = C9.C5RECNO " + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SA4') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SA4') + CRLF
	cQuery += "	AND A4_COD = C5_TRANSP" + CRLF
	cQuery += "	AND " + RetSqlDel('SA4') + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SA1') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SA1') + CRLF
	cQuery += "	AND A1_COD = C5_CLIENTE" + CRLF
	cQuery += "	AND A1_LOJA = C5_LOJACLI" + CRLF
	cQuery += "	AND " + RetSqlDel('SA1') + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + RetSqlTab('SB1') + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SB1') + CRLF
	cQuery += "	AND B1_COD = C9_PRODUTO" + CRLF
	cQuery += "	AND " + RetSqlDel('SB1') + CRLF

	// Adicionado por Felipe Silva.
	cQuery += "LEFT JOIN " + RetSqlTab('SA3') + "" + CRLF
	cQuery += "	ON 1 = 1" + CRLF
	cQuery += "	AND SA3.A3_FILIAL = '" + FWxFilial("SA3")+ "'" + CRLF
	cQuery += "	AND SA3.A3_COD = SC5.C5_VEND1" + CRLF
	cQuery += "	AND SA3.D_E_L_E_T_ = ' '" + CRLF

	cQuery += "CROSS APPLY" + CRLF
	cQuery += "(" + CRLF
	cQuery += "SELECT" + CRLF
	cQuery += "	B2_COD," + CRLF
	cQuery += "	SUM(B2_QATU-B2_RESERVA) AS B2_QATU" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + RetSqlTab('SB2') + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + RetSqlFil('SB2') + CRLF
	cQuery += "	AND B2_COD = C6_PRODUTO" + CRLF
	cQuery += "	AND " + RetSqlDel('SB2') + CRLF
	cQuery += "GROUP BY B2_COD" + CRLF
	cQuery += ") SB2" + CRLF

	cQuery += "OUTER APPLY (" + CRLF
	cQuery += "SELECT" + CRLF
	cQuery += "	CASE" + CRLF
	cQuery += "		WHEN" + CRLF
	cQuery += "			QTD_DIAS = 1" + CRLF
	cQuery += "		THEN" + CRLF
	cQuery += "			SALDO" + CRLF
	cQuery += "		WHEN" + CRLF
	cQuery += "			SALDO < ZO2_QTDPRE" + CRLF
	cQuery += "		THEN " + CRLF
	cQuery += "			SALDO" + CRLF
	cQuery += "		ELSE ZO2_QTDPRE" + CRLF
	cQuery += "	END AS ZO2_QTDPRE" + CRLF
	cQuery += "FROM (" + CRLF
	cQuery += "	SELECT" + CRLF
	cQuery += "		SUM(((CASE" + CRLF
	cQuery += "		WHEN" + CRLF
	cQuery += "			SUBSTRING(ZO2_DATPRI, 1, 6) < SUBSTRING(ZO2_DATPRF, 1, 6)" + CRLF
	cQuery += "		THEN" + CRLF
	cQuery += "			CASE WHEN ZO2_DATPRI < '" + cDiaAtu + "' THEN DATEDIFF(DAY, '" + cDiaAtu + "', EOMONTH('" + cDiaAtu + "')) - (DATEDIFF(WEEK, '" + cDiaAtu + "', EOMONTH('" + cDiaAtu + "')) * 1) ELSE DATEDIFF(DAY, ZO2_DATPRI, EOMONTH('" + cDiaAtu + "')) - (DATEDIFF(WEEK, ZO2_DATPRI, EOMONTH('" + cDiaAtu + "')) * 1) END" + CRLF
	cQuery += "		ELSE" + CRLF
	cQuery += "			CASE WHEN ZO2_DATPRI < '" + cDiaAtu + "' THEN DATEDIFF(DAY, '" + cDiaAtu + "', ZO2_DATPRF) - (DATEDIFF(WEEK, '" + cDiaAtu + "', ZO2_DATPRF) * 1) ELSE DATEDIFF(DAY, ZO2_DATPRI, ZO2_DATPRF) - (DATEDIFF(WEEK, ZO2_DATPRI, ZO2_DATPRF) * 1) END" + CRLF
	cQuery += "		END + 1) * (CASE WHEN ZO2.ZO2_PRODIA > (ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) THEN (ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) ELSE ZO2.ZO2_PRODIA END * SB1.B1_QE)) - H6_QTDPROD) AS ZO2_QTDPRE," + CRLF
	cQuery += "		SUM((ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) * SB1.B1_QE) AS SALDO," + CRLF
	cQuery += "		SUM(CASE" + CRLF
	cQuery += "		WHEN" + CRLF
	cQuery += "			SUBSTRING(ZO2_DATPRI, 1, 6) < SUBSTRING(ZO2_DATPRF, 1, 6)" + CRLF
	cQuery += "		THEN" + CRLF
	cQuery += "			CASE WHEN ZO2_DATPRI < '" + cDiaAtu + "' THEN DATEDIFF(DAY, '" + cDiaAtu + "', EOMONTH('" + cDiaAtu + "')) - (DATEDIFF(WEEK, '" + cDiaAtu + "', EOMONTH('" + cDiaAtu + "')) * 1) ELSE DATEDIFF(DAY, ZO2_DATPRI, EOMONTH('" + cDiaAtu + "')) - (DATEDIFF(WEEK, ZO2_DATPRI, EOMONTH('" + cDiaAtu + "')) * 1) END" + CRLF
	cQuery += "		ELSE" + CRLF
	cQuery += "			CASE WHEN ZO2_DATPRI < '" + cDiaAtu + "' THEN DATEDIFF(DAY, '" + cDiaAtu + "', ZO2_DATPRF) - (DATEDIFF(WEEK, '" + cDiaAtu + "', ZO2_DATPRF) * 1) ELSE DATEDIFF(DAY, ZO2_DATPRI, ZO2_DATPRF) - (DATEDIFF(WEEK, ZO2_DATPRI, ZO2_DATPRF) * 1) END" + CRLF
	cQuery += "		END + 1) AS QTD_DIAS" + CRLF
	cQuery += "	FROM " + RetSqlTab('ZO2') + "" + CRLF
	cQuery += "	OUTER APPLY (" + CRLF
	cQuery += "		SELECT" + CRLF
	cQuery += "			CASE" + CRLF
	cQuery += "				WHEN" + CRLF
	cQuery += "					SB1.B1_XTPPROD <> 2" + CRLF
	cQuery += "				THEN" + CRLF
	cQuery += "					COALESCE(SB1.B1_QE, 1)" + CRLF
	cQuery += "				ELSE" + CRLF
	cQuery += "					1" + CRLF
	cQuery += "				END AS B1_QE" + CRLF
	cQuery += "		FROM " + RetSqlTab('SB1') + "" + CRLF
	cQuery += "		WHERE" + CRLF
	cQuery += "			1 = 1" + CRLF
	cQuery += "			AND SB1.B1_FILIAL = '" + FWxFilial("SB1") + "'" + CRLF
	cQuery += "			AND SB1.B1_COD = ZO2.ZO2_PRODUT" + CRLF
	cQuery += "			AND SB1.D_E_L_E_T_ = ' '" + CRLF
	cQuery += "	) SB1" + CRLF
	cQuery += "	OUTER APPLY(" + CRLF
	cQuery += "	SELECT" + CRLF
	cQuery += "		(CASE " + CRLF
	cQuery += "			WHEN " + CRLF
	cQuery += "				(COALESCE(SUM(SH6.H6_QTDPROD), 0) / SB1.B1_QE) >= ZO2.ZO2_PRODIA" + CRLF
	cQuery += "			THEN" + CRLF
	cQuery += "				ZO2.ZO2_PRODIA" + CRLF
	cQuery += "			ELSE" + CRLF
	cQuery += "				(COALESCE(SUM(SH6.H6_QTDPROD), 0) / SB1.B1_QE)" + CRLF
	cQuery += "		END * SB1.B1_QE) AS H6_QTDPROD" + CRLF
	cQuery += "		FROM " + RetSqlTab('SH6') + "" + CRLF
	cQuery += "		WHERE" + CRLF
	cQuery += "			1 = 1" + CRLF
	cQuery += "			AND SH6.H6_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
	cQuery += "			AND SH6.H6_OP = ZO2.ZO2_NUM" + CRLF
	cQuery += "			AND SH6.H6_PRODUTO = ZO2.ZO2_PRODUT" + CRLF
	cQuery += "			AND SH6.H6_DATAFIN = '" + cDiaAtu + "'" + CRLF
	cQuery += "			AND SH6.D_E_L_E_T_ = ' '" + CRLF
	cQuery += "	) SH6" + CRLF
	cQuery += "	WHERE" + CRLF
	cQuery += "		1 = 1" + CRLF
	cQuery += "		AND ZO2.ZO2_FILIAL = '" + FWxFilial("ZO2") + "'" + CRLF
	cQuery += "		AND ZO2.ZO2_PRODUT = C6_PRODUTO" + CRLF
	cQuery += "		AND ZO2_DATPRI <= EOMONTH('" + cDiaAtu + "') AND ZO2_DATPRF >= '" + cDiaAtu + "'" + CRLF
	cQuery += "		AND (ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) > 0" + CRLF
	cQuery += "		AND ZO2.D_E_L_E_T_ = ' ') XPTO1" + CRLF
	cQuery += ") ZO2" + CRLF

	cQuery += "OUTER APPLY (" + CRLF
	cQuery += "	SELECT TOP 1" + CRLF
	cQuery += "		CASE WHEN " + CRLF
	cQuery += "		COALESCE(ZO2_QTDPRE, 0) + B2_QATU - SUM(CASE " + CRLF
	cQuery += "		WHEN C9_BLEST ='' AND C9_BLCRED = '' AND (C9_BLWMS>='05' OR C9_BLWMS='  ') AND C9_BLTMS = '' THEN 0" + CRLF
	cQuery += "		WHEN CAST(C6_ENTREG AS DATETIME) > EOMONTH(CAST('" + cDiaAtu + "' AS DATETIME),-1) AND" + CRLF
	cQuery += "			(C9_BLEST IS NULL OR C9_BLEST <> ' ' OR C9_BLCRED <> ' ') AND" + CRLF
	cQuery += "			(DATEPART(YEAR,CAST(C6_ENTREG AS DATETIME)) <> DATEPART(YEAR,GETDATE()) OR DATEPART(MONTH,CAST(C6_ENTREG AS DATETIME)) <> DATEPART(MONTH,GETDATE())) AND" + CRLF
	cQuery += "			DATEDIFF(DAY, CAST(C5_EMISSAO AS DATETIME), CAST(C6_ENTREG AS DATETIME)) > SB1.B1_ZZPE THEN 0" + CRLF
	cQuery += "		ELSE C9_QTDLIB " + CRLF
	cQuery += "		END) OVER (	Partition By C9_PRODUTO " + CRLF
	cQuery += "				Order by C9_PEDIDO,C9_PRODUTO,C9_ITEM rows unbounded preceding) > 0 THEN 'S' ELSE 'N' END AS SALDO" + CRLF
	cQuery += "	FROM " + RetSqlTab('SC5') + "" + CRLF
	cQuery += "	INNER JOIN " + RetSqlTab('SC6') + "" + CRLF
	cQuery += "		ON 1 = 1" + CRLF
	cQuery += "		AND SC6.C6_FILIAL = '" + FWxFilial("SC6") + "'" + CRLF
	cQuery += "		AND SC6.C6_NUM = SC5.C5_NUM" + CRLF
	cQuery += "		AND SC6.D_E_L_E_T_ = ' '" + CRLF
	cQuery += "	OUTER APPLY (" + CRLF
	cQuery += "	SELECT" + CRLF
	cQuery += "		CASE WHEN SALDO < ZO2_QTDPRE THEN SALDO ELSE ZO2_QTDPRE END AS ZO2_QTDPRE" + CRLF
	cQuery += "	FROM (" + CRLF
	cQuery += "		SELECT" + CRLF
	cQuery += "			SUM(((CASE" + CRLF
	cQuery += "			WHEN" + CRLF
	cQuery += "				SUBSTRING(ZO2_DATPRI, 1, 6) < SUBSTRING(ZO2_DATPRF, 1, 6)" + CRLF
	cQuery += "			THEN" + CRLF
	cQuery += "				CASE WHEN ZO2_DATPRI < '" + cDiaAtu + "' THEN DATEDIFF(DAY, '" + cDiaAtu + "', EOMONTH('" + cDiaAtu + "')) - (DATEDIFF(WEEK, '" + cDiaAtu + "', EOMONTH('" + cDiaAtu + "')) * 1) ELSE DATEDIFF(DAY, ZO2_DATPRI, EOMONTH('" + cDiaAtu + "')) - (DATEDIFF(WEEK, ZO2_DATPRI, EOMONTH('" + cDiaAtu + "')) * 1) END" + CRLF
	cQuery += "			ELSE" + CRLF
	cQuery += "				CASE WHEN ZO2_DATPRI < '" + cDiaAtu + "' THEN DATEDIFF(DAY, '" + cDiaAtu + "', ZO2_DATPRF) - (DATEDIFF(WEEK, '" + cDiaAtu + "', ZO2_DATPRF) * 1) ELSE DATEDIFF(DAY, ZO2_DATPRI, ZO2_DATPRF) - (DATEDIFF(WEEK, ZO2_DATPRI, ZO2_DATPRF) * 1) END" + CRLF
	cQuery += "			END + 1) * (CASE WHEN ZO2.ZO2_PRODIA > (ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) THEN (ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) ELSE ZO2.ZO2_PRODIA END * SB1.B1_QE)) - H6_QTDPROD) AS ZO2_QTDPRE," + CRLF
	cQuery += "			SUM((ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) * SB1.B1_QE) AS SALDO" + CRLF
	cQuery += "		FROM  " + RetSqlTab('ZO2') + " " + CRLF
	cQuery += "		OUTER APPLY (" + CRLF
	cQuery += "			SELECT" + CRLF
	cQuery += "				CASE" + CRLF
	cQuery += "					WHEN" + CRLF
	cQuery += "						SB1.B1_XTPPROD <> 2" + CRLF
	cQuery += "					THEN" + CRLF
	cQuery += "						COALESCE(SB1.B1_QE, 1)" + CRLF
	cQuery += "					ELSE" + CRLF
	cQuery += "						1" + CRLF
	cQuery += "					END AS B1_QE" + CRLF
	cQuery += "			FROM  " + RetSqlTab('SB1') + " " + CRLF
	cQuery += "			WHERE" + CRLF
	cQuery += "				1 = 1" + CRLF
	cQuery += "				AND SB1.B1_FILIAL = '" + FWxFilial("SB1") + "'" + CRLF
	cQuery += "				AND SB1.B1_COD = ZO2.ZO2_PRODUT" + CRLF
	cQuery += "				AND SB1.D_E_L_E_T_ = ' '" + CRLF
	cQuery += "		) SB1" + CRLF
	cQuery += "		OUTER APPLY(" + CRLF
	cQuery += "			SELECT" + CRLF
	cQuery += "				(CASE " + CRLF
	cQuery += "					WHEN " + CRLF
	cQuery += "						(COALESCE(SUM(SH6.H6_QTDPROD), 0) / SB1.B1_QE) >= ZO2.ZO2_PRODIA" + CRLF
	cQuery += "					THEN" + CRLF
	cQuery += "						ZO2.ZO2_PRODIA" + CRLF
	cQuery += "					ELSE" + CRLF
	cQuery += "						(COALESCE(SUM(SH6.H6_QTDPROD), 0) / SB1.B1_QE)" + CRLF
	cQuery += "				END * SB1.B1_QE) AS H6_QTDPROD" + CRLF
	cQuery += "			FROM " + RetSqlTab('SH6') + " " + CRLF
	cQuery += "			WHERE" + CRLF
	cQuery += "				1 = 1" + CRLF
	cQuery += "				AND SH6.H6_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
	cQuery += "				AND SH6.H6_OP = ZO2.ZO2_NUM" + CRLF
	cQuery += "				AND SH6.H6_PRODUTO = ZO2.ZO2_PRODUT" + CRLF
	cQuery += "				AND SH6.H6_DATAFIN = '" + cDiaAtu + "'" + CRLF
	cQuery += "				AND SH6.D_E_L_E_T_ = ' '" + CRLF
	cQuery += "		) SH6" + CRLF
	cQuery += "		WHERE" + CRLF
	cQuery += "			1 = 1" + CRLF
	cQuery += "			AND ZO2.ZO2_FILIAL = '" + FWxFilial("ZO2") + "'" + CRLF
	cQuery += "			AND ZO2.ZO2_PRODUT = SC6.C6_PRODUTO" + CRLF
	cQuery += "			AND ZO2_DATPRI <= EOMONTH('" + cDiaAtu + "') AND ZO2_DATPRF >= '" + cDiaAtu + "'" + CRLF
	cQuery += "			AND (ZO2.ZO2_QUANT-ZO2.ZO2_QUJE) > 0" + CRLF
	cQuery += "			AND ZO2.D_E_L_E_T_ = ' ') XPTO1" + CRLF
	cQuery += "	) ZO2" + CRLF
	cQuery += "	WHERE" + CRLF
	cQuery += "		1 = 1" + CRLF
	cQuery += "		AND SC5.C5_FILIAL = '" + FWxFilial("SC5") + "'" + CRLF
	cQuery += "		AND SC5.C5_NUM = C9_PEDIDO" + CRLF
	cQuery += "		AND SC5.D_E_L_E_T_ = ' '" + CRLF
	cQuery += "	ORDER BY SALDO ASC" + CRLF
	cQuery += ") PEDIDO_COM_SALDO_FUTURO" + CRLF

	cQuery += "WHERE 1=1" + CRLF
	//SE FOR A TELA DE FILTRO DE PRODUTO NÃO CARREGA OS DADOS POIS SERÃO CARREGADOS A PARTIR DA MEMÓRIA
	if lFilProd
		cQuery += " AND 1=2" + CRLF
	endif
	cQuery += "	AND " + RetSqlFil('SC9') + CRLF
	cQuery += "	AND NOT ((C9_BLCRED='10'And C9_BLEST='10') OR (C9_BLCRED='ZZ' AND C9_BLEST='ZZ')) --PEDIDOS NAO FATURADO" + CRLF
	if lDebug
		cQuery += "	AND C9_PRODUTO LIKE '30.20.02%'" + CRLF
	endif
	if !empty(getSX3Cache("Z3_CLIENTE","X3_CAMPO"))
		cQuery += "	AND NOT EXISTS (" + CRLF
		cQuery += "	SELECT * FROM" + CRLF
		cQuery += "		" + RetSqlTab('SZ3') + CRLF
		cQuery += "	WHERE 1=1" + CRLF
		cQuery += "		AND " + RetSqlFil('SZ3') + CRLF
		cQuery += "		AND (Z3_PEDIDO = C9_PEDIDO" + CRLF
		cQuery += "			OR Z3_PRODUTO = C9_PRODUTO" + CRLF
		cQuery += "			OR (Z3_CLIENTE = C9_CLIENTE AND Z3_LOJA = C9_LOJA)" + CRLF
		cQuery += "		)" + CRLF
		cQuery += "		AND " + RetSqlDel('SZ3') + CRLF
		cQuery += "	)" + CRLF
	endif
	if !lListaProgramado
		cQuery += "	AND SITUACAO <> '" + PROGRAMADO + "'" + CRLF
	endif
	cQuery += " AND (" + CRLF
	if lFilAtra
		lEntrou := .t.
		cQuery += " SITUACAO = '" + ATRASADOS + "' " + CRLF
	endif
	if lFilImed
		if lEntrou
			cQuery += " OR "
		else
			lEntrou := .t.
		endif

		cQuery += "  SITUACAO = '" + IMEDIATO + "' " + CRLF
	endif
	if lFilPrev
		if lEntrou
			cQuery += " OR "
		else
			lEntrou := .t.
		endif

		cQuery += " SITUACAO = '" + PREVISTO + "' " + CRLF
	endif
	if lFilProg
		if lEntrou
			cQuery += " OR "
		else
			lEntrou := .t.
		endif

		cQuery += " SITUACAO = '" + PROGRAMADO + "' " + CRLF
	endif
	if lEntrou
		cQuery += ")"
	else
		cQuery += " 1 = 1)"
	endif
	cQuery += "	AND " + RetSqlDel('SC9') + CRLF

	cQuery += ") QRY_LIB_PEDIDO" + CRLF
	cQuery += "WHERE 1 = 1" + CRLF

	if lPositivo
		cQuery += " AND CASE WHEN SALDO_PREVISTO >= 0 THEN C9_QTDLIB ELSE C9_QTDLIB - (SALDO_PREVISTO * -1) END > 0" + CRLF
	endif

	// Filtro adicionado por Felipe Silva.
	//if !empty(dDataReal)
	//	//cQuery += "	AND (C6_ZZDTRF <= '" + dtos(dDataReal) + "' OR POSSUI_SALDO = 'S')" + CRLF
	//	cQuery += "	AND (C6_ZZDTRF <= '" + dtos(dDataReal) + "')" + CRLF
	//endif

	cQuery += "ORDER BY C9_PEDIDO,C9_ITEM" + CRLF

	// Função responsável por atualizar o campo Qt Liberada [C9_ZZQTLIB] da rotina 'Sequenciamento Liberação Pedido'
	u_limpaData(cQuery)
	u_updSeqQtdLib(cQuery)
return cQuery

static function modifyModel(oModel)
	local oGrid   		:= oModel:getModel(cIDGrid)
	local oStruct 		:= oGrid:getStruct()
	local bValid  		:= FWBuildFeature( STRUCT_FEATURE_VALID,"u_vldQtdLib('C9_QTDLIB')")
	local bC6Valid		:= FWBuildFeature( STRUCT_FEATURE_VALID,"u_vldQtdLib('C9_ZZQTLIB')")
	local bVldDtReal	:= FWBuildFeature( STRUCT_FEATURE_VALID,"u_grvDataReal()")
	local bVldObserv	:= FWBuildFeature( STRUCT_FEATURE_VALID,"u_grvObserv()")
	local bVldVlrReal	:= FWBuildFeature( STRUCT_FEATURE_VALID,"u_grvVlrReal()")
	local bMark   		:= FWBuildFeature( STRUCT_FEATURE_VALID,"u_vldMark()")

	oGrid:SetMaxLine(99999999)
	oGrid:SetLPre({|oGrid,nLine,cAction,cIDField,xNewValue,xOldValue| linePre(oGrid,nLine,cAction,cIDField,xNewValue,xOldValue)})
	oStruct:setProperty( 'C9_QTDLIB' 	,MODEL_FIELD_VALID ,bValid)
	oStruct:setProperty( 'C9_ZZQTLIB' 	,MODEL_FIELD_VALID ,bC6Valid)
	oStruct:setProperty( 'C6_ZZDTRF'	,MODEL_FIELD_VALID ,bVldDtReal)
	oStruct:setProperty( 'C6_ZZVLR'		,MODEL_FIELD_VALID ,bVldVlrReal)
	oStruct:setProperty( 'C6_ZZOBSL'	,MODEL_FIELD_VALID ,bVldObserv)
	oStruct:setProperty( 'MARK' 		,MODEL_FIELD_VALID ,bMark)

	oModel:SetCommit({|oModel| myCommit(oModel)})
return oModel

static function modifyView(oView)
	local aView      := oView:GetViewObj(cIDView)
	local oGrid      := aView[3]
	local oStruct    := oGrid:getStruct()
	local nTamDesc   := 250
	local nTamCli    := 190
	local nTamNum    := 110
	local nTamDt     := 80
	local nTamPedido := 80
	local bDoubleClick := {|oFormulario,cFieldName,nLineGrid,nLineModel| doubleClick(cFieldName)}
	local bChangeLine  := {|oView, cViewID| ChangeLine(oView, cViewID) }
	local iTempo      := superGetMv("ZZ_RESCRM",.F.,5000)
	oView:SetViewProperty("*", "ENABLENEWGRID")
	oView:SetViewProperty("*", "GRIDSEEK",{.t.})

	//oView:SetViewProperty("*", "GRIDFILTER",{.t.})
	//oView:SetContinuousForm(.t.)

	oStruct:setProperty( 'SITUACAO'     	,MVC_VIEW_WIDTH,nTamPedido)

	oStruct:setProperty( 'PEDIDO_ITEM'     	,MVC_VIEW_WIDTH,nTamPedido)

	oStruct:setProperty( 'DESC_PRODUTO'     ,MVC_VIEW_WIDTH,nTamDesc)
	oStruct:setProperty( 'C6_ZZOBSL'     	,MVC_VIEW_WIDTH,nTamCli)
	oStruct:setProperty( 'CLIENTE' 		    ,MVC_VIEW_WIDTH,nTamCli)

	oStruct:setProperty( 'C9_QTDLIB'	    ,MVC_VIEW_WIDTH,nTamNum)
	oStruct:setProperty( 'C9_ZZQTLIB'		,MVC_VIEW_WIDTH,nTamNum)
	oStruct:setProperty( 'VLR_PENDENTE'	    ,MVC_VIEW_WIDTH,nTamNum)
	// Adicionado por Felipe Silva.
	oStruct:setProperty( 'C6_ZZVLR'	    	,MVC_VIEW_WIDTH,nTamNum)
	oStruct:setProperty( 'SALDO'	        ,MVC_VIEW_WIDTH,nTamNum)
	oStruct:setProperty( 'QTD_LIB_ORIGINAL' ,MVC_VIEW_WIDTH,nTamNum)
	oStruct:setProperty( 'B2_QATU'          ,MVC_VIEW_WIDTH,nTamNum)
	// Adicionado por Felipe Silva.
	oStruct:setProperty( 'SALDO_PREVISTO'	,MVC_VIEW_WIDTH,nTamNum)
	oStruct:setProperty( 'C6_ZZVLR'       	,MVC_VIEW_WIDTH,nTamNum)

	oStruct:setProperty( 'C6_ENTREG'        ,MVC_VIEW_WIDTH,nTamDt)
	oStruct:setProperty( 'C5_EMISSAO'       ,MVC_VIEW_WIDTH,nTamDt)
	oStruct:setProperty( 'C6_ZZDTFAT'       ,MVC_VIEW_WIDTH,nTamDt)
	// Adicionado por Felipe Silva.
	oStruct:setProperty( 'C6_ZZDTRF'       	,MVC_VIEW_WIDTH,nTamDt)

	oStruct:setProperty( 'LEG'       		,MVC_VIEW_PICT,'@BMP')

	oStruct:setProperty( '*'	    		,MVC_VIEW_CANCHANGE,.F.)
	oStruct:setProperty( 'MARK'	    		,MVC_VIEW_CANCHANGE,.T.)
	oStruct:setProperty( 'CRM'	    		,MVC_VIEW_CANCHANGE,.T.)
	oStruct:setProperty( 'C9_QTDLIB'		,MVC_VIEW_CANCHANGE,.T.)
	oStruct:setProperty( 'C9_ZZQTLIB'		,MVC_VIEW_CANCHANGE,.T.)
	// Adicionados por Felipe Silva.
	oStruct:setProperty('C6_ZZDTRF',		MVC_VIEW_CANCHANGE, .T.)
	oStruct:setProperty('C6_ZZVLR',			MVC_VIEW_CANCHANGE, .T.)
	oStruct:setProperty('C6_ZZOBSL',		MVC_VIEW_CANCHANGE, .T.)
	oStruct:SetProperty("SALDO_PREVISTO",	MVC_VIEW_TITULO, "Estoque Previsto")

	oStruct:RemoveField("C5_ZZIFCPL")
	oStruct:RemoveField("C9_PRODUTO")
	oStruct:RemoveField("C9_PEDIDO")
	oStruct:RemoveField("C9_ITEM")
	oStruct:RemoveField("C9_BLEST")
	oStruct:RemoveField("C9_BLCRED")
	oStruct:RemoveField("C9RECNO")
	oStruct:RemoveField("C5RECNO")
	oStruct:RemoveField("C6RECNO")
	oStruct:RemoveField("C9_PRCVEN")
	oStruct:RemoveField("ZO2_QTDPRE")
	oStruct:RemoveField("B2_QATU")
	oStruct:RemoveField("LINHA")
	oStruct:RemoveField("C9_QTDLIB")
	oStruct:RemoveField("C9_ZZDTLIB")

	if isFinanceiro()
		oStruct:RemoveField("MARK")
	endif

	oView:AddOtherObject("RODAPE", {|oPanel,oView| rodape(oPanel,oView)})
	oView:CreateHorizontalBox( "RODAPE_BOX", 10 )
	oView:SetOwnerView( 'RODAPE',    "RODAPE_BOX")

	oView:SetAfterViewActivate({|oView|afterViewActivate(oView)})

	oView:SetViewProperty(cIDView,"GRIDDOUBLECLICK",{bDoubleClick})
	oView:SetViewProperty(cIDView,"CHANGELINE   ",{bChangeLine})
	if lFilProd
		oView:addUserButton("Zera Qtd Lib", "MAGIC_BMP"/*<cResource >*/, {|oView| zeraQtdLib(oView)}/*<bBloco >*/, "Zera a quantidade liberada do produto que estão acima da linha posicionada"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
	elseif isFaturamento()
		oView:addUserButton("Mensagem CRM", "MAGIC_BMP"/*<cResource >*/, {|oView| u_SOLFAT01(oView)}/*<bBloco >*/, "Envia Mensagem para o CRM"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		oView:addUserButton("Seq Lib Produto", "MAGIC_BMP"/*<cResource >*/, {|oView| u_SeqLibProd(oView)}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		oView:addUserButton("Filtro Cli/Prod", "MAGIC_BMP"/*<cResource >*/, {|oView| u_CadCliPVXSeqLib()}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		oView:addUserButton("Exportar Excel", "MAGIC_BMP"/*<cResource >*/, {|oView| FwMsgRun( ,{ || exportExcel() }, "SOLPACK", "Exportando Dados para o Excel..." )}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		//oView:addUserButton("Exportar Excel", "MAGIC_BMP"/*<cResource >*/, {|oView| FwMsgRun( ,{ || u_Exp2CargaMaquina() }, "SOLPACK", "Exportando Dados para o Excel..." )}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		oView:addUserButton("Visualiza Pedido", "MAGIC_BMP"/*<cResource >*/, {|oView| visualizaPedido(oView)}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		oView:addUserButton("F4 - Saldos em Estoque", "MAGIC_BMP"/*<cResource >*/, {|oView| saldosEmEstoque(oView)}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
		oView:addUserButton("Prep. Doc", "MAGIC_BMP"/*<cResource >*/, {|oView| prepDoc(oView)}/*<bBloco >*/, "Realiza a geração da NF para o Pedido posicionado"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
	elseif isFinanceiro()
		//oView:addUserButton("Lib. Estoque", "MAGIC_BMP"/*<cResource >*/, {|oView| libEstoque(oView)}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
	endif

	oView:addUserButton("F5 - Atualiza Tela", "MAGIC_BMP"/*<cResource >*/, {|oView| refreshScreen(oView)}/*<bBloco >*/, "Realiza a liberação de estoque para os pedidos selecionados"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)
	// Adicionado por Felipe Silva.
	oView:addUserButton("Atualiza Leg", "MAGIC_BMP"/*<cResource >*/, {|oView| updLegenda(oView)}/*<bBloco >*/, "Realiza a alteração das legendas amarelas ou pretas"/*[ cToolTip ]*/, /*nShortCut*/, /*[ aOptions ]*/, .t./*[lShowBar]*/)

	oView:showUpdateMsg(.f.)
	oView:showInsertMsg(.f.)
	oView:SetCloseOnOK({||lFilProd})
	oView:setTimer(iTempo,{|| u_solfat03()})
//	oTimer := TTimer():New(1, {|| alert('teste') }, oStruct )
return oView

user function vldQtdLib(cCampo)
	local lRet      := .t.
	local cProblema := ""
	local cSolucao  := ""

	default cCampo := "C9_QTDLIB"

	BEGIN SEQUENCE
		if !positivo()
			break
		endif

		if FwFldGet(cCampo) > FwFldGet("QTD_LIB_ORIGINAL")
			cProblema := "A quantidade digitada não pode ser maior que a quantidade orignal de liberação!"
			cSolucao := "Digite um valor menor ou igual a " + cValToChar(FwFldGet("QTD_LIB_ORIGINAL"))
			break
		endif

		if !u_SOFAT001(FwFldGet('C9_PRODUTO'),FwFldGet(cCampo))
			cProblema := "Quantidade múltipla do produto inválida"
			break
		endif

		u_grvVlrReal(.t.)
		u_updSeqQtdLib()
		u_RecalcSeqLibPed(FwIsInCallStack("ZERAQTDLIB")/*lAuto*/, cCampo)
		ChangeLine(FwViewActive())
		RECOVER
		lRet := .f.
		if !empty(cProblema)
			u_myHelp(cProblema,cSolucao)
		endif

	END SEQUENCE
return lRet

user function vldMark()
	local lRet      := .t.
	local lMark     := FwFldGet("MARK")
	local lHelp     := !FwIsInCallStack("MARKALL")
	local cProblema := ""
	local cSolucao  := ""

	BEGIN SEQUENCE

		if !lMark
			BREAK
		endif

		if !empty(FwFldGet("C9_BLCRED"))
			cProblema := "Pedido bloqueado por Crédito."
			BREAK
		endif

		if empty(FwFldGet("C9_BLEST")) .and. FwFldGet("C9_QTDLIB") == FwFldGet("QTD_LIB_ORIGINAL")
			cProblema := "Pedido já liberado por estoque."
			BREAK
		endif

		if FwFldGet("C9_QTDLIB") == 0 .and. !isLibCredEstoque()
			cProblema := "Não é possível marcar um pedido para liberação, cujo campo Qt. Liberada é igual a 0"
			BREAK
		endif

		if FwFldGet("C9_QTDLIB") > FwFldGet("QTD_LIB_ORIGINAL") .and. FwFldGet("SALDO") < 0
			cProblema := "Não há saldo para liberar o pedido"
			cSolucao := "Selecione um pedido cujo campo SALDO seja maior que 0"
			BREAK
		endif

		SC9->(dbGoTo(FwFldGet("C9RECNO")))

		posicione("SB2",1,xFilial("SB2")+SC9->(C9_PRODUTO+C9_LOCAL),"!EOf()")
		
		if FwFldGet("SALDO") < 0 .or. SB2->(saldoSB2()) - FwFldGet("C9_QTDLIB") < 0
			cProblema := "Não há saldo DISPONÍVEL no sistema para liberar o pedido"
			cSolucao := "Verifique o saldo reservado para o produto no sistema!"
			BREAK
		endif

		RECOVER
		lRet := empty(cProblema)
		if lHelp
			u_myHelp(cProblema,cSolucao)
		endif
	END SEQUENCE
return lRet

static function libEstoque(oView)
	fwMsgRun(, {|| runLibEstoque(oView)}, "LIB. ESTOQUE","Aguarde, realizando a liberação do estoque...")
return

static function runLibEstoque(oView)
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(cIDGrid)
	local nQtdLine := oGrid:Length()
	local nLine    := 0
	local lRet     := .t.
	local lLibOK   := .t.
	local lMark	   := .f.
	local aProd	   := {}
	local nProd    := 0

	for nLine := 1 to nQtdLine
		oGrid:goLine(nLine)

		if oGrid:isDeleted() .or. !oGrid:getValue("MARK")
			loop
		endif

		nPos := aScan(aProd,{|X|X[1] == oGrid:getValue("DESC_PRODUTO")})
		if nPos == 0
			aAdd(aProd,{oGrid:getValue("DESC_PRODUTO"),{{nLine,getPeso(oGrid:getValue("LEG"))}}})
		else
			aAdd(aProd[nPos,2],{nLine,getPeso(oGrid:getValue("LEG"))})
		endif
	next nLine

	for nProd := 1 to len(aProd)
		aLines := aProd[nProd,2]

		aSort(aLines,,, {|x,y| y[2] > x[2]})

		for nLine := 1 to len(aLines)
			oGrid:goLine(aLines[nLine,1])

			if oGrid:isDeleted() .or. !oGrid:getValue("MARK")
				loop
			endif
			lMark := .t.
			SC9->(dbGoTo(oGrid:getValue("C9RECNO")))

			//lLibOK := PVAuto():libEstoque(oGrid:getValue("C9_QTDLIB"))
			lLibOK := PVAuto():libEstoque(oGrid:getValue("C9_ZZQTLIB"))

			if !lLibOK
				lRet := .f.
			else
				isLibLocked(.t.)
			endif
		next nLine
	next nProd

	if !lMark
		lRet := .f.
		msgAlert("Não há pedidos marcados para realizar a liberação!")
	endif
return lRet

static function zeraQtdLib(oView)
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(cIDGrid)
	local aRows    := FwSaveRows()
	local cProduto := oGrid:getValue("C9_PRODUTO")
	local nLine    := 0
	local lRet     := .t.
	local nLineAnt := oGrid:GetLine()-1

	for nLine := nLineAnt to 1 step -1
		oGrid:goLine(nLine)

		if oGrid:isDeleted() .or. oGrid:getValue("MARK") .or. cProduto != oGrid:getValue("C9_PRODUTO") .or. !oGrid:CanSetValue("C9_QTDLIB")
			loop
		endif

		lRet := oGrid:setValue("C9_QTDLIB",0)
		lRet := oGrid:setValue("C9_ZZQTLIB",0)
	next nLine

	FwRestRows(aRows)
	oView:refresh(cIDView)
return lRet

static function fake()
	libEstoque()
	u_vldQtdLib()
	fake()
return

static function doubleClick(cFieldName)
	local aLegenda := {}
	if cFieldName == "LEG"

		aadd(aLegenda, {'ENABLE'    , "Item Liberado"})
		aadd(aLegenda, {'DISABLE'   , "Item Faturado"})
		aadd(aLegenda, {'BR_AZUL'   , "Item Bloqueado - Credito"})
		aadd(aLegenda, {'BR_MARROM' , "Item Rejeitado"})
		aadd(aLegenda, {'BR_PRETO'  , "Item Bloqueado - Estoque"})
		aadd(aLegenda, {'BR_AMARELO', "Pedido Previsto para o Mês"})
		aadd(aLegenda, {'BR_LARANJA', "Item Bloqueado - TMS"})

		BrwLegenda("Legenda", "STR0049", aLegenda)
		return .f.
	elseif cFIeldName <> 'MARK'
		FwFldPut('MARK',!FwFldGet('MARK'),/*nLinha*/,/*oModel*/,.t./*lShowMsg*/,.f./*lLoad*/)
	endif
return .t.

static function refreshScreen(oView,lAuto)
	default oView := FwViewActive()
	default lAuto := .f.

	if lAuto .or. msgNoYes("Deseja realmente atualizar a tela? Todos os serão perdidos.")
		fwMsgRun(, {|| runRefreshScreen(oView)}, "ATUALIZA TELA","Aguarde, atualizando os dados da tela...")
	endif
return

static function runRefreshScreen(oView)
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(cIDGrid)
	local oUtilMVC := IPUtilMVC():New()
	local cQuery   := getQuery()

	oUtilMVC:addLineGrid(cQuery,oGrid,.t./*lLoadValue*/,.t./*lClearGrid*/,.f./*lInit*/,.t./*lBlankLine*/)
return

static function ChangeLine(oView, cViewID)
	local lRet := .t.
	local oGrid := oView:getModel(cIDGrid)

	nSaldoAtual := u_RecalcSaldoAtual(oGrid, "C9_ZZQTLIB")
	cSaldoAtual := "Saldo Estoque: " + alltrim(transform(nSaldoAtual,getSX3Cache("B2_QATU","X3_PICTURE")))

	cObsPedido := FwFldGet("C5_ZZIFCPL")

	oSaySaldo:refresh()
	oObsPedido:refresh()
	oPanelRodape:refresh()
return lRet

static function rodape(oPanel,oView)
	Local oFont18 := TFont():New("MS Sans Serif",,026,,.F.,,,,,.F.,.F.)
	local nLinha := oPanel:nTop + 10

	oPanelRodape    := TPanel():New( 0,0,"",oPanel,,.F.,.F.,,,0,0,.F.,.F. )
	oPanelRodape:align := CONTROL_ALIGN_ALLCLIENT

	@ nLinha, 008 SAY oSaySaldo VAR cSaldoAtual SIZE 180, 012 OF oPanel FONT oFont18 COLORS 0, 16777215 PIXEL

	@ nLinha, 150 SAY oSayObs VAR "Obs. PV:" SIZE 180, 012 OF oPanel FONT oFont18 COLORS 0, 16777215 PIXEL
	@ nLinha, 200 GET oObsPedido VAR cObsPedido OF oPanel MULTILINE SIZE 190, 020 COLORS 0, 16777215 READONLY HSCROLL PIXEL
return

static function afterViewActivate(oView)
	if !empty(nRecnoC9)
		oModel := oView:getModel()
		oGrid  := oModel:getModel(cIDGrid)
		aBusca := {}
		aAdd(aBusca,{"C9RECNO",nRecnoC9})

		if !oGrid:SeekLine(aBusca)
			oGrid:goLine(1)
		endif

		oView:refresh()
	endif
	ChangeLine(oView)
return

