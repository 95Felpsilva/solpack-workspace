	aadd(aParamBox, {2, "Apenas PV com Saldo"		 , "S"                                      , {"S=SIM","N=NAO"}, 50, ""   , .F.})// MV_PAR05
	// Adicionados por Felipe Silva.
	aAdd(aParamBox, {9,"Situação do Pedido",	150, 	7, 	.T.})			// MV_PAR06
	aAdd(aParamBox, {5, "Atrasado", 			.F., 	45,	"",	.F.})		// MV_PAR07
	aAdd(aParamBox, {5, "Imediato", 			.F., 	45,	"",	.F.})		// MV_PAR08
	aAdd(aParamBox, {5, "Previsto", 			.F., 	45,	"",	.F.})		// MV_PAR09
	aAdd(aParamBox, {5, "Programado", 			.F., 	45,	"",	.F.})		// MV_PAR10
	aAdd(aParamBox, {5, "Limpar Data R",			.F., 	45,	"",	.F.})		// MV_PAR11

	If ParamBox(aParamBox,"Filtros Relatório",,,,,,,,"SeqLibPed",.T.,.T.)
		lRet 				:= .t.

		dDataEntrega     	:= MV_PAR01
		dDataReal		 	:= MV_PAR02
		lListaProgramado	:= MV_PAR03 == "S"
		cTransportadora  	:= MV_PAR04
		lPositivo			:= MV_PAR05 == "S"
		lFilAtra			:= MV_PAR07
		lFilImed			:= MV_PAR08
		lFilPrev			:= MV_PAR09
		lFilProg			:= MV_PAR10
		lLimDat				:= MV_PAR11

		if lLimDat
			limpaDataReal()
		endif
	EndIf
return lRet

static function libCredito(oView)
	local cFunNameBKP := funname()
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(cIDGrid)

	SetFunName("MATA450")

	SC9->(dbGoTo(oGrid:getValue("C9RECNO")))
	A450LibMan()

	SetFunName(cFunNameBKP)
return

static function prepDoc(oView)
	oView:ButtonOkAction()
return

static function isFaturamento()
return nModulo == 5

static function isFinanceiro()
return nModulo == 6

static function isPrepDoc()
return isFaturamento() .and. FwIsInCallStack("PrepDoc")

static function geraNFSaida()
	local nRecnoC5    := FwFldGet("C5RECNO")
	local lRet        := 0
	local cFunNameBKP := funname()
	local aRows       := FwSaveRows()
	local nProxRecC9  := getProxRec()

	FwRestRows(aRows)

	nRecnoC9 := nProxRecC9
	if nRecnoC5 > 0
		DbSelectArea("SC5")
		SC5->(dbGoTo(nRecnoC5))
		setFunName("MATA410")
		MATA410(/*xAutoCab*/,/*xAutoItens*/,/*nOpcAuto*/,/*lSimulacao*/,"Ma410PvNfs"/*cRotina*/)
		SetFunName(cFunNameBKP)
		lRet := vldGeracaoNF()
	endif
return lRet

static function getProxRec()
	local oModel  := FwModelActive()
	local oGrid   := oModel:getModel(cIDGrid)
	local cPedido := oGrid:getValue("C9_PEDIDO")

	while cPedido == oGrid:getValue("C9_PEDIDO") .and. oGrid:getLine() < oGrid:length()

		oGrid:goLine(oGrid:getLine()+1)
	enddo

return oGrid:getValue("C9RECNO")

static function vldGeracaoNF()
	local cAlias := ""
	local lRet 	 := .t.
	local cMsg	 := CRLF

	cAlias := queryC9("'10'")

	if (cAlias)->(!eof())
		while (cAlias)->(!Eof())
			cMsg += "Pedido: <b>" + (cAlias)->(C9_PEDIDO) + "</b> Item: <b>" + (cAlias)->(C9_ITEM) + "</b> "
			cMsg += CRLF

			(cAlias)->(dbSkip())
		enddo
		lRet := .f.
	endif

	if !lRet
		cMsg += "não foi faturado"
		u_myhelp("Os itens listados não tem nota fiscal gerada " + cMsg )
	endif

	(cAlias)->(dbCloseArea())
return lRet

static function queryC9(cNotIn)
	local cQuery := ""
	local cAlias := ""
	default cNotIn := "'10','  '"

	cQuery += "SELECT" + CRLF
	cQuery += "	C9_PEDIDO," + CRLF
	cQuery += "	C9_ITEM," + CRLF
	cQuery += "	C9_BLCRED," + CRLF
	cQuery += "	C9_BLEST" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + retSqlTab("SC9") + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("SC9") + CRLF
	cQuery += "	AND C9_PEDIDO = '" + SC5->C5_NUM + "'" + CRLF
	cQuery += "	AND (C9_BLEST NOT IN (" + cNotIn + ")" + CRLF
	cQuery += "	OR C9_BLCRED NOT IN (" + cNotIn + "))" + CRLF
	cQuery += "	AND C9_NFISCAL  = ' '" + CRLF
	cQuery += "	AND " + retSqlDel("SC9") + CRLF

	TcQuery cQuery new Alias (cAlias := getNextAlias())
return cAlias

/*
	Adicionado por Felipe Silva.
	Função responsável por gravar os campos ZZ, que são editáveis no grid.
*/
static function grvCamposZZ(oView)
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(cIDGrid)
	local nQtdLine := oGrid:Length()
	local nLine    := 0

	for nLine := 1 to nQtdLine
		oGrid:goLine(nLine)

		if oGrid:isDeleted() .or. (Empty(oGrid:getValue("C6_ZZDTRF")) .and. Empty(oGrid:getValue("C6_ZZOBSL")))
			loop
		endif

		SC6->(dbGoTo(oGrid:getValue("C6RECNO")))
		RecLock("SC6", .f.)
			SC6->C6_ZZDTRF := oGrid:getValue("C6_ZZDTRF")
			SC6->C6_ZZOBSL := oGrid:getValue("C6_ZZOBSL")
		SC6->(MsUnlock())
	next nLine
return

/*
	Adicionado por Felipe Silva.
	Função responsável por atualizar o campo de legenda na SC6 quando o usuário usar o botão Atualiza Leg.
*/
static function updLegenda(oView)
	local oModel   := oView:getModel()
	local oGrid    := oModel:getModel(cIDGrid)

	if !oGrid:isDeleted() .and. (AllTrim(oGrid:getValue("LEG")) == "BR_PRETO" .or. AllTrim(oGrid:getValue("LEG")) == "BR_AMARELO")
		SC6->(dbGoTo(oGrid:getValue("C6RECNO")))
		RecLock("SC6", .f.)
			if AllTrim(oGrid:getValue("LEG")) == "BR_AMARELO"
				SC6->C6_ZZLEG := "P"
				oGrid:setValue("LEG", "BR_PRETO")
			elseif AllTrim(oGrid:getValue("LEG")) == "BR_PRETO"
				SC6->C6_ZZLEG := "A"
				oGrid:setValue("LEG", "BR_AMARELO")
			endif
		SC6->(MsUnlock())

		if MsgYesNo("Deseja zerar a quantidade liberada?")
			zeraQtdLib(oView)
		endif
	endif
return

user function grvDataReal()
	local lRet		:= .t.
	local oModel    := FwModelActive()
	local oGrid     := oModel:getModel("MODEL_GRID")

	SC6->(dbGoTo(oGrid:getValue("C6RECNO")))

	if !oGrid:isDeleted() .and. (!Empty(oGrid:getValue("C6_ZZDTRF")) .OR. !Empty(SC6->C6_ZZDTRF))
		RecLock("SC6", .f.)
			SC6->C6_ZZDTRF := oGrid:getValue("C6_ZZDTRF")
		SC6->(MsUnlock())
	endif
return lRet

user function grvVlrReal(lCpoQtd)
	local lRet		:= .t.
	local oModel    := FwModelActive()
	local oGrid     := oModel:getModel("MODEL_GRID")

	default lCpoQtd := .f.

	SC6->(dbGoTo(oGrid:getValue("C6RECNO")))

	if !oGrid:isDeleted()
		RecLock("SC6", .f.)
			SC6->C6_ZZVLR := iif(lCpoQtd, 0, -1)
		SC6->(MsUnlock())
	endif
return lRet

user function grvObserv(lCpoQtd)
	local lRet		:= .t.
	local oModel    := FwModelActive()
	local oGrid     := oModel:getModel("MODEL_GRID")

	default lCpoQtd := .f.

	SC6->(dbGoTo(oGrid:getValue("C6RECNO")))

	if !oGrid:isDeleted() .and. (!Empty(oGrid:getValue("C6_ZZOBSL")) .OR. !Empty(SC6->C6_ZZOBSL))
		RecLock("SC6", .f.)
			SC6->C6_ZZOBSL := oGrid:getValue("C6_ZZOBSL")
		SC6->(MsUnlock())
	endif
return lRet

/*
Função responsável por atualizar campos personalizados:
	- C9_ZZQTLIB;
	- C9_ZZDTLIB;
São campos que irão tratar da quantidade liberada antes da efetivação no Protheus, tanto para
	a tela de Sequenciamento de Pedido de Vendas, quanto para relatório de BI.
*/
user function updSeqQtdLib(cQuery)
	local cAlias	:= ""
	local oModel    := nil
	local oGrid     := nil

	default cQuery 	:= ""

	if !Empty(cQuery)
		TcQuery cQuery new alias (cAlias := GetNextAlias())

		while (cAlias)->(!Eof())
			if Empty((cAlias)->C9_ZZDTLIB) .and. (cAlias)->C9_ZZQTLIB <> (cAlias)->C9_QTDLIB
				SC9->(DbGoTo((cAlias)->C9RECNO))

				RecLock("SC9", .f.)
					SC9->C9_ZZQTLIB := (cAlias)->C9_QTDLIB
				SC9->(MsUnlock())
			endif

			(cAlias)->(DbSkip())
		enddo

		(cAlias)->(DbCloseArea())
	else
		oModel	:= FwModelActive()
		oGrid	:= oModel:GetModel("MODEL_GRID")

		SC9->(DbGoTo(oGrid:GetValue("C9RECNO")))

		if !oGrid:IsDeleted() .and. (!Empty(oGrid:GetValue("C9_ZZQTLIB")) .OR. !Empty(SC9->C9_ZZQTLIB))
			RecLock("SC9", .f.)
				SC9->C9_ZZQTLIB := oGrid:GetValue("C9_ZZQTLIB")
				SC9->C9_ZZDTLIB := dDataBase
			SC9->(MsUnlock())
		endif
	endif
return

static function updMarkReg(oView)
	local oModel   	:= oView:getModel()
	local oGrid    	:= oModel:getModel(cIDGrid)
	local nQtdLine 	:= oGrid:Length()
	local nLine		:= 0

	for nLine := 1 to nQtdLine
		if oGrid:IsDeleted() .or. !oGrid:GetValue("MARK")
			loop
		endif

		SC9->(DbGoTo(oGrid:GetValue("C9RECNO")))

		RecLock("SC9", .f.)
			SC9->C9_ZZDTLIB := CToD("")
		SC9->(MsUnlock())
	next nLine
return

user function limpaData(cQuery)
	local cAlias	:= ""
	local cMesAtu	:= Month(dDataBase)
	local cAuxMes	:= ""

	default cQuery 	:= ""

	if !Empty(cQuery)
		TcQuery cQuery new alias (cAlias := GetNextAlias())

		while (cAlias)->(!Eof())
			cAuxMes := Month(SToD((cAlias)->C9_ZZDTLIB))

			if !Empty((cAlias)->C9_ZZDTLIB) .and. cAuxMes <> cMesAtu
				SC9->(DbGoTo((cAlias)->C9RECNO))

				RecLock("SC9", .f.)
					SC9->C9_ZZDTLIB := CToD("")
				SC9->(MsUnlock())
			endif

			(cAlias)->(DbSkip())
		enddo

		(cAlias)->(DbCloseArea())
	endif
return

/*
	Função responsável por limpar o campo 'Data Real' [C6_ZZDTRF], quando o saldo previsto estiver negativo
*/
static function limpaDataReal()
	local lLimpa 	:= .t.
	local lFilAll	:= .t.
	local lBkpProd	:= lFilProd
	local lBkpFil	:= lShowFiltro
	local lBkpPos	:= lPositivo
	local cQryAli	:= ""
	local cAlias	:= ""

	if !MsgYesNo("Deseja limpar o campo 'Dt Real Lib'?")
		return
	endif

	lFilProd 	:= .f.
	lShowFiltro	:= .f.
	lPositivo	:= .f.

	cQryAli := getQuery(lLimpa, lFilAll)

	TcQuery cQryAli new alias (cAlias := GetNextAlias())

	while (cAlias)->(!Eof())
		if (cAlias)->SALDO_PREVISTO < 0
			SC6->(DbGoTo((cAlias)->C6RECNO))

			RecLock("SC6", .f.)
				SC6->C6_ZZDTRF := CToD("")
			SC6->(MsUnlock())
		endif

		(cAlias)->(DbSkip())
	enddo

	(cAlias)->(DbCloseArea())

	lFilProd 	:= lBkpProd
	lShowFiltro	:= lBkpFil
	lPositivo	:= lBkpPos
return

static function imp100()
	local nI := 0

	for nI := 1 to 101
		exportExcel()
	next nI
return
