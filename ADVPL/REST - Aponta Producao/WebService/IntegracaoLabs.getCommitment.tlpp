#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace IntegracaoLabs

/*/{Protheus.doc} getCommitment

Retorna lista de empenhos da ordem de produção

@type function
@author Gabriel Pereira - CRM Services
@since 12/12/2022
@version P12
@database ORACLE

@param [oClassRestFul], object, Objeto da Classe RESTFUL recebido do fonte com a definição das API's
@param [oRest], object, Objeto da Classe Rest do TLPP recebido do fonte com a definição das API's

@return logical, lRet - Indica se foi processado com sucesso
/*/ 
User Function getCommitment(oClassRestFul as object, oRest as object) as character	
	Local cJsonResponse			:= "" as character
	Local cQueryHeader			:= "" as character
	Local nStatusCode			:= 0 as numeric
    Local lUseTmpTable			:= .F. as logical
    Local lRetExecuteAPIREST	:= .T. as logical

	Private oFwAdapterBaseV2	:= NIL as object
	Private cWhere		 		:= "" as character 
	Private cFilter		 		:= "" as character 
	Private nPage				:= 1 as numeric 
	Private nPageSize		 	:= 1 as numeric 
	Private aQueryString 	 	:= {} as array 

	oFwAdapterBaseV2 	:= FwAdapterBaseV2():New("GET")

	getParamResquest()
    oFwAdapterBaseV2:setPage(nPage)
    oFwAdapterBaseV2:setPageSize(nPageSize)

	createMapaCampos()
	cQueryHeader := getQryCommitment()

	oFwAdapterBaseV2:SetQuery(cQueryHeader)
	oFwAdapterBaseV2:SetWhere(cWhere)
	oFwAdapterBaseV2:SetOrder("D4_COD")
	If ( Len(aQueryString) > 0 )
		oFwAdapterBaseV2:SetUrlFilter(aQueryString)
	EndIf

	lRetExecuteAPIREST := oFwAdapterBaseV2:Execute(lUseTmpTable)

	If ( lRetExecuteAPIREST )
		oFwAdapterBaseV2:FillGetResponse()
		cJsonResponse 		:= oFwAdapterBaseV2:GetJSONResponse()
		nStatusCode 		:= oFwAdapterBaseV2:GetCode()
	Else
		cJsonResponse 		:= AllTrim(oFwAdapterBaseV2:cMessage)
		nStatusCode 		:= oFwAdapterBaseV2:GetCode()
	EndIf

	freeObj(oFwAdapterBaseV2)

	oRest:setKeyHeaderResponse("Content-Type", "Application/Json;charset=utf-8")
	oRest:setResponse(cJsonResponse)					
	oRest:setStatusCode(nStatusCode)

Return cJsonResponse

/*
	Cria mapa de campos a ser retornado na API
*/
Static Function createMapaCampos() as variant
	oFwAdapterBaseV2:AddMapFields("productCode"			, "D4_COD", .T., .T., { "D4_COD", "C", tgv.util.GetFieldLength("D4_COD"), 0 } )
    oFwAdapterBaseV2:AddMapFields("description"			, "B1_DESC", .T., .F., { "B1_DESC", "C", tgv.util.GetFieldLength("B1_DESC"), 0 } )
    oFwAdapterBaseV2:AddMapFields("unitOfMeasure"		, "B1_UM", .T., .F., { "B1_UM", "C", tgv.util.GetFieldLength("B1_UM"), 0 } )
    oFwAdapterBaseV2:AddMapFields("location"			, "D4_LOCAL", .T., .F., { "D4_LOCAL", "C", tgv.util.GetFieldLength("D4_LOCAL"), 0 } )
    oFwAdapterBaseV2:AddMapFields("productionOrder"		, "D4_OP", .T., .F., { "D4_OP", "C", tgv.util.GetFieldLength("D4_OP"), 0 } )
    oFwAdapterBaseV2:AddMapFields("date"				, "D4_DATA", .T., .F., { "D4_DATA", "D", tgv.util.GetFieldLength("D4_DATA"), 0 } )
    oFwAdapterBaseV2:AddMapFields("originalQuantity"	, "D4_QTDEORI", .T., .F., { "D4_QTDEORI", "N", tgv.util.GetFieldLength("D4_QTDEORI"), 0 } )
    oFwAdapterBaseV2:AddMapFields("quantityNoted"		, "APONTADO", .T., .F., { "APONTADO", "N", tgv.util.GetFieldLength("D4_SALDO"), 0 } )
    oFwAdapterBaseV2:AddMapFields("lot"					, "D4_LOTECTL", .T., .F., { "D4_LOTECTL", "C", tgv.util.GetFieldLength("D4_LOTECTL"), 0 } )    
Return

/*
	Cria query de executação da API
*/
Static Function getQryCommitment() as character
	Local cQuery	:= "" as character

	cQuery += "	SELECT " + CRLF
	cQuery += "		D4_COD " + CRLF
	cQuery += "		,B1_DESC " + CRLF
	cQuery += "		,B1_UM " + CRLF
	cQuery += "		,D4_LOCAL " + CRLF
	cQuery += "		,D4_OP " + CRLF
	cQuery += "		,D4_DATA " + CRLF
	cQuery += "		,D4_QTDEORI " + CRLF
	cQuery += "		,COALESCE(TOTAL, 0) APONTADO" + CRLF
	cQuery += "		,D4_LOTECTL " + CRLF
	cQuery += "	FROM " + CRLF
	cQuery += "		" + RetSqlTab("SD4") + CRLF
	cQuery += "		INNER JOIN " + RetSqlTab("SB1") + " ON 1 = 1 " + CRLF
	cQuery += "			AND" + RetSqlFil("SB1") + CRLF
	cQuery += "			AND B1_GRUPO = '4010' " + CRLF
	cQuery += "			AND B1_COD = D4_COD " + CRLF
	cQuery += "			AND" + RetSqlDel("SB1") + CRLF

	cQuery += "		LEFT JOIN ( " + CRLF
	cQuery += "			SELECT " + CRLF
	cQuery += "				D3_FILIAL " + CRLF
	cQuery += "				,D3_OP " + CRLF
	cQuery += "				,D3_COD " + CRLF
	cQuery += "				,D3_LOTECTL " + CRLF
	cQuery += "				,SUM(D3_QUANT) TOTAL " + CRLF
	cQuery += "			FROM " + CRLF
	cQuery += "				" + RetSqlTab("SD3") + CRLF
	cQuery += "			WHERE " + CRLF
	cQuery += "				1 = 1 " + CRLF
	cQuery += "				AND D3_TM BETWEEN '500' AND '599'" + CRLF
	cQuery += "				AND" + RetSqlDel("SD3") + CRLF
	cQuery += "			GROUP BY " + CRLF
	cQuery += "				D3_FILIAL " + CRLF
	cQuery += "				,D3_OP " + CRLF
	cQuery += "				,D3_COD " + CRLF
	cQuery += "				,D3_LOTECTL " + CRLF
	cQuery += "		) SUBSD3 ON 1 = 1 " + CRLF
	cQuery += "			AND D3_FILIAL = D4_FILIAL		 " + CRLF
	cQuery += "			AND D3_OP = D4_OP " + CRLF
	cQuery += "			AND D3_COD = D4_COD " + CRLF

	cQuery += "	WHERE " + CRLF
	cQuery += "		1 = 1 " + CRLF
	cQuery += "		AND" + RetSqlDel("SD4") + CRLF

	cQuery := "SELECT #QueryFields# FROM (" + cQuery + ") SUBQRYREST WHERE 1 = 1 AND #QueryWhere#"
Return cQuery

/*
	Rotina para recuperar parâmetros enviados
*/
Static Function getParamResquest()
	Local aParams	:= {} as array
	Local cParam	:= "" as character
	Local cContent	:= "" as character
	Local nParam	:= 1 as numeric

	nPage := oRest:getQueryRequest()["Page"]

	If ( Empty(nPage) )
		nPage := 1
	Endif
	If ( ValType(nPage) == "C" )
		nPage := Val(nPage)
	Endif

	nPageSize := oRest:getQueryRequest()["PageSize"]
	
	If ( Empty(nPageSize) )
		nPageSize := 50
	Endif
	If ( ValType(nPageSize) == "C" )
		nPageSize := Val(nPageSize)
	Endif
	
	cWhere := oRest:getQueryRequest()["Where"]
	If ( Empty(cWhere) )
		cWhere := "1 = 1"
	Endif
	
	aParams := oRest:getQueryRequest():GetNames()

	If ( Len(aParams) > 0 )
		For nParam:=1 To Len(aParams)
			cParam 	:= aParams[nParam]
			cContent:= oRest:getQueryRequest()[cParam]

			If ( !Empty(cParam) .And. !( Upper(AllTrim(cParam)) $ "PAGESIZE,PAGE,WHERE" ) )
				aAdd(aQueryString, {cParam, cContent})
			EndIf
		Next nParam
	EndIf 
Return
