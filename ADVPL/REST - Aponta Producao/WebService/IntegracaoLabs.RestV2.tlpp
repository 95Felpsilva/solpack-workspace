#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

#define HTTP_BAD_REQUEST            400

namespace IntegracaoLabs

/*/{Protheus.doc} FlowIntegration

Função genérica para concentrar endpoint relacionados a integração com Labs da CRM

@type class
@author Gabriel Pereira - CRM Services
@since 04/05/2022
@version P12
@database Oracle
/*/
User Function IntegracaoLabs()
	Local lRet := AlwaysTrue()

Return lRet

/*/{protheus.doc} apiGetProducts

Método GET retornando dados de produtos
Usando REST Versão 2.0 com Annotation

@type method
@author Gabriel Pereira
@since 23/06/2022
@version P12
@database MSSQL

@return logical, lRet - Indica se o processo retornou com sucesso
/*/
@GET(endpoint="/IntegracaoLabs/api/v2/products",description="Retorna dados de Produtos")
User Function apiGetProducts() as logical
    Local cMsg  	:= "" as character
    Local lRet  	:= .T. as logical
	
	If ( FindFunction("IntegracaoLabs.u_getProducts") )
		lRet := IntegracaoLabs.u_getProducts(,@oRest)
	Else
		cMsg := "Função TLPP 'IntegracaoLabs.u_getProducts' não encontrada no RPO."
		libLabs.u_sendMsgFault(oRest,cMsg, HTTP_BAD_REQUEST)
	Endif

Return .T.

