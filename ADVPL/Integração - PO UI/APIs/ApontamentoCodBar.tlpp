#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'tlpp-rest.th'

/*/{Protheus.doc} ApontamentoCodBar
Rest Fluxo de Caixa
@type class
@version 12.1.2410
@author Felipe Silva.
@since 10/07/2025
/*/
class ApontamentoCodBar
	public method new()
	public method ValidaIdent() as character
	public method VerifExiste() as logical
	public method GetDadosOP() as character
	public method VldApontamento() as logical
	public method GetInfoEtiqueta() as character

	@Get("/solpack/verifica-codbar/:codbar")
	public method VerificaCodigoBarras() as logical

    @Post("/solpack/apontamento-codbar")
	public method ApontaCodBar() as logical
endclass

/*/{Protheus.doc} ApontamentoCodBar::new
MÃ©todo construtor da classe
@type method
@version 12.1.2410
@author Felipe Silva
@since 10/07/2025
@return object, retorna a instancia da classe
/*/
method new() class ApontamentoCodBar
return self

/*/{Protheus.doc} ApiFluxoDeCaixa::fluxoDeCaixa
API Fluxo de caixa drill down
@type method
@version 12.1.2410
@author Felipe Silva.
@since 17/06/2025
@return logical, true se a consulta ocorreu com sucesso e false se houve erro
/*/
method VerificaCodigoBarras() as logical class ApontamentoCodBar
    local jParams 	:= oRest:getPathParamsRequest()
	local jResponse	:= JSonObject():New()
    local jAux      := JSonObject():New()
    local cCodBar   := jParams['codbar']
    local cIdent    := Right(cCodBar, GetSX3Cache("H6_IDENT", "X3_TAMANHO"))
	local cOP       := SubStr(cCodBar, 1, Len(cCodBar) - Len(cIdent))
	local cAlias    := ::ValidaIdent(cOP, cIdent)
    local aItems    := {}
    local lRet      := .t.
    local lExiste   := ::VerifExiste(cOP, cIdent)

    if (cAlias)->(!Eof())
        jAux			    := JSonObject():New()
	    jAux['OP']	        := AllTrim((cAlias)->H6_OP)
	    jAux['PRODUTO']	    := AllTrim((cAlias)->B1_COD)
	    jAux['DESCRICAO']   := AllTrim((cAlias)->B1_DESC)
	    jAux['UNIDADE']	    := AllTrim((cAlias)->B1_UM)

        aAdd(aItems, jAux)
    else
        lRet := .f.
    endif

    jResponse["items"] 		:= aItems
    jResponse["lexiste"]    := lExiste
    jResponse["result"]	    := lRet

	oRest:SetResponse(jResponse:ToJson())

    (cAlias)->(DbCloseArea())
return .t.

method VerifExiste(cOP, cIdent) as logical class ApontamentoCodBar
	local cAlias 	:= ""
	local cQuery 	:= ""
    local lRet      := .f.

	cQuery += "SELECT" + CRLF
    cQuery += "    SH6.H6_OP" + CRLF

    cQuery += "FROM " + RetSqlTab("SH6") + "" + CRLF

    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND SH6.H6_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
    cQuery += "    AND SH6.H6_OP = '" + cOP + "'" + CRLF
    cQuery += "    AND SH6.H6_ZZIDENT = '" + cIdent + "'" + CRLF
    cQuery += "    AND SH6.H6_OPERAC = '02'" + CRLF
    cQuery += "    AND SH6.D_E_L_E_T_ = ' '" + CRLF

	oExec := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()

    if (cAlias)->(!Eof())
        lRet := .t.
    endif

    (cAlias)->(DbCloseArea())
return lRet

method ValidaIdent(cOP, cIdent) as character class ApontamentoCodBar
	local cAlias 	:= ""
	local cQuery 	:= ""

	cQuery += "SELECT" + CRLF
    cQuery += "    SH6.H6_OP," + CRLF
    cQuery += "    SB1.B1_DESC," + CRLF
    cQuery += "    SB1.B1_COD," + CRLF
    cQuery += "    SB1.B1_UM" + CRLF

    cQuery += "FROM " + RetSqlTab("SH6") + "" + CRLF

    cQuery += "INNER JOIN " + RetSqlTab("SC2") + "" + CRLF
    cQuery += "    ON 1 = 1" + CRLF
    cQuery += "    AND SC2.C2_FILIAL = H6_FILIAL" + CRLF
    cQuery += "    AND SC2.C2_NUM + C2_ITEM + C2_SEQUEN + C2_GRADE = H6_OP" + CRLF
    cQuery += "    AND SC2.D_E_L_E_T_ = ' ' " + CRLF

    cQuery += "INNER JOIN " + RetSqlTab("SB1") + "" + CRLF
    cQuery += "    ON 1 = 1" + CRLF
    cQuery += "    AND SB1.B1_FILIAL = '" + FWxFilial("SB1") + "'" + CRLF
    cQuery += "    AND SB1.B1_COD = C2_PRODUTO" + CRLF
    cQuery += "    AND SB1.D_E_L_E_T_ = ' '" + CRLF

    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND SH6.H6_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
    cQuery += "    AND SH6.H6_OP = '" + cOP + "'" + CRLF
    cQuery += "    AND SH6.H6_IDENT = '" + cIdent + "'" + CRLF
    cQuery += "    AND SH6.D_E_L_E_T_ = ' '" + CRLF

	oExec := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()
return cAlias

method VldApontamento(cOP, cIdent) as logical class ApontamentoCodBar
    local lRet      := .t.
    local cAlias    := ""
    local cQuery    := ""

    cQuery += "SELECT" + CRLF
    cQuery += "    *" + CRLF

    cQuery += "FROM " + RetSqlTab("SH6") + "" + CRLF

    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND SH6.H6_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
    cQuery += "    AND SH6.H6_OP = '" + cOP + "'" + CRLF
    cQuery += "    AND SH6.H6_ZZIDENT = '" + cIdent + "'" + CRLF
    cQuery += "    AND SH6.D_E_L_E_T_ = ' '" + CRLF

    oExec := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()

    if (cAlias)->(!Eof())
        lRet := .f.
    endif

    (cAlias)->(DbCloseArea())
return lRet

method GetDadosOP(cOP, cIdent) as character class ApontamentoCodBar
	local cAlias 	:= ""
	local cQuery 	:= ""

	cQuery += "SELECT" + CRLF
    cQuery += "    TOP 1" + CRLF
    cQuery += "    LTRIM(RTRIM(H6_OP)) + H6_IDENT AS CODBAR," + CRLF
    cQuery += "    SG2.*," + CRLF
    cQuery += "    SH6.*," + CRLF
    cQuery += "    B1_DESC" + CRLF

    cQuery += "FROM " + RetSqlTab("SH6") + "" + CRLF

    cQuery += "INNER JOIN " + RetSqlTab("SC2") + "" + CRLF
    cQuery += "    ON 1 = 1" + CRLF
    cQuery += "    AND C2_FILIAL = H6_FILIAL" + CRLF
    cQuery += "    AND C2_NUM + C2_ITEM + C2_SEQUEN + C2_GRADE = H6_OP" + CRLF
    cQuery += "    AND  SC2.D_E_L_E_T_ = ' '" + CRLF

    cQuery += "INNER JOIN " + RetSqlTab("SB1") + "" + CRLF
    cQuery += "    ON 1 = 1" + CRLF
    cQuery += "    AND B1_FILIAL = '" + FWxFilial("SB1") + "'" + CRLF
    cQuery += "    AND B1_COD = C2_PRODUTO" + CRLF
    cQuery += "    AND SB1.D_E_L_E_T_ = ' '" + CRLF

    cQuery += "INNER JOIN " + RetSqlTab("SG2") + "" + CRLF
    cQuery += "    ON 1 = 1" + CRLF
    cQuery += "    AND G2_FILIAL = H6_FILIAL" + CRLF
    cQuery += "    AND G2_PRODUTO = H6_PRODUTO" + CRLF
    cQuery += "    AND G2_CODIGO = C2_ROTEIRO" + CRLF
    cQuery += "    AND G2_OPERAC > H6_OPERAC" + CRLF
    cQuery += "    AND SG2.D_E_L_E_T_ = ' '" + CRLF

    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND H6_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
    cQuery += "    AND H6_OP = '" + cOP + "'" + CRLF
    cQuery += "    AND H6_IDENT = '" + cIdent + "'" + CRLF
    cQuery += "    AND SH6.D_E_L_E_T_ = ' '" + CRLF
    cQuery += "ORDER BY" + CRLF
    cQuery += "    H6_OP, G2_OPERAC" + CRLF

	oExec := FwExecStatement():New(ChangeQuery(cQuery))

	cAlias := oExec:OpenAlias()
return cAlias

method ApontaCodBar() as logical class ApontamentoCodBar
	local aArea 			:= GetArea()
	local aAreaSH6 			:= SH6->(GetArea())
	local cJson 			:= oRest:getBodyRequest()
	local jResponse			:= JSonObject():New()
	local oJSon				:= nil
	local cErro				:= ""
	//local lSaldo			:= .f.
	local cNumOP			:= ""
	local cCodPro			:= ""
	local cOperacao			:= ""
	local cCodRecurso		:= ""
	local cCodOperac		:= ""
	local dIniData			:= nil
	local cIniHora			:= ""
	local dFimData			:= nil
	local cFimHora			:= ""
	local nQtdPro			:= 0
	local nI				:= 0
	local aCabec			:= {}
	local aLog				:= {}
    local cCodBar           := ""
    local cIdent            := ""
	local cOP               := ""
    local cAlias            := ""

	private lMsErroAuto		:= .f.
	private cImpAPI			:= ""
	private lIsPAAPI		:= .t.
	private nQtdReAPI		:= 0
	private lMsHelpAuto     := .f.
	private lAutoErrNoFile	:= .t.

	oJSon := JSonObject():New()
	cErro := oJSon:FromJson(cJSON)

    cCodBar     := oJSon['ordem'][1]:GetJSonObject('ETIQUETA')
    cIdent      := Right(cCodBar, GetSX3Cache("H6_IDENT", "X3_TAMANHO"))
    cOP         := SubStr(cCodBar, 1, Len(cCodBar) - Len(cIdent))

    if !::VldApontamento(cOP, cIdent)
        jResponse["status"]		:= 400
		jResponse["menssage"]	:= "Ja existe apontamento CodBar para o Ident Pai: " + cIdent
    	jResponse["result"]		:= .f.

        oRest:SetResponse(jResponse:ToJson())

	    Restarea(aArea)
	    Restarea(aAreaSH6)

        return .t.
    endif

	if !Empty(cErro)
		jResponse["status"]		:= 400
		jResponse["menssage"]	:= "Erro na conversão do JSon: " + cErro
    	jResponse["result"]		:= .f.
	else
        cAlias      := ::GetDadosOP(cOP, cIdent)

        if (cAlias)->(Eof())
            jResponse["status"]		:= 400
            jResponse["menssage"]	:= "Erro ao localizar informações de apontamento da etiqueta: " + cCodBar
            jResponse["result"]		:= .f.
        else
            cNumOP   	:= (cAlias)->H6_OP
            cCodPro		:= (cAlias)->H6_PRODUTO
            cOperacao	:= "02"
            cCodRecurso	:= (cAlias)->H6_RECURSO
            cCodOperac 	:= oJSon['ordem'][1]:GetJSonObject('OPERADOR')
            dIniData	:= SToD((cAlias)->H6_DATAINI) //CToD(oJSon['ordem'][1]:GetJSonObject('DATA_INICIAL'))
		    cIniHora	:= (cAlias)->H6_HORAINI //GTFormatHour(oJSon['ordem'][1]:GetJSonObject('HORA_INICIAL'), "99:99")
		    cFimHora	:= (cAlias)->H6_HORAFIN //GTFormatHour(oJSon['ordem'][1]:GetJSonObject('HORA_FINAL'), "99:99")
		    //hHrTotal := oJSon:GetJSonObject('tempo_total')
		    dFimData	:= SToD((cAlias)->H6_DATAFIN) //CToD(oJSon['ordem'][1]:GetJSonObject('DATA_FINAL'))
            nQtdPro     := (cAlias)->H6_QTDPROD
            nPeso       := oJSon['ordem'][1]:GetJSonObject('PESO')

            DbSelectArea("SH6")
            DbSetOrder(1)       // ORDEM 1: H6_FILIAL+H6_OP+H6_PRODUTO+H6_OPERAC+H6_SEQ+DTOS(H6_DATAINI)+H6_HORAINI+DTOS(H6_DATAFIN)+H6_HORAFIN
            DbGotop()

            aAdd(aCabec, {"H6_FILIAL", 		FWxFilial('SH6'), 		            nil})
            aAdd(aCabec, {"H6_OP", 			cNumOP, 				            nil})
            aAdd(aCabec, {"H6_OPERAC", 		cOperacao,				            nil})
            aAdd(aCabec, {"H6_RECURSO", 	cCodRecurso,			            nil})
            aAdd(aCabec, {"H6_PRODUTO", 	cCodPro, 				            nil})
            aAdd(aCabec, {"H6_OPERADO", 	cCodOperac,				            nil})
            aAdd(aCabec, {"H6_DTAPONT", 	dDataBase, 				            nil})
            aAdd(aCabec, {"H6_DTPROD", 		dFimData, 				            nil})
            aAdd(aCabec, {"H6_DATAINI", 	dIniData, 				            nil})
            aAdd(aCabec, {"H6_HORAINI", 	cIniHora,                           nil})
            aAdd(aCabec, {"H6_DATAFIN", 	dFimData, 				            nil})
            aAdd(aCabec, {"H6_HORAFIN", 	cFimHora,                           nil})
            //aAdd(aCabec, {"H6_TEMPO",		hHrTotal, 				            nil})
            aAdd(aCabec, {"H6_QTDPROD", 	nQtdPro, 				            nil})
            //aAdd(aCabec, {"H6_QTDPERD", 	nQtdPer, 				            nil})
            aAdd(aCabec, {"H6_ZQTPRO2", 	nPeso, 				                nil})
            aAdd(aCabec, {"H6_OBSERVA", 	"APP PRODUCAO POUI",	            nil})
            aAdd(aCabec, {"H6_XUSER", 	    cCodOperac,	                        nil})
            aAdd(aCabec, {"H6_XDAPON", 	    dDataBase,	                        nil})
            aAdd(aCabec, {"H6_XHAPON", 	    Time(),	                            nil})
            aAdd(aCabec, {"H6_ZZIDENT", 	cIdent,	                            nil})

            //lSaldo := u_CONSALDO()

            //if lSaldo
            begin Transaction
                lMsErroAuto	:= .f.

                MsExecAuto({|x, y| MATA681(x, y)}, aCabec, 3)

                if lMsErroAuto
                    DisarmTransaction()
                    cErro := ""
                    aLog  := GetAutoGRLog()

                    for nI := 1 To Len(aLog)
                        if !Empty(cErro)
                            cErro += CRLF
                        endif

                        cErro += aLog[nI]
                    next nI

                    jResponse["status"]		:= 400
                    jResponse["menssage"]	:= "Erro na ExecAuto: " + cErro
                    jResponse["result"]		:= .f.
                else
                    jResponse["status"]		:= 200
                    jResponse["menssage"]	:= "Apontamento feito com sucesso! Identificador: '" + SH6->H6_OP + SH6->H6_IDENT + "'"
                    jResponse["result"]		:= .t.
                endif
            //else
            //	jResponse["status"]		:= 400
            //	jResponse["menssage"]	:= "Ordem de Produção não contem saldo!"
            //	jResponse["result"]		:= .f.
            //endif
            end Transaction
        endif
	endif

	oRest:SetResponse(jResponse:ToJson())

	Restarea(aArea)
	Restarea(aAreaSH6)
return .t.
