#include 'totvs.ch'
#include 'tlpp-core.th'
#include 'tlpp-rest.th'

/*/{Protheus.doc} DocsAcess
Rest retorna documentos
@type class
@version 12.1.2410
@author Felipe Silva.
@since 24/07/2025
/*/
class DocsAcess
	public method new()
	public method GetProdutos() as character
	public method GetTurnos() as character
	public method GetFiltrar() as character

	@Get("/solpack/lista-documentos/:documento")
	public method ListaDocumentos() as logical

    @Get("/solpack/abre-documento/:caminho")
	public method AbreDocumento() as logical
endclass

