#include 'totvs.ch'
#include 'topconn.ch'

/*/{Protheus.doc} UpdSG2Armazenar
Função responsável por voltar os registros deletados da [SG2] com campo [G2_DESCRI] igual a 'ARMAZENAR';
@type class
@version 12.1.2410
@author Felipe Silva.
@since 26/09/2025
/*/
user function UpdSG2Armazenar()
    local nRecSG2   := 0
    local cAlias    := ""
    local cLog      := ""
    local nCount    := 0

    OpenSm0(, .t.)
    RpcClearEnv()
    RpcSetEnv("01", "0101")

    cAlias  := GetRegistros()

    while (cAlias)->(!Eof())
        nRecSG2 := (cAlias)->RECSG2
        SG2->(DbGoTo(nRecSG2))

        cLog += "RECNO: " + cValToChar(nRecSG2) + CRLF
        nCount++

        RecLock("SG2", .f.)
            SG2->(DbRecall())
        SG2->(MsUnlock())

        (cAlias)->(DbSkip())
    enddo

    cLog += CRLF + CRLF
    cLog += "TOTAL DE REGISTROS: " + cValToChar(nCount) + CRLF

    MemoWrite("c:\temp\sg2_log.txt", cLog)

    (cAlias)->(DbCloseArea())
return

static function GetRegistros()
    local cAlias := ""
    local cQuery := ""

    cQuery += "SELECT" + CRLF
    cQuery += "    SG2.R_E_C_N_O_ AS RECSG2" + CRLF

    cQuery += "FROM " + RetSqlTab("SG2") + "" + CRLF

    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND SG2.G2_FILIAL = '" + FWxFilial("SG2") + "'" + CRLF
    cQuery += "    AND SG2.G2_DESCRI = 'ARMAZENAR           '" + CRLF
    cQuery += "    AND SG2.D_E_L_E_T_ <> ' '" + CRLF

    TcQuery cQuery new alias (cAlias := GetNextAlias())
return cAlias

static function Get2Registros()
    local cAlias := ""
    local cQuery := ""

    cQuery += "SELECT" + CRLF
    cQuery += "    *" + CRLF
    cQuery += "FROM (" + CRLF
    cQuery += "SELECT" + CRLF
    cQuery += "    SG2_01.*" + CRLF
    cQuery += "FROM " + RetSqlTab("SG2") + "" + CRLF
    cQuery += "OUTER APPLY (" + CRLF
    cQuery += "    SELECT" + CRLF
    cQuery += "        SG2_01.R_E_C_N_O_ AS RECSG2," + CRLF
    cQuery += "                SG2_01.G2_DESCRI" + CRLF
    cQuery += "    FROM " + RetSqlName("SG2") + " SG2_01" + CRLF
    cQuery += "    WHERE" + CRLF
    cQuery += "        1 = 1" + CRLF
    cQuery += "        AND SG2_01.G2_FILIAL = '" + FWxFilial("SG2") + "'" + CRLF
    cQuery += "        AND SG2_01.G2_PRODUTO = SG2.G2_PRODUTO" + CRLF
    cQuery += ") SG2_01" + CRLF
    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND SG2.G2_FILIAL = '" + FWxFilial("SG2") + "'" + CRLF
    cQuery += "    AND SG2.G2_DESCRI = 'TECER/EMBALAR'" + CRLF
    cQuery += "    AND SG2.D_E_L_E_T_ = ' '" + CRLF
    cQuery += ") X" + CRLF
    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND X.G2_DESCRI = 'ARMAZENAR'" + CRLF

    TcQuery cQuery new alias (cAlias := GetNextAlias())
return cAlias
