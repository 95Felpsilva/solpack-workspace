#include 'totvs.ch'
#include 'topconn.ch'

/*/{Protheus.doc} AppVldSaldo
Validação de Saldo Antes do Apontamento de um PA
@type class
@version 12.1.2410
@author Felipe Silva.
@since 10/07/2025
/*/
user function AppVldSaldo(cOP, cProduto, cOperac, nQtdProd)
    local lRet      := .f.
    local cAlias    := ""
    local cQuery    := ""

    cQuery += "SELECT" + CRLF
    cQuery += "    SC2.C2_NUM + SC2.C2_ITEM + SC2.C2_SEQUEN AS OP," + CRLF
    cQuery += "    SC2.C2_QUANT AS TOTAL_OP," + CRLF
    cQuery += "    COALESCE(SC2.C2_QUANT, 0) - COALESCE(SH6.H6_QTDPROD, 0) AS SALDO_A_PRODUZIR" + CRLF

    cQuery += "FROM " + RetSqlTab("SC2") + "" + CRLF

    cQuery += "OUTER APPLY (" + CRLF
    cQuery += "    SELECT" + CRLF
    cQuery += "        SUM(SH6.H6_QTDPROD) AS H6_QTDPROD" + CRLF
    cQuery += "    FROM " + RetSqlTab("SH6") + "" + CRLF
    cQuery += "    WHERE" + CRLF
    cQuery += "        1 = 1" + CRLF
    cQuery += "        AND SH6.H6_FILIAL = SC2.C2_FILIAL" + CRLF
    cQuery += "        AND SH6.H6_OP = SC2.C2_NUM + SC2.C2_ITEM + SC2.C2_SEQUEN" + CRLF
    cQuery += "        AND SH6.H6_OPERAC = '" + cOperac + "'" + CRLF
    cQuery += "        AND SH6.D_E_L_E_T_ = ' '" + CRLF
    cQuery += ") SH6" + CRLF

    cQuery += "WHERE" + CRLF
    cQuery += "    1 = 1" + CRLF
    cQuery += "    AND SC2.C2_FILIAL = '" + FWxFilial("SH6") + "'" + CRLF
    cQuery += "    AND SC2.C2_NUM + SC2.C2_ITEM + SC2.C2_SEQUEN = '" + cOP + "'" + CRLF
    cQuery += "    AND SC2.D_E_L_E_T_ = ' '" + CRLF

    TcQuery cQuery new alias (cAlias := GetNextAlias())

    if (cAlias)->(!Eof())
        if (cAlias)->SALDO_A_PRODUZIR >= nQtdProd
            lRet := .t.
        endif
    endif

    (cAlias)->(DbCloseArea())
return lRet
