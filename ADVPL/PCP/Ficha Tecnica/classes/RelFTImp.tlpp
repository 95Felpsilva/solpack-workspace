	////Largura
	//aTamanho[2] := oTImg:nClientWidth / n1CMXPixel
	//oTImg := nil
	//freeobj(oTImg)
Return aTamanho

method topMargin(cFicha) class RelFTImp
	local oFont20N := TFont():New("Times New Roman", 20, 20, , .T., , , , .T., .F.)
	local cLogo    := getNewPar("ZZ_LOGOFT","logo_ficha_tecnica.jpg")
	default cFicha := "RIUS"

	oPrint:box(1,1,4,20,,.f.)

	oPrint:sayBitMap(1.3/*nPosLine1*/,1.5/*nPosLine2*/,cLogo,7.5/*nPosCol1*/,2.5/*nPosCol2*/)
	oPrint:IPsay(1.5/*nLine*/,10/*nColumn*/,"FICHA TÉCNICA - " + cFicha,oFont20N,/*nAlign*/,/*lSumLine*/)
	oPrint:setLine(4,.t./*lConv*/)
return oPrint:getLineCM()

method queryRel(cIDs,cNMAB) class RelFTImp
	local cQuery  := ""
	local cAlias  := ""
	default cIDs  := ""
	default cNMAB := ""

	cQuery += "SELECT " + CRLF
	cQuery += " CZB_ZZTITU," + CRLF
	cQuery += " CZB_ZZLOCI," + CRLF
	cQuery += " CZB_TPAB," + CRLF
	cQuery += "	CZB_DSAB," + CRLF
	cQuery += "	CZB_UNMD," + CRLF
	cQuery += "	LTRIM(RTRIM(B1_COD)) + '   -   ' + B1_DESC AS TITDEFPROD," + CRLF
	cQuery += "	B1_COD," + CRLF
	cQuery += "	CONVERT(VARCHAR(8000),CONVERT(VARBINARY(8000),CZG_VLMEMO)) AS VLMEMO," + CRLF
	cQuery += "	CZG.*" + CRLF
	cQuery += "FROM" + CRLF
	cQuery += "	" + retSqlTab("CZG") + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + retSqlTab("CZD") + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("CZD") + CRLF
	cQuery += "	AND CZD_CDMD = CZG_CDMD" + CRLF
	cQuery += "	AND " + retSqlDel("CZD") + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + retSqlTab("CZE") + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("CZE") + CRLF
	cQuery += "	AND CZE_CDMD = CZG_CDMD" + CRLF
	cQuery += "	AND CZE_CDAB = CZG.CZG_CDAB" + CRLF
	cQuery += "	AND " + retSqlDel("CZE") + CRLF

	cQuery += "INNER JOIN" + CRLF
	cQuery += "	" + retSqlTab("CZB") + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("CZB") + CRLF
	cQuery += "	AND CZB_CDAB = CZG.CZG_CDAB" + CRLF
	if !empty(cNMAB)
		cQuery += "	AND CZB_NMAB LIKE '%" + alltrim(cNMAB) + "%'" + CRLF
	endif
	cQuery += "	AND " + retSqlDel("CZB") + CRLF

	cQuery += "LEFT JOIN" + CRLF
	cQuery += "	" + retSqlTab("SB1") + CRLF
	cQuery += "ON 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("SB1") + CRLF
	cQuery += "	AND B1_COD = CZG.CZG_CDAC" + CRLF
	cQuery += "	AND " + retSqlDel("SB1") + CRLF

	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND " + retSqlFil("CZG") + CRLF
    /*
    cQuery += "	AND CZG_CDAC = '30.20.01.02.05 '" + CRLF
    cQuery += "	AND CZG_CDMD = 'TST| '" + CRLF
    cQuery += "	AND CZG_VRFH = '00002'" + CRLF
    */
	if !empty(cIDs)
		cQuery += "	AND CZG_CDAB IN " + formatIN(cIDs,",") + CRLF
	endif

	cQuery += "	AND CZG_CDAC = '" + CZG->CZG_CDAC + "'" + CRLF
	cQuery += "	AND CZG_CDMD = '" + CZG->CZG_CDMD + "'" + CRLF
	cQuery += "	AND CZG_VRFH = '" + CZG->CZG_VRFH + "'" + CRLF

	cQuery += "	AND " + retSqlDel("CZG") + CRLF
	cQuery += "ORDER BY" + CRLF
	if !empty(cIDs)
		cQuery += "	CZG_CDAB " + CRLF
	else
		cQuery += "	CZB_ZZLOCI," + CRLF
		cQuery += "	CZB_ZZTITU," + CRLF
		cQuery += "	CZG_SQAB" + CRLF
	endif

	TcQuery cQuery new Alias (cAlias := getNextAlias())
return cAlias

static function addPage()
	nPageAtual++

	oPrint:endPage()
	oPrint:startPage()
	nLinAtual := 0
	nLinAtual += RelFTImp():topMargin()
	nLinAtual += 0.4
return nLinAtual

static function getTamanhoImgJS(cImagem)
	local jSize := ImageSize():run(cImagem)
	Local aTamanho 	:= {0, 0}
	local n1CMXPixel:= 37.7957517575025

	if jSize["status"]
		aTamanho[1] := jSize["heightPx"] / n1CMXPixel
		aTamanho[2] := jSize["widthPx"] / n1CMXPixel
	else
		u_myHelp(jSize["message"])
	endif

return aTamanho
