#include 'totvs.ch'
#include 'topconn.ch'

static ALINHADO_ESQUERDA    := 0
static ALINHADO_DIREITA     := 1
static CENTRALIZADO         := 2

static RGB_RED := RGB(255,0,0)
static RGB_BLUE:= rgb(91, 155, 213)
static DEF_PRODUTO := "1"
static CFG_MAQUINA := "2"
static IMAGENS     := "3"
static OBSERVACOES := "4"

class RelFTImp

	static method impDefProdutos()
	static method impDefObservacoes()
	static method impDefImagens()
	static method getTamanhoImg()
	static method topMargin()
	static method queryRel()
endclass

method impDefProdutos() class RelFTImp
	local oColAttr      := nil
	local oColResp      := nil
	local oColAttr1     := ColumnFwMsPrinter():new(/*nCMLargura*/,/*xString*/,oFont12N/*oFont*/,/*nAlign*/,/*oBrush*/,/*nColorText*/)
	local oColResp1     := ColumnFwMsPrinter():new(/*nCMLargura*/,/*xString*/,oFont12N/*oFont*/,CENTRALIZADO/*nAlign*/,/*oBrush*/,RGB_RED/*nColorText*/)
	local oColAttr2     := ColumnFwMsPrinter():new(/*nCMLargura*/,/*xString*/,oFont12N/*oFont*/,/*nAlign*/,/*oBrush*/,/*nColorText*/)
	local oColResp2     := ColumnFwMsPrinter():new(/*nCMLargura*/,/*xString*/,oFont12N/*oFont*/,CENTRALIZADO/*nAlign*/,/*oBrush*/,RGB_RED/*nColorText*/)
	local aLine         := {}
	local nDeArtigo     := 0
	local nAteArtigo    := 0
	local nQtdArtigo    := len(aDefProdutos)
	local nQtd2Artigo   := ceiLing(nQtdArtigo/2)
	local nQtdWhile     := if(nQtdArtigo > 1,2,1)
	local nArtigo       := 0
	local cTitulo       := ""
	local oPrintGrid    := nil
	local oColumn       := nil

	if nQtdArtigo > 0
		cTitulo := aDefProdutos[1,3]
		oPrintGrid := GridFwMsPrinter():new(0.6/*nTamBox*/,1/*nCMIniGrid*/,oPrint:getLineCM()+0.2/*nCMPageAtual*/,oPrint:getCMVertical()/*nLimPage*/,.t./*lImpCabec*/,{||addPage()}/*bNewPage*/,0.40/*nRecuoSayAlign*/)

		oColumn := ColumnFwMsPrinter():new(19,cTitulo,oFont12N,CENTRALIZADO/*nAlignHeader*/,/*oBlueBrush*/)
		oPrintGrid:addCell(oColumn)

		nLinAtual := oPrintGrid:print(oPrint,/*cPixel*/)

		oPrint:setLine(nLinAtual,.t./*lConv*/)
	endif

	oPrintGrid := GridFwMsPrinter():new(0.6/*nTamBox*/,1/*nCMIniGrid*/,oPrint:getLineCM()/*nCMPageAtual*/,oPrint:getCMVertical()/*nLimPage*/,.F./*lImpCabec*/,{||addPage()}/*bNewPage*/,0.40/*nRecuoSayAlign*/)

	oColumn := ColumnFwMsPrinter():new(4.85,"ATRIBUTO",oFont12N,CENTRALIZADO/*nAlignHeader*/,/*oBlueBrush*/)
	oPrintGrid:addCell(oColumn)

	oColumn := ColumnFwMsPrinter():new(4.65,"RESPOSTA",oFont12N,CENTRALIZADO/*nAlignHeader*/,/*oBlueBrush*/,RGB_RED)
	oPrintGrid:addCell(oColumn)

	oColumn := ColumnFwMsPrinter():new(4.75,"ATRIBUTO",oFont12N,CENTRALIZADO/*nAlignHeader*/,/*oBlueBrush*/)
	oPrintGrid:addCell(oColumn)

	oColumn := ColumnFwMsPrinter():new(4.75,"RESPOSTA",oFont12N,CENTRALIZADO/*nAlignHeader*/,/*oBlueBrush*/,RGB_RED)
	oPrintGrid:addCell(oColumn)

	while nQtdWhile > 0
		if nQtdWhile == 2
			oColAttr    := oColAttr1
			oColResp    := oColResp1
			nDeArtigo   := 1
			nAteArtigo  := nQtd2Artigo
		else
			oColAttr := oColAttr2
			oColResp := oColResp2
			nDeArtigo   := nQtd2Artigo + 1
			nAteArtigo  := nQtdArtigo
		endif

		for nArtigo := nDeArtigo to nAteArtigo
			oColAttr:addText(aDefProdutos[nArtigo][1],.t.)
			xString := aDefProdutos[nArtigo][2]
			if valType(xString) == "A"
				aEval(xString,{ |cString| oColResp:addText(alltrim(cString),.t.)})
			else
				oColResp:addText(alltrim(xString),.t.)
			endif

		next nArtigo

		nQtdWhile--
	enddo

	aAdd(aLine,oColAttr1)
	aAdd(aLine,oColResp1)
	aAdd(aLine,oColAttr2)
	aAdd(aLine,oColResp2)

	oPrintGrid:addLine(aLine)

	nLinAtual := oPrintGrid:print(oPrint,/*cPixel*/)

	oPrint:setLine(nLinAtual+0.2,.t./*lConv*/)
return

method impDefObservacoes(aObserv) class RelFTImp
	local oFont14  := TFont():New("Times New Roman",14,14,,.f.)
	local oFont14N := TFont():New("Times New Roman", 14, 14, , .T.)
	local nObs     := 0
	local nLine    := oPrint:getLineCM() + 0.2
	local aObs     := {}
	default aObserv := aObservacoes

	for nObs := 1 to len(aObserv)
		aObs    := aObserv[nObs][2]
		if len(aObs) == 1 .and. empty(aObs[1])
			loop
		endif
		oPCabec := GridFwMsPrinter():new(0.4/*nTamBox*/,1/*nCMIniGrid*/,nLine/*nCMPageAtual*/,oPrint:getCMVertical()/*nLimPage*/,.t./*lImpCabec*/,{||addPage()}/*bNewPage*/,0.40/*nRecuoSayAlign*/)

		oColumn := ColumnFwMsPrinter():new(19,"OBSERVAÇÕES",oFont14N,ALINHADO_ESQUERDA/*nAlignHeader*/,oBlueBrush)
		oPCabec:addCell(oColumn)

		oColumn := ColumnFwMsPrinter():new(19,aObs,oFont14,ALINHADO_ESQUERDA/*nAlignHeader*/,/*oBlueBrush*/)
		oPCabec:addLine({oColumn})
		nLine := oPCabec:print(oPrint,/*cPixel*/)
		oPrint:setLine(nLine,.t.)
	next nObs
return

method impDefImagens() class RelFTImp
	local nImagem        := 0
	local cFile          := "\RelFTImp"+FwTimeStamp()
	local cEntry         := ""
	local nImgAltura     := 0
	local nImgLargura    := 0
	local nCMIniGrid     := 1
	local nLenBox        := 0
	local aFiles         := {}
	local nLargRel       := 19
	local nLargTotal     := 0
	local nMaiorAltura   := 0
	local nPercentual    := 1
	
	oPrint:sumLine(0.2,.t.)

	for nImagem := 1 to len(aImagens)
		cTitulo := alltrim(aImagens[nImagem][1])
		cEntry  := aImagens[nImagem][2]
		cFile += "_" + cEntry + ".jpg"
		repExtract(cEntry ,cFile)

		aTamanho    := RelFTImp():getTamanhoImg(cFile,/*nAltura*/,19/*nLargRel*/,)
		//aTamanho 	:= ImageSizeNode(cFile)
		nImgAltura  := aTamanho[1] // * 0.90
		nImgLargura := aTamanho[2]
		nLargTotal += nImgLargura

		if nImgAltura > nMaiorAltura
			nMaiorAltura := nImgAltura
		endif
		aAdd(aFiles,{cFile,cTitulo,nImgAltura,nImgLargura})
	next nImagem

	//centraliza box
	if nLargTotal < nLargRel
		nCMColumn := 1 + ((nLargRel - nLargTotal) / 2)
		nCMIniGrid := nCMColumn -0.01
	endif

	for nImagem := 1 to len(aFiles)
		cFile       := aFiles[nImagem][1]
		cTitulo     := alltrim(aFiles[nImagem][2])
		nImgAltura  := aFiles[nImagem][3]
		nImgLargura := aFiles[nImagem][4]

		if nLargTotal > nLargRel
			nPercentual := nImgLargura / nLargTotal
			nImgLargura := nLargRel * nPercentual
		endif

		nLenBox     := nImgLargura

		if !oPrint:isPrint(nImgAltura+0.7)
			oPrint:setLine(addPage(),.t.)
		endif

		oPCabec := GridFwMsPrinter():new(0.6/*nTamBox*/,nCMIniGrid/*nCMIniGrid*/,oPrint:getLineCM()/*nCMPageAtual*/,oPrint:getCMVertical()/*nLimPage*/,.t./*lImpCabec*/,{||addPage()}/*bNewPage*/,0.40/*nRecuoSayAlign*/)
		oColumn := ColumnFwMsPrinter():new(nLenBox,cTitulo,oFont12N,CENTRALIZADO/*nAlignHeader*/,oBlueBrush/*oBlueBrush*/)
		oPCabec:addCell(oColumn)
		oPCabec:print(oPrint,/*cPixel*/)

		oPCabec := GridFwMsPrinter():new(nMaiorAltura/*nTamBox*/,nCMIniGrid/*nCMIniGrid*/,oPrint:getLineCM() + 0.6/*nCMPageAtual*/,oPrint:getCMVertical()/*nLimPage*/,.t./*lImpCabec*/,{||addPage()}/*bNewPage*/,0.40/*nRecuoSayAlign*/)
		oColumn := ColumnFwMsPrinter():new(nLenBox,cTitulo,oFont12N,CENTRALIZADO/*nAlignHeader*/,/*oBlueBrush*/)
		oPCabec:addCell(oColumn)
		oPCabec:print(oPrint,/*cPixel*/)

		oPrint:SayBitmap(0.65, nCMIniGrid + 0.05, cFile ,nImgLargura * 0.99 ,nImgAltura * 0.99,.f.)

		FErase(cFile)

		nCMIniGrid += nImgLargura
	next nImagem

	oPrint:setLine(oPrint:getLineCM() + nMaiorAltura + 0.9,.t.)
return
