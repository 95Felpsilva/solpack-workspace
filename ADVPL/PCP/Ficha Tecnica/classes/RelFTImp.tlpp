	local aTamanho 		:= {0, 0}
	local n1CMXPixel	:= 37.7957517575025
	local jMedidas		:= nil
	local cRootPath    	:= GetSRVProfString("ROOTPATH","")
	//local oTImg			:= nil

	default cImagem		:= "E:\totvs\protheus\homologacao\protheus12_data\relftimp20250220103804_70%.jpg"

	jMedidas := u_ImageSizeNode(cRootPath + cImagem)

	if jMedidas['success']
		aTamanho[1] := jMedidas['height'] / n1CMXPixel
		aTamanho[2] := jMedidas['width'] / n1CMXPixel
