				//++MSCBWrite("^FO740,40^GFA,1708,1708,7,,:::::01JF8,01IFE02,01IF83FF8,01IF0FEFE,01FFE3C0078,01FFCF0FE3E,01FF9C7FF8E,01FF98IFE7,01FF31JF38,01FE33JF98,01FC67JFCC,01FCEKFEC,01FCCKFE6,01F88KFE6,01F8DLF6,01F99LF6,01F99LF3,:::01F99LF7,01F89KFE6,01FCCKFE6,01FCCKFEE,01FC67JFCC,01FE67JF98,01FE73JF18,01FF39IFE38,01FF9C7FFC7,01FF8E3FF0A,01FFC78003C,01FFE1E00F,01IF0IFE,01IF83FF,01JF,01JFE,,::::::00F1FFC,01F3FFC,03F3FFE,01F3FFE,03F3FFE,::01F3F7E,03F3E7E,:03F3A7E,01F3E7E,03F3E7E,::01F3E7E,03F3E7E,03FFE7E,:01FFE7E,03FFE7E,::01FFE7C,00FFC78,,::002IA,01JFC,01JFE,:03JFE,::01JFE,03F007E,::01F007E,03F007E,::01F007E,03F007E,:03FAAFE,01JFE,03JFE,::01JFC,:00JF8,,::00JFE,01JFE,:03JFE,::01JFE,03JFE,03F,:01F,03F,::01F,03E,01,,1K5,3KFC,:3KFE,::::K07E,02I07E,038007E,03F007E,01F007E,03F007E,::01F007E,03F007E,03F91FE,03JFE,01JFE,03JFE,::01JFC,00JF8,,::00JF,01JFC,03JF8,03JFC,::::03E00FC,03E007C,:::::03C007C,02I07C,K07C,02IAFC,03JFC,:::::03JF8,,::00JF8,01JFC,:03JFE,::01JFE,03FAAFE,03F007E,:01F007E,03F007E,::01F007E,03F007E,::01FC1FE,03FC1FE,:03FC1FA,01FC1FE,01FC0FC,01F80FC,00380F,,::03LF8,01LF,03LF,03KFE,:01KFC,03KFC,01KF8,I03F,I03F8,I03FE,I03FF,I03FF8,I03FFC,I03FFE,I07IF8,03FFEFF8,01FFEFF8,03FFE3F8,03FFE1F8,03FFE0F8,01FFE078,03FFE038,03FF8018,,::L018,L028,,:::^FS")
				nQuebra 	:= NQUEBNOR
				nLinha 	+= 2

				//Informações da Empresa
				nLinha		-= 5
	
				nLinha		-= nQuebra
				MSCBSAY(nLinha,005,"CNPJ.: " + Transform(SM0->M0_CGC,PesqPict("SA1","A1_CGC")),"R","0","030",,,,,.t.)
				nLinha		-= nQuebra
				MSCBSAY(nLinha,005,"www.solpack.com.br","R","0","030",,,,,.t.)
			
				nQuebra 	:= NQUEBNOR
				nLinha		-= nQuebra + 02
			Else
				nLinha 		:= NLININI
				nQuebra 	:= NQUEBGRA
			EndIf

			cUnidMed 		:= Lower(AllTrim(Posicione("SB1",1,xFilial("SB1") + cProduto,"B1_UM")))
			cTipoMedida	:= IIF(cUnidMed == "KG","Peso.:  ","Medida.:  ")
			If !Empty(cProduto)
				cArtigo := Posicione("SB5",1,xFilial("SB5") + cProduto,"B5_DES")
			EndIf

			nLinha -= (nQuebra + 3) //* 2
			cDescProd := alltrim(cDescProd)
		
			aTexto := QJustTxt(cDescProd, 38)

			For tm:=1 to Len(aTexto)
				MSCBSAY(nLinha,005,aTexto[tm],"R","0", "70,35",,,,,.t.)
				nLinha -= (nQuebra + 3)
			Next

			If GetNewPar("ZZ_IMPQTDE",.F.)
				nLinha -= (nQuebra) //+ 4
				MSCBSAY(nLinha,005,"Quant:  " + AllTrim(Transform(nQuant,PesqPict("SH6","H6_QTDPROD"))) + Space(01) + cUnidMed,"R","0","85,45",,,,,.t.) //46
			EndIf
			
			If !Empty(cLote)
				MSCBSAY(42,nColCompl,"OF/LOTE :  " + cLote,"R","0","035",,,,,.t.)
			EndIf

			if !empty(cArtigo)
				nLinha -= nQuebra
				MSCBSAY(42,005,"Artigo .:  " + cArtigo,"R","0","035",,,,,.t.)
			endif
			
			nLinha -= (nQuebra)
			MSCBSAY(037,005,"Dt Fab .:  " + cDataFab,"R","0","035",,,,,.t.)
			MSCBSAY(037,070,cRecurso,"R","0","035",,,,,.t.)

			nLinha -= nQuebra
			//MSCBSAY(032,005,"Conferente.:  " + cConferente,"R","0","035",,,,,.t.)
			If !Empty(cOperador)
				nLinha -= nQuebra
				MSCBSAY(032,005,"Operador.:  " + RetField("SZZ",1,xFilial("SZZ")+cOperador,"ZZ_COD + '-' + ZZ_NOME"),"R","0","035",,,,,.t.)
			Endif
			
			If !Empty(cCodBar)
				MSCBWrite("^FO70,0")
				MSCBWrite("^BQN,2,6")
				MSCBWrite("^^FDLA," + cCodBar + "^FS")
				nLinha -= (nQuebra + 2)
				if !empty(cArtigo)
					MSCBSAY(016.5+nQuebra,025,cCodBar,"R","0","035",,,,,.t.) //37 -- 22
				else
					MSCBSAY(020,025,cCodBar,"R","0","035",,,,,.t.)
				endif

				//Normal
				//MSCBSAYBAR(008,025,cCodBar,"R","MB07",12,.f.,.f.,.f.,,2,2,.F.)
				MSCBWrite("^FO64,200^BY2,2,50^BCR, 96,N,N,N,N^FD" + cCodBar + "^FS")

			EndIf
			cInf := "^FO640,600^GFA,2740,2740,20,,::::gN0C,I0FgI01C,003FCgH03E,00E67gH0FE,01C638g01FE,010608g03FC,03060Cg0FFE,03060CT01F8001IF,020604S03FFC003IFC,020604R01IFE007JF,03060CR0KF01KF8,030608Q07KF03KFE,010618P01LF87LF,01863Q07LF87LFC,00C7EP01MF07LFE,I038P03MF03MF,U0NF01MF8,T03MFE007LFC,003FF8N07MFC003LFE,00IFCN0MFCI01MF,01CP01LFL07LF8,01Q03KF8L03FCJFC,03Q0KFCM01FC7IFE,02P01KFO07E1JF,02P03JFCO03E0JF,02P03JFP01C07IF8,03P07IFES03IFC,03P0JF8S01IFE,018N01JFU0IFE,00CN03IFEU07IF,03IFCK07IFCU03IF8,03IF8K07IF8U01IF8,Q0JFW0IFC,P01IFEW0IFC,P01IFCW07FFE,01IFCJ03IF8W03FFE,03IFEJ03IFX03IF,03IFEJ07FFEX01IF,03IFCJ07FFEY0IF8,01IF8J0IFCY0IF8,J0F8J0IF8Y07FFC,J07CI01IF8O0FEN07FFC,J03EI01IFO03FFN03FFC,J03EI03IFO07FF8M03FFE,J01CI03FFEO0IFCM03FFE,001F8J03FFEN01IFEM01FFE,007FEJ07FFCN01IFEM01IF,00IFJ07FFCN03JFM01IF,01IF8I07FF8N03JFN0IF,01IFCI0IF8N03JFN0IF,03E73CI0IF8N03JFN0IF8,03C71EI0IFO03JFN07FF8,03C71EI0IFO01JFN07FF8,03C71E001IFO01IFEN07FF8,03C71E001IFP0IFCN07FF8,03C73E001FFEP0IFCN03FFC,03C7FC001FFEP07FF8N03FFC,01E7FC001FFEP01FEO03FFC,01E7F8001FFEQ03P03FFC,00C7FI01FFEgH03FFC,I07CI01FFEgH03FFC,N01FFEgH03FFC,I0F8I01FFEgH03FFC,003FEI01FFEgH03FFC,00IFI01FFEgH03FFC,00IF8001FFEgH03FFC,01IFC001FFEgH03FFC,03F07C001FFEQ078O03FFC,03E03E001FFEP01FEO03FFC,03C03E001FFEP07FF8N03FFC,03C01E001FFEP0IFCN03FFC,03C01E001FFEP0IFEN07FFC,03C03E001FFEO01IFEN07FF8,03E03C001IFO01JFN07FF8,01E07C001IFO03JFN07FF8,01E07CI0IFO03JFN0IF8,00E038I0IFO03JFN0IF8,O0IF8N03JFN0IF,O0IF8N03JFM01IF,01IFC7007FF8N01IFEM01IF,03IFCF007FFCN01IFEM01IF,03IFEF807FFCO0IFCM03FFE,03IFCF003FFEO07FF8M03FFE,01IF87003FFEO03FFN07FFC,O03IFP0FCN07FFC,O01IFg0IFC,001FCJ01IF8Y0IF8,007FFK0IF8X01IF8,00IF8J0IFCX03IF,01IF8J07FFEX03IF,01IFCJ07FFEX07FFE,03E07CJ03IFX0IFE,03C03EJ03IF8W0IFC,03C01EJ01IFCV01IFC,03C01EJ01IFCV03IF8,03C01EK0IFEV07IF,03C03EK07IFV0JF,03E03CK07IFCT01IFE,01E07CK03IFET03IFC,01E038K01JFT0JFC,00C03M0JF800CO01JF8,R0JFE00FO03JF,R07JF00F8N0JFE,01KFK03JFC0FCM03JFC,03KFK01KF0FEM0KF8,03KFL0KFCFF8K03KF,01KFL07MFCJ01KFE,S03MFEI01LFC,T0NFI0MF8,