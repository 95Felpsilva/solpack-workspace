USER FUNCTION SE2CODBAR()

local nret

If  INT(VAL(SUBSTR(SE2->E2_CODBAR,10,10))) == 0

	 nRet:= STRZERO(INT(((SE2->E2_SALDO + SE2->E2_ACRESC + SE2->E2_JUROS + SE2->E2_MULTA)-SE2->E2_DESCONT)*100),10)
	else
	 nRet := SUBSTR(SE2->E2_CODBAR,10,10)                                                                       
Endif	 

return nret