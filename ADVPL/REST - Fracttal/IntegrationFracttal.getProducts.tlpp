#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

namespace IntegrationFracttal

/*/{Protheus.doc} getProducts

Retorna lista de cadastro de produtos

@type function
@author Gabriel Pereira Santos - CRM Services
@since 24/01/2024
@version P12
@database MSSQL

@param [oClassRestFul], object, Objeto da Classe RESTFUL recebido do fonte com a definição das API's
@param [oRest], object, Objeto da Classe Rest do TLPP recebido do fonte com a definição das API's

@return logical, lRet - Indica se foi processado com sucesso
/*/ 
User Function getProducts(oClassRestFul as object, oRest as object) as character	
	Local cJsonResponse			:= "" as character
	Local cQueryHeader			:= "" as character
	Local nStatusCode			:= 0 as numeric
    Local lUseTmpTable			:= .F. as logical
    Local lRetExecuteAPIREST	:= .T. as logical

	Private oFwAdapterBaseV2	:= NIL as object
	Private cWhere		 		:= "" as character 
	Private cFilter		 		:= "" as character 
	Private nPage				:= 1 as numeric 
	Private nPageSize		 	:= 50 as numeric 
	Private aQueryString 	 	:= {} as array 

	oFwAdapterBaseV2 	:= FwAdapterBaseV2():New("GET")

	getParamResquest()
    oFwAdapterBaseV2:setPage(nPage)
    oFwAdapterBaseV2:setPageSize(nPageSize)

	createMapaCampos()
	cQueryHeader := getQryProducts()

	oFwAdapterBaseV2:SetQuery(cQueryHeader)
	oFwAdapterBaseV2:SetWhere(cWhere)
	oFwAdapterBaseV2:SetOrder("")
	If ( Len(aQueryString) > 0 )
		oFwAdapterBaseV2:SetUrlFilter(aQueryString)
	EndIf

	lRetExecuteAPIREST := oFwAdapterBaseV2:Execute(lUseTmpTable)

	If ( lRetExecuteAPIREST )
		oFwAdapterBaseV2:FillGetResponse()
		cJsonResponse 		:= oFwAdapterBaseV2:GetJSONResponse()
		nStatusCode 		:= oFwAdapterBaseV2:GetCode()
	Else
		cJsonResponse 		:= AllTrim(oFwAdapterBaseV2:cMessage)
		nStatusCode 		:= oFwAdapterBaseV2:GetCode()
	EndIf

	freeObj(oFwAdapterBaseV2)

	oRest:setKeyHeaderResponse("Content-Type", "Application/Json;charset=utf-8")
	oRest:setResponse(EncodeUTF8(cJsonResponse))					
	oRest:setStatusCode(nStatusCode)

Return cJsonResponse

/*
	Cria mapa de campos a ser retornado na API
*/
Static Function createMapaCampos() as variant
	oFwAdapterBaseV2:AddMapFields("code"                    , "B1_COD", .T., .T., { "B1_COD", "C", tgv.util.GetFieldLength("B1_COD"), 0 } )
    oFwAdapterBaseV2:AddMapFields("descption"	            , "B1_DESC", .T., .F., { "B1_DESC", "C", tgv.util.GetFieldLength("B1_DESC"), 0 } )
    // oFwAdapterBaseV2:AddMapFields("id_type_item"           , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    oFwAdapterBaseV2:AddMapFields("barcode"                , "B1_CODBAR", .T., .F., { "B1_CODBAR", "C", tgv.util.GetFieldLength("B1_CODBAR"), 0 } )
    // oFwAdapterBaseV2:AddMapFields("notes"                  , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    oFwAdapterBaseV2:AddMapFields("weight"                  , "B1_PESO", .T., .F., { "B1_PESO", "N", tgv.util.GetFieldLength("B1_PESO"), 0 } )
    // oFwAdapterBaseV2:AddMapFields("is_serial_control"      , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("group"                  , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("group_1"                , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("group_2"                , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("priorities"             , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("code_parent_location"   , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("latitude"               , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("longitud"               , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    oFwAdapterBaseV2:AddMapFields("unit_code"               , "B1_UM", .T., .F., { "B1_UM", "C", tgv.util.GetFieldLength("B1_UM"), 0 } )
    oFwAdapterBaseV2:AddMapFields("unit_description"        , "AH_UMRES", .T., .F., { "AH_UMRES", "C", tgv.util.GetFieldLength("AH_UMRES"), 0 } )
    // oFwAdapterBaseV2:AddMapFields("visible_to_all"         , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("purchase_date"          , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("total_cost"             , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    // oFwAdapterBaseV2:AddMapFields("startup_date"           , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )
    oFwAdapterBaseV2:AddMapFields("costs_center"           , "CTT_DESC01", .T., .F., { "CTT_DESC01", "C", tgv.util.GetFieldLength("CTT_DESC01"), 0 } )
    oFwAdapterBaseV2:AddMapFields("cod_costs_center"       , "B1_CC", .T., .F., { "B1_CC", "C", tgv.util.GetFieldLength("B1_CC"), 0 } )
    oFwAdapterBaseV2:AddMapFields("active_fracttal"        , "B1_ZZFRACT", .T., .F., { "B1_ZZFRACT", "C", 3, 0 } )
    // oFwAdapterBaseV2:AddMapFields("budgets"                , "", .T., .F., { "", "C", tgv.util.GetFieldLength(""), 0 } )

Return

/*
	Cria query de executação da API
*/
Static Function getQryProducts() as character
	Local cQuery	:= "" as character

    DBSelectArea("SB1")

	cQuery := " SELECT " + CRLF
	cQuery += "     B1_COD " + CRLF
	cQuery += "     ,B1_DESC " + CRLF
	cQuery += "     ,B1_CODBAR " + CRLF
	cQuery += "     ,B1_PESO " + CRLF
	cQuery += "     ,B1_UM " + CRLF
	cQuery += "     ,AH_UMRES " + CRLF
	cQuery += "     ,CTT_DESC01 " + CRLF
	cQuery += "     ,B1_CC " + CRLF
	If SB1->(FieldPos("B1_ZZFRACT")) > 0
		cQuery += "     ,CASE WHEN B1_ZZFRACT = '1' THEN 'Sim' ELSE 'Não' END B1_ZZFRACT " + CRLF
    EndIf
	cQuery += " FROM " + CRLF 
    cQuery +=       RetSqlTab("SB1") + CRLF
	cQuery += "     LEFT JOIN " + RetSqlTab("SAH") + " ON 1 = 1 " + CRLF
	cQuery += "         AND " + RetSqlFil("SAH") + CRLF
	cQuery += "         AND AH_UNIMED = B1_UM" + CRLF
	cQuery += "         AND " + RetSqlDel("SAH") + CRLF
	cQuery += "     LEFT JOIN " + RetSqlTab("CTT") + " ON 1 = 1 " + CRLF
	cQuery += "         AND " + RetSqlFil("CTT") + CRLF
	cQuery += "         AND CTT_CUSTO = B1_CC" + CRLF
	cQuery += "         AND " + RetSqlDel("CTT") + CRLF
	cQuery += " WHERE " + CRLF
	cQuery += "     1 = 1" + CRLF
    If SB1->(FieldPos("B1_ZZFRACT")) > 0
	    cQuery += "     AND B1_ZZFRACT = '1'" + CRLF
    EndIf
    cQuery += "     AND " + RetSqlDel("SB1") + CRLF
    
    cQuery := "SELECT #QueryFields# FROM (" + cQuery + ") SUBQRYREST WHERE 1 = 1 AND #QueryWhere#"

Return cQuery

/*
	Rotina para recuperar parâmetros enviados
*/
Static Function getParamResquest()
	Local aParams	:= {} as array
	Local cParam	:= "" as character
	Local cContent	:= "" as character
	Local nParam	:= 1 as numeric

	nPage := oRest:getQueryRequest()["Page"]

	If ( Empty(nPage) )
		nPage := 1
	Endif
	If ( ValType(nPage) == "C" )
		nPage := Val(nPage)
	Endif

	nPageSize := oRest:getQueryRequest()["PageSize"]
	
	If ( Empty(nPageSize) )
		nPageSize := 50
	Endif
	If ( ValType(nPageSize) == "C" )
		nPageSize := Val(nPageSize)
	Endif
	
	cWhere := oRest:getQueryRequest()["Where"]
	If ( Empty(cWhere) )
		cWhere := "1 = 1"
	Endif
	
	aParams := oRest:getQueryRequest():GetNames()

	If ( Len(aParams) > 0 )
		For nParam:=1 To Len(aParams)
			cParam 	:= aParams[nParam]
			cContent:= oRest:getQueryRequest()[cParam]

			If ( !Empty(cParam) .And. !( Upper(AllTrim(cParam)) $ "PAGESIZE,PAGE,WHERE" ) )
				aAdd(aQueryString, {cParam, cContent})
			EndIf
		Next nParam
	EndIf 
Return
