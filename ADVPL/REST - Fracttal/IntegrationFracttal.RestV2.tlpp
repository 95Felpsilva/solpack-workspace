#include "totvs.ch"
#include "tlpp-core.th"
#include "tlpp-rest.th"

#define HTTP_BAD_REQUEST	400

namespace IntegrationFracttal

/*/{protheus.doc} apiGetProducts

Método GET para consulta do cadastro de produtos
Usando REST Versão 2.0 com Annotation

@type method
@author Gabriel Pereira - CRM Services
@since 24/01/2024
@version P12
@database MSSQL

@return logical, lRet - Indica se o processo retornou com sucesso
/*/
@GET(endpoint="/IntegrationFracttal/products",description="Realiza consulta do cadastro de Produtos")
User Function apiGetProducts() as logical
    Local cMsg  	:= "" as character
    Local lRet  	:= .T. as logical
	
	If ( FindFunction("IntegrationFracttal.u_getProducts") )
		lRet := IntegrationFracttal.u_getProducts(,@oRest)
	Else
		cMsg := "Função TLPP 'IntegrationFracttal.u_getProducts' não encontrada no RPO."
		IntegrationFracttal.u_sendMsgFault(oRest,cMsg, HTTP_BAD_REQUEST)
	Endif

Return .T.

